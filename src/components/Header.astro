---
// Header.astro, Ériu Sourcing
// Mobile-first sticky nav. Logo is inline SVG lockup (light-bg variant).
// Desktop nav supports two item types: flat links, and dropdown groups
// (an item with a `children` array).

const sourcingNavLinks = [
  { href: '/how-it-works/', label: 'How It Works' },
  { href: '/source/',        label: 'What We Source' },
  { href: '/modular-homes/', label: 'Modular Homes' },
  {
    label: 'Resources',
    children: [
      { href: '/resources/', label: 'Resources Hub' },
      { href: '/blog/',      label: 'Blog' },
      { href: '/faq/',       label: 'FAQ' },
    ],
  },
  {
    label: 'Why Ériu',
    children: [
      { href: '/why-direct/',    label: 'Why Direct?' },
      { href: '/zhengzhou/',     label: 'Why Zhengzhou' },
      { href: '/china-network/', label: 'China Network' },
      { href: '/case-studies/',  label: 'Case Studies' },
      { href: '/about/',         label: 'About' },
    ],
  },
];

const modularNavLinks = [
  { href: '/modular-homes/', label: 'Overview', exact: true },
  {
    label: 'The Homes',
    children: [
      { href: '/modular-homes/models/',                  label: 'Models, Overview' },
      { href: '/modular-homes/models/20ft-expandable/',  label: '20ft Expandable' },
      { href: '/modular-homes/models/30ft-expandable/',  label: '30ft Expandable' },
      { href: '/modular-homes/models/40ft-expandable/',  label: '40ft Expandable' },
      { href: '/modular-homes/models/20ft700-foldable/', label: '20FT700 Foldable' },
      { href: '/modular-homes/models/floor-plans/',      label: 'Floor Plans' },
      { href: '/modular-homes/cost/',                    label: 'Cost & Pricing' },
      { href: '/modular-homes/factory-visits/',          label: 'Factory Visits' },
    ],
  },
  {
    label: 'Planning & Rules',
    children: [
      { href: '/modular-homes/back-garden-homes-ireland/',    label: 'Back-Garden Homes' },
      { href: '/modular-homes/building-regulations-ireland/', label: 'Building Regulations' },
      { href: '/modular-homes/auxiliary-dwelling-ireland/',   label: 'Auxiliary Dwelling' },
    ],
  },
  { href: '/', label: '← Ériu Sourcing' },
];

const pathname = Astro.url.pathname;
const isModular = pathname.startsWith('/modular-homes');
const navLinks = isModular ? modularNavLinks : sourcingNavLinks;

const isActive = (href, exact = false) => {
  if (!href) return false;
  if (href === '/') return pathname === '/';
  const base = href.replace(/\/$/, '');
  if (exact) return pathname === base + '/' || pathname === base;
  return pathname === base + '/' || pathname.startsWith(base + '/');
};
const isGroupActive = (link) => !!link.children?.some(c => isActive(c.href));
---

<header class="site-header">
  <div class="header-inner container">

    <!-- Logo, icon mark + wordmark (sub-brand swap on /modular-homes/) -->
    {isModular ? (
      <a href="/modular-homes/" class="logo logo--modular" aria-label="Ériu Modular Homes, Home">
        <img src="/images/eriu-modular-mark.svg" width="36" height="36" alt="" aria-hidden="true" class="logo-mark" onerror="this.style.display='none'" />
        <span class="logo-wordmark">
          <span class="logo-eriu">Ériu</span><span class="logo-sub">Modular Homes</span>
        </span>
      </a>
    ) : (
      <a href="/" class="logo" aria-label="Ériu Sourcing, Home">
        <img src="/images/eriu-mark.svg" width="36" height="36" alt="" aria-hidden="true" class="logo-mark" />
        <span class="logo-wordmark">
          <span class="logo-eriu">ÉRIU</span><span class="logo-sourcing">Sourcing</span>
        </span>
      </a>
    )}

    <!-- Desktop nav -->
    <nav class="nav-desktop" aria-label="Main navigation">
      <ul role="list">
        {navLinks.map(link => (
          link.children ? (
            <li class="nav-item nav-item--has-dropdown">
              <button
                type="button"
                class={`nav-dropdown-toggle${isGroupActive(link) ? ' active' : ''}`}
                aria-expanded="false"
                aria-haspopup="true"
              >
                {link.label}
                <svg class="nav-chevron" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <ul class="nav-dropdown" role="list">
                {link.children.map(child => (
                  <li>
                    <a href={child.href} class={isActive(child.href) ? 'active' : ''}>
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li class="nav-item">
              <a href={link.href} class={isActive(link.href, link.exact) ? 'active' : ''}>
                {link.label}
              </a>
            </li>
          )
        ))}
      </ul>
    </nav>

    <!-- CTA -->
    <a href="/contact/" class="btn btn--primary nav-cta">Get a Quote</a>

    <!-- Hamburger -->
    <button
      class="hamburger"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Open menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

  </div>

  <!-- Mobile nav drawer -->
  <nav
    class="nav-mobile"
    id="mobile-nav"
    aria-label="Mobile navigation"
    aria-hidden="true"
  >
    <ul role="list">
      {navLinks.map(link => (
        link.children ? (
          <li class="mobile-group">
            <span class="mobile-group-label">{link.label}</span>
            <ul role="list" class="mobile-subnav">
              {link.children.map(child => (
                <li>
                  <a href={child.href} class={isActive(child.href) ? 'active' : ''}>
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ) : (
          <li>
            <a href={link.href} class={isActive(link.href, link.exact) ? 'active' : ''}>
              {link.label}
            </a>
          </li>
        )
      ))}
      <li class="mobile-cta-item">
        <a href="/contact/" class="btn btn--primary mobile-cta-btn">Get a Quote</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const mobileNav = document.getElementById('mobile-nav');

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
    mobileNav?.setAttribute('aria-hidden', String(isOpen));
    mobileNav?.classList.toggle('is-open');
    toggle.classList.toggle('is-open');
    document.body.style.overflow = isOpen ? '' : 'hidden';
  });

  mobileNav?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Open menu');
      mobileNav.setAttribute('aria-hidden', 'true');
      mobileNav.classList.remove('is-open');
      toggle?.classList.remove('is-open');
      document.body.style.overflow = '';
    });
  });

  // Desktop dropdowns, hover and keyboard focus are handled in CSS.
  // This adds click-to-toggle (touch / explicit click) plus outside-click
  // and Escape to close, keeping aria-expanded in sync.
  const dropdownToggles = document.querySelectorAll<HTMLButtonElement>('.nav-dropdown-toggle');
  const closeAllDropdowns = () => {
    dropdownToggles.forEach(b => b.setAttribute('aria-expanded', 'false'));
  };
  dropdownToggles.forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = btn.getAttribute('aria-expanded') === 'true';
      closeAllDropdowns();
      btn.setAttribute('aria-expanded', String(!open));
    });
  });
  document.addEventListener('click', closeAllDropdowns);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAllDropdowns();
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: #F7F6F2;
    border-bottom: 1px solid rgba(15, 33, 49, 0.09);
    overflow: visible;
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    height: 72px;
  }

  /* Logo */
  .logo {
    text-decoration: none;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    line-height: 1;
    white-space: nowrap;
    overflow: visible;
  }

  .logo-mark {
    display: block;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
  }

  .logo-wordmark {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
    line-height: 1;
  }

  .logo-eriu {
    font-family: 'Boska', Georgia, 'Times New Roman', serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: #1A533E;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .logo-sourcing {
    font-family: 'Satoshi', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 1.125rem;
    font-weight: 400;
    color: #0F2131;
    letter-spacing: 0.02em;
    line-height: 1;
  }

  /* Sub-brand: Modular Homes */
  .logo--modular .logo-eriu {
    font-family: 'Boska', Georgia, 'Times New Roman', serif;
    font-size: 1.6rem;
    font-weight: 700;
    color: #1A533E;
    letter-spacing: -0.01em;
  }

  .logo--modular .logo-sub {
    font-family: 'Satoshi', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    color: #1C7C83;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    line-height: 1;
  }

  .logo--modular .logo-wordmark {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.125rem;
  }

  /* Desktop nav */
  .nav-desktop {
    flex: 1;
    min-width: 0;
  }

  .nav-desktop ul {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0;
  }

  .nav-item {
    position: relative;
  }

  .nav-desktop a,
  .nav-dropdown-toggle {
    font-family: 'Satoshi', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    color: #3a3a3a;
    text-decoration: none;
    padding: 0.5rem 0.625rem;
    border-radius: 6px;
    min-height: 44px;
    display: flex;
    align-items: center;
    transition: color 0.12s ease, background-color 0.12s ease;
    white-space: nowrap;
  }

  .nav-dropdown-toggle {
    background: none;
    border: none;
    cursor: pointer;
    gap: 0.3rem;
  }

  .nav-desktop a:hover,
  .nav-dropdown-toggle:hover,
  .nav-item--has-dropdown:focus-within .nav-dropdown-toggle {
    color: #1A533E;
    background-color: rgba(26, 83, 62, 0.07);
  }

  .nav-desktop a.active,
  .nav-dropdown-toggle.active {
    color: #1A533E;
    font-weight: 600;
  }

  .nav-chevron {
    width: 11px;
    height: 11px;
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }

  .nav-item--has-dropdown:hover .nav-chevron,
  .nav-item--has-dropdown:focus-within .nav-chevron,
  .nav-dropdown-toggle[aria-expanded="true"] .nav-chevron {
    transform: rotate(180deg);
  }

  /* Dropdown panel */
  .nav-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 220px;
    list-style: none;
    margin: 0;
    padding: 0.375rem;
    background-color: #fff;
    border: 1px solid rgba(15, 33, 49, 0.1);
    border-radius: 10px;
    box-shadow: 0 14px 36px rgba(15, 33, 49, 0.14);
    display: flex;
    flex-direction: column;
    gap: 2px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
    transition: opacity 0.14s ease, transform 0.14s ease, visibility 0.14s;
    z-index: 200;
  }

  .nav-item--has-dropdown:hover .nav-dropdown,
  .nav-item--has-dropdown:focus-within .nav-dropdown,
  .nav-dropdown-toggle[aria-expanded="true"] ~ .nav-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .nav-dropdown a {
    min-height: 0;
    padding: 0.625rem 0.75rem;
    width: 100%;
  }

  /* Header CTA */
  .nav-cta {
    flex-shrink: 0;
    font-size: 0.875rem;
    padding: 0.5rem 1rem;
    min-height: 44px;
  }

  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    margin-left: auto;
    flex-shrink: 0;
  }

  .hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background-color: #0F2131;
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
    transform-origin: center;
  }

  .hamburger.is-open span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
  .hamburger.is-open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
  .hamburger.is-open span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }

  /* Mobile drawer */
  .nav-mobile {
    display: none;
    background-color: #F7F6F2;
    border-top: 1px solid rgba(15, 33, 49, 0.08);
    padding: 1.25rem 1.5rem 2rem;
    max-height: calc(100vh - 72px);
    max-height: calc(100dvh - 72px);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
  }

  .nav-mobile.is-open {
    display: block;
  }

  .nav-mobile ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-mobile a {
    display: flex;
    align-items: center;
    min-height: 52px;
    font-size: 1.125rem;
    font-weight: 500;
    color: #0F2131;
    text-decoration: none;
    padding: 0.25rem 0;
    border-bottom: 1px solid rgba(15, 33, 49, 0.07);
    transition: color 0.12s ease;
  }

  .nav-mobile a:hover,
  .nav-mobile a.active {
    color: #1A533E;
  }

  /* Mobile grouped section */
  .mobile-group-label {
    display: block;
    font-family: 'Satoshi', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: #1C7C83;
    padding: 1rem 0 0.25rem;
  }

  .mobile-subnav {
    border-left: 2px solid rgba(26, 83, 62, 0.15);
    padding-left: 0.875rem !important;
  }

  .mobile-subnav a {
    font-size: 1.0625rem;
    min-height: 48px;
  }

  .mobile-cta-item {
    margin-top: 1.5rem;
  }

  .mobile-cta-btn {
    border: none !important;
    width: 100%;
    justify-content: center;
  }

  /* Responsive */
  @media (max-width: 1100px) {
    .nav-desktop,
    .nav-cta {
      display: none;
    }

    .hamburger {
      display: flex;
    }
  }
</style>
