---
// WhatsApp click-to-chat button with a pre-filled message.
import { wa, WA_DEFAULT } from '../../data/parts.js';
interface Props { text?: string; label?: string; variant?: 'solid' | 'ghost'; }
const { text = WA_DEFAULT, label = 'WhatsApp us your parts list', variant = 'solid' } = Astro.props;
---
<a href={wa(text)} class={`wab wab--${variant}`} target="_blank" rel="noopener noreferrer">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm5.8 14.1c-.24.68-1.42 1.3-1.95 1.34-.5.05-.97.23-3.27-.68-2.77-1.09-4.52-3.92-4.66-4.1-.13-.18-1.11-1.48-1.11-2.82 0-1.34.7-2 .95-2.27.25-.27.54-.34.72-.34h.52c.17 0 .39-.06.6.46.23.54.77 1.87.84 2 .07.14.11.3.02.48-.09.18-.13.3-.27.46-.13.16-.28.36-.4.48-.13.13-.27.28-.12.55.16.27.7 1.15 1.5 1.86 1.03.92 1.9 1.2 2.17 1.34.27.13.43.11.59-.07.16-.18.68-.79.86-1.06.18-.27.36-.23.6-.14.25.09 1.57.74 1.84.88.27.13.45.2.52.31.07.11.07.66-.17 1.32z"/></svg>
  <span>{label}</span>
</a>
<style>
  .wab { display: inline-flex; align-items: center; gap: .6rem; font-weight: 700; font-size: 1rem; padding: .95rem 1.4rem; border-radius: 999px; text-decoration: none; transition: transform .15s ease, box-shadow .15s ease, background-color .15s ease; min-height: 48px; }
  .wab--solid { background: #25D366; color: #06351d; box-shadow: 0 10px 30px rgba(37,211,102,.28); }
  .wab--solid:hover { transform: translateY(-2px); box-shadow: 0 14px 36px rgba(37,211,102,.38); }
  .wab--ghost { color: #25D366; border: 2px solid #25D366; background: transparent; }
  .wab--ghost:hover { background: rgba(37,211,102,.1); }
  .wab:focus-visible { outline: 3px solid #7ff0dc; outline-offset: 3px; }
</style>
