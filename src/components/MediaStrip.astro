---
// A 2–3 image strip used to show real interiors/builds on the modular pages.
// Uses astro:assets <Image> (resize + srcset) when an optimized copy exists,
// else a raw <img> fallback.
import { Image } from 'astro:assets';
import { resolveImage, responsiveWidths } from '../lib/optimizedImages';

interface Item { src: string; alt: string; }
interface Props {
  items: Item[];
  caption?: string;
}
const { items, caption } = Astro.props;

const sizes = '(max-width: 700px) 50vw, 240px';
const resolved = items.map(it => {
  const meta = resolveImage(it.src);
  return { ...it, meta, widths: meta ? responsiveWidths(meta, [240, 480, 720]) : [] };
});
---
<figure class="media-strip">
  <div class="media-strip-grid" data-count={items.length}>
    {resolved.map(it => (
      it.meta ? (
        <Image src={it.meta} alt={it.alt} widths={it.widths} sizes={sizes} loading="lazy" decoding="async" />
      ) : (
        <img src={it.src} alt={it.alt} loading="lazy" decoding="async" />
      )
    ))}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .media-strip { margin: 1.75rem 0; }
  .media-strip-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(3, 1fr);
  }
  .media-strip-grid[data-count="2"] { grid-template-columns: repeat(2, 1fr); }
  .media-strip-grid img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 12px;
    display: block;
    background: #e9e7e0;
  }
  .media-strip figcaption {
    font-size: 0.8125rem;
    color: #8a8a8a;
    text-align: center;
    padding: 0.75rem 1rem 0;
    font-style: italic;
    line-height: 1.5;
  }
  @media (max-width: 700px) {
    .media-strip-grid,
    .media-strip-grid[data-count="2"] { grid-template-columns: 1fr 1fr; }
  }
</style>
