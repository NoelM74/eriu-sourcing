---
// ZhengzhouNav.astro, cross-links the Zhengzhou pillar + sub-pages so each
// deep page is reachable from its siblings, not just the pillar.
// Pass `current` (the page's slug) to omit the current page from the list.
interface Props { current?: string; }
const { current = '' } = Astro.props;

const links = [
  { slug: '', href: '/zhengzhou/', label: 'Why Zhengzhou, the overview' },
  { slug: 'manufacturing-base', href: '/zhengzhou/manufacturing-base/', label: 'The manufacturing base' },
  { slug: 'logistics-connectivity', href: '/zhengzhou/logistics-connectivity/', label: 'Logistics & connectivity' },
  { slug: 'cost-vs-coastal-china', href: '/zhengzhou/cost-vs-coastal-china/', label: 'Cost vs coastal China' },
  { slug: 'invest-set-up', href: '/zhengzhou/invest-set-up/', label: 'Investing & setting up' },
].filter(l => l.slug !== current);
---
<section class="section section--alt">
  <div class="container--narrow">
    <span class="section-eyebrow">More on Zhengzhou</span>
    <h2>Explore the Zhengzhou cluster</h2>
    <ul class="zz-nav">
      {links.map(l => (
        <li><a href={l.href}>{l.label} <span aria-hidden="true">→</span></a></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .zz-nav {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }
  .zz-nav a {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.875rem 1.125rem;
    background: #fff;
    border: 1px solid rgba(15, 33, 49, 0.1);
    border-radius: 10px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-emerald, #1A533E);
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .zz-nav a:hover { border-color: var(--color-emerald, #1A533E); transform: translateY(-2px); }
  @media (max-width: 600px) { .zz-nav { grid-template-columns: 1fr; } }
</style>
