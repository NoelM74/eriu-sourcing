---
// Single full-width media figure used across the modular funnel pages.
// Uses astro:assets <Image> (build-time resize + srcset) when an optimized
// copy exists under src/assets/images; falls back to a raw <img> otherwise.
import { Image } from 'astro:assets';
import { resolveImage, responsiveWidths } from '../lib/optimizedImages';

interface Props {
  src: string;
  alt: string;
  caption?: string;
  eager?: boolean;
  ratio?: string;        // CSS aspect-ratio, e.g. "16 / 9" (default) or "3 / 2"
  rounded?: boolean;
}
const { src, alt, caption, eager = false, ratio = '16 / 9', rounded = true } = Astro.props;

const optimized = resolveImage(src);
const sizes = '(max-width: 800px) 100vw, 760px';
const widths = optimized ? responsiveWidths(optimized, [400,760, 1140, 1520]) : [];
---
<figure class:list={['media-figure', { 'is-rounded': rounded }]}>
  {optimized ? (
    <Image
      src={optimized}
      alt={alt}
      widths={widths}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      style={`aspect-ratio:${ratio}`}
    />
  ) : (
    <img
      src={src}
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      style={`aspect-ratio:${ratio}`}
    />
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .media-figure { margin: 1.75rem 0; }
  .media-figure img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    background: #e9e7e0;
  }
  .media-figure.is-rounded img { border-radius: 16px; }
  .media-figure figcaption {
    font-size: 0.8125rem;
    color: #8a8a8a;
    text-align: center;
    padding: 0.75rem 1rem 0;
    font-style: italic;
    line-height: 1.5;
  }
</style>
