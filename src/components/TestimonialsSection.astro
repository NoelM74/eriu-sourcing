---
/**
 * TestimonialsSection.astro — client testimonials, best-in-class.
 *
 * Usage:
 *   import TestimonialsSection from '../components/TestimonialsSection.astro';
 *   import { getByTags } from '../data/testimonials.js';
 *   const quotes = getByTags(['building-materials']);
 *   <TestimonialsSection items={quotes} eyebrow="Client experience" heading="…" />
 *
 * Layouts (auto-selected, or pass `layout`):
 *   'featured' — editorial split: photo collage + large pull-quote, alternating.
 *                Auto-used when there is exactly one testimonial.
 *   'grid'     — hero-image cards in a smart, orphan-free column count.
 *   'compact'  — small quote cards with a thumbnail; good above forms.
 *
 * Photos: each item.photos is [{ src, alt }]. photos[0] is treated as the
 * lead/hero image. The component renders nothing if items is empty.
 */

interface TestimonialPhoto { src: string; alt: string; }
interface TestimonialItem {
  id: string; name: string; role: string; company: string;
  location: string; quote: string; photos: TestimonialPhoto[]; tags: string[];
}
interface Props {
  items: TestimonialItem[];
  layout?: 'featured' | 'grid' | 'compact';
  eyebrow?: string;
  heading?: string;
  intro?: string;
  bg?: 'white' | 'alt';
}

const {
  items,
  layout: requestedLayout,
  eyebrow = 'Client testimonials',
  heading = 'What our clients say',
  intro,
  bg = 'alt',
} = Astro.props;

if (!items || items.length === 0) return;

// Auto-pick a layout when none is forced: a lone testimonial gets the rich
// editorial split; anything else gets the hero-card grid.
let layout = requestedLayout ?? (items.length === 1 ? 'featured' : 'grid');
if (layout === 'grid' && items.length === 1) layout = 'featured';

// Smart, orphan-free column count for grid/compact.
function columnsFor(n: number): number {
  if (n <= 2) return n;        // 1→(featured), 2→2
  if (n === 4) return 2;       // 2×2 instead of 3+1 orphan
  return 3;                    // 3, 5(3+2), 6(3×3)
}
const cols = columnsFor(items.length);

function initials(t: TestimonialItem): string {
  const src = t.name || t.company || t.role;
  const p = src.trim().split(/\s+/);
  return (p.length >= 2 ? p[0][0] + p[p.length - 1][0] : src.slice(0, 2)).toUpperCase();
}
function nameLine(t: TestimonialItem): string { return t.name || t.role || t.company; }
function subLine(t: TestimonialItem): string {
  return [t.company, t.location].filter(Boolean).join(' · ');
}

const pinSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>';
const checkSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
const camSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>';
const zoomSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>';

// Serialise a testimonial's photos for the lightbox trigger (full image paths).
function gallery(photos: TestimonialPhoto[]): string {
  return JSON.stringify(photos.map(p => ({ src: `/images/${p.src}`, alt: p.alt })));
}
---

<section class={`t-section section ${bg === 'alt' ? 'section--alt' : ''}`}>
  <div class="container">

    <div class="t-head">
      {eyebrow && <span class="section-eyebrow">{eyebrow}</span>}
      {heading && <h2>{heading}</h2>}
      {intro && <p class="t-intro">{intro}</p>}
    </div>

    {/* ─────────────── FEATURED — editorial split, alternating ─────────────── */}
    {layout === 'featured' && (
      <div class="t-featured-list">
        {items.map((t, i) => {
          const photos = (t.photos ?? []).slice(0, 3);
          return (
            <figure class={`t-feat ${i % 2 === 1 ? 't-feat--rev' : ''} ${photos.length === 0 ? 't-feat--noimg' : ''}`}>
              {photos.length > 0 && (
                <div class={`t-collage t-collage--${photos.length}`} data-gallery={gallery(photos)}>
                  {photos.map((p, idx) => (
                    <button type="button" class={`t-collage-cell t-collage-cell--${idx} t-media-trigger`} data-index={idx} aria-label={`View project photo ${idx + 1} of ${photos.length}`}>
                      <img src={`/images/${p.src}`} alt={p.alt} loading="lazy" decoding="async" width="800" height="600" />
                      <span class="t-zoom" set:html={zoomSvg} aria-hidden="true" />
                    </button>
                  ))}
                </div>
              )}
              <blockquote class="t-feat-body">
                <span class="t-mark" aria-hidden="true">“</span>
                <p class="t-feat-quote">{t.quote}</p>
                <figcaption class="t-attrib">
                  <span class="t-initials" aria-hidden="true">{initials(t)}</span>
                  <span class="t-attrib-text">
                    <span class="t-name">{nameLine(t)}</span>
                    <span class="t-sub"><span class="t-pin" set:html={pinSvg} />{subLine(t)}</span>
                  </span>
                  <span class="t-verified"><span class="t-check" set:html={checkSvg} />Verified client</span>
                </figcaption>
              </blockquote>
            </figure>
          );
        })}
      </div>
    )}

    {/* ─────────────── GRID — hero-image cards ─────────────── */}
    {layout === 'grid' && (
      <div class="t-grid" style={`--cols:${cols}`}>
        {items.map(t => {
          const photos = (t.photos ?? []).slice(0, 3);
          const hero = photos[0];
          return (
            <figure class={`t-card ${hero ? '' : 't-card--noimg'}`}>
              {hero ? (
                <button type="button" class="t-card-media t-media-trigger" data-gallery={gallery(photos)} data-index="0" aria-label={`View ${photos.length > 1 ? photos.length + ' project photos' : 'project photo'}`}>
                  <img src={`/images/${hero.src}`} alt={hero.alt} loading="lazy" decoding="async" width="640" height="430" />
                  <span class="t-zoom" set:html={zoomSvg} aria-hidden="true" />
                  {photos.length > 1 && (
                    <span class="t-photo-count"><span class="t-cam" set:html={camSvg} />{photos.length}</span>
                  )}
                </button>
              ) : (
                <div class="t-card-media t-card-media--brand" aria-hidden="true"><span class="t-mark t-mark--watermark">“</span></div>
              )}
              <blockquote class="t-card-body">
                <p class="t-card-quote">{t.quote}</p>
                <figcaption class="t-attrib">
                  <span class="t-initials" aria-hidden="true">{initials(t)}</span>
                  <span class="t-attrib-text">
                    <span class="t-name">{nameLine(t)}</span>
                    <span class="t-sub"><span class="t-pin" set:html={pinSvg} />{subLine(t)}</span>
                  </span>
                </figcaption>
              </blockquote>
            </figure>
          );
        })}
      </div>
    )}

    {/* ─────────────── COMPACT — small quote cards ─────────────── */}
    {layout === 'compact' && (
      <div class="t-compact-grid" style={`--cols:${cols}`}>
        {items.map(t => {
          const thumb = (t.photos ?? [])[0];
          return (
            <figure class="t-compact">
              <span class="t-mark t-mark--sm" aria-hidden="true">“</span>
              <blockquote class="t-compact-quote">{t.quote}</blockquote>
              <figcaption class="t-attrib">
                {thumb
                  ? <button type="button" class="t-thumb-btn t-media-trigger" data-gallery={gallery((t.photos ?? []).slice(0, 3))} data-index="0" aria-label={`View project photos from ${nameLine(t)}`}>
                      <img class="t-thumb" src={`/images/${thumb.src}`} alt={thumb.alt} loading="lazy" decoding="async" width="56" height="56" />
                      {(t.photos ?? []).length > 1 && <span class="t-thumb-badge" aria-hidden="true">{(t.photos ?? []).length}</span>}
                    </button>
                  : <span class="t-initials" aria-hidden="true">{initials(t)}</span>}
                <span class="t-attrib-text">
                  <span class="t-name">{nameLine(t)}</span>
                  <span class="t-sub"><span class="t-pin" set:html={pinSvg} />{subLine(t)}</span>
                </span>
              </figcaption>
            </figure>
          );
        })}
      </div>
    )}

  </div>
</section>

<style>
  /* ════════════ SECTION HEAD ════════════ */
  .t-head { max-width: 60ch; margin-bottom: 3rem; }
  .t-head h2 { margin-top: .5rem; }
  .t-intro { color: var(--color-slate); margin-top: 1rem; font-size: var(--text-lg); line-height: 1.7; }

  /* ════════════ SHARED — quote mark, attribution ════════════ */
  .t-mark {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-emerald);
    line-height: 0;
    display: block;
  }

  .t-attrib { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; }
  .t-initials {
    width: 46px; height: 46px; border-radius: 50%; flex-shrink: 0;
    background: linear-gradient(135deg, var(--color-emerald), var(--color-teal));
    color: #fff; font-family: var(--font-display); font-weight: 600; font-size: .9rem;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 2px 8px rgba(26,83,62,.25);
  }
  .t-thumb {
    width: 52px; height: 52px; border-radius: 12px; object-fit: cover; flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(15,33,49,.12);
  }
  .t-attrib-text { display: flex; flex-direction: column; gap: .15rem; min-width: 0; }
  .t-name { font-weight: 700; color: var(--color-navy); font-size: .95rem; line-height: 1.2; }
  .t-sub { display: flex; align-items: center; gap: .3rem; font-size: .8125rem; color: var(--color-grey); line-height: 1.3; }
  .t-pin { display: inline-flex; flex-shrink: 0; color: var(--color-teal); }
  .t-pin :global(svg) { width: 13px; height: 13px; }

  .t-verified {
    margin-left: auto; display: inline-flex; align-items: center; gap: .35rem;
    font-size: .75rem; font-weight: 600; color: var(--color-emerald);
    background: rgba(26,83,62,.08); padding: .35rem .7rem; border-radius: 999px;
  }
  .t-check { display: inline-flex; }
  .t-check :global(svg) { width: 13px; height: 13px; }

  /* ════════════ FEATURED — editorial split ════════════ */
  .t-featured-list { display: flex; flex-direction: column; gap: 4rem; }
  .t-feat {
    margin: 0;
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    gap: 3.5rem;
    align-items: center;
  }
  .t-feat--rev .t-collage { order: 2; }
  .t-feat--noimg { grid-template-columns: 1fr; max-width: 760px; margin: 0 auto; text-align: center; }

  /* Collage — primary image + supporting shots, large */
  .t-collage {
    display: grid;
    gap: .75rem;
    height: clamp(340px, 34vw, 460px);
  }
  .t-collage--1 { grid-template-columns: 1fr; grid-template-rows: 1fr; }
  .t-collage--2 { grid-template-columns: 1.6fr 1fr; grid-template-rows: 1fr; }
  .t-collage--3 { grid-template-columns: 1.7fr 1fr; grid-template-rows: 1fr 1fr; }
  .t-collage-cell { overflow: hidden; border-radius: var(--radius-lg); position: relative; }
  .t-collage--3 .t-collage-cell--0 { grid-row: 1 / 3; }
  .t-collage-cell img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform .5s cubic-bezier(.2,.6,.2,1);
  }
  .t-collage-cell:hover img { transform: scale(1.05); }
  .t-collage-cell::after {
    content: ''; position: absolute; inset: 0; border-radius: var(--radius-lg);
    box-shadow: inset 0 0 0 1px rgba(15,33,49,.06); pointer-events: none;
  }

  .t-feat-body { margin: 0; }
  .t-feat .t-mark { font-size: 4rem; margin-bottom: .5rem; }
  .t-feat--noimg .t-mark { margin-left: auto; margin-right: auto; }
  .t-feat-quote {
    font-size: clamp(1.25rem, 1.9vw, 1.5rem);
    line-height: 1.55; color: var(--color-navy); font-weight: 500;
    margin: 0 0 1.75rem; max-width: 36ch; letter-spacing: -.01em;
  }
  .t-feat--noimg .t-feat-quote { max-width: 100%; margin-left: auto; margin-right: auto; }
  .t-feat--noimg .t-attrib { justify-content: center; }
  .t-feat--noimg .t-verified { margin-left: 0; }

  /* ════════════ GRID — hero-image cards ════════════ */
  .t-grid { display: grid; grid-template-columns: repeat(var(--cols, 3), 1fr); gap: 1.75rem; }
  .t-card {
    margin: 0; display: flex; flex-direction: column;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg); overflow: hidden;
    box-shadow: 0 1px 2px rgba(15,33,49,.04);
    transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
  }
  .t-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(15,33,49,.12);
    border-color: rgba(26,83,62,.2);
  }
  .t-card-media { position: relative; aspect-ratio: 3 / 2; overflow: hidden; background: var(--color-bg-alt); }
  .t-card-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s cubic-bezier(.2,.6,.2,1); }
  .t-card:hover .t-card-media img { transform: scale(1.05); }
  .t-card-media--brand {
    display: flex; align-items: flex-start; justify-content: flex-start;
    background: linear-gradient(135deg, var(--color-emerald), var(--color-teal));
  }
  .t-mark--watermark { font-size: 9rem; color: rgba(255,255,255,.22); padding: .25rem 1.25rem 0; }

  .t-photo-count {
    position: absolute; right: .75rem; bottom: .75rem;
    display: inline-flex; align-items: center; gap: .35rem;
    background: rgba(15,33,49,.72); color: #fff; backdrop-filter: blur(4px);
    font-size: .75rem; font-weight: 600; padding: .3rem .6rem; border-radius: 999px;
  }
  .t-cam { display: inline-flex; }
  .t-cam :global(svg) { width: 14px; height: 14px; }

  /* ════════════ LIGHTBOX TRIGGERS ════════════ */
  .t-media-trigger {
    appearance: none; -webkit-appearance: none;
    border: 0; margin: 0; padding: 0; background: none; font: inherit; color: inherit;
    display: block; width: 100%; cursor: zoom-in; position: relative;
  }
  .t-media-trigger:focus-visible { outline: 3px solid var(--color-teal); outline-offset: 3px; }
  /* Hover zoom affordance */
  .t-zoom {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%) scale(.85);
    width: 44px; height: 44px; border-radius: 50%;
    background: rgba(15,33,49,.55); color: #fff; backdrop-filter: blur(3px);
    display: flex; align-items: center; justify-content: center;
    opacity: 0; transition: opacity .2s ease, transform .2s ease; pointer-events: none; z-index: 2;
  }
  .t-zoom :global(svg) { width: 20px; height: 20px; }
  .t-media-trigger:hover .t-zoom,
  .t-media-trigger:focus-visible .t-zoom { opacity: 1; transform: translate(-50%, -50%) scale(1); }

  /* Compact thumbnail trigger */
  .t-thumb-btn {
    appearance: none; -webkit-appearance: none; border: 0; padding: 0; background: none;
    cursor: zoom-in; position: relative; flex-shrink: 0; line-height: 0; border-radius: 12px;
  }
  .t-thumb-btn:focus-visible { outline: 3px solid var(--color-teal); outline-offset: 2px; }
  .t-thumb-badge {
    position: absolute; right: -6px; bottom: -6px;
    min-width: 20px; height: 20px; padding: 0 5px; border-radius: 999px;
    background: var(--color-emerald); color: #fff; border: 2px solid var(--color-white);
    font-size: .7rem; font-weight: 700; line-height: 16px; text-align: center;
  }

  .t-card-body { padding: 1.5rem 1.5rem 1.5rem; display: flex; flex-direction: column; gap: 1.25rem; flex: 1; }
  .t-card-quote {
    font-size: .9688rem; line-height: 1.65; color: var(--color-slate);
    margin: 0; flex: 1; max-width: none;
  }
  .t-card-body .t-attrib { padding-top: 1.1rem; border-top: 1px solid var(--color-border); margin-top: auto; }

  /* ════════════ COMPACT — small quote cards ════════════ */
  .t-compact-grid { display: grid; grid-template-columns: repeat(var(--cols, 3), 1fr); gap: 1.5rem; }
  .t-compact {
    margin: 0; padding: 1.75rem; display: flex; flex-direction: column; gap: 1rem;
    background: var(--color-white); border: 1px solid var(--color-border);
    border-radius: var(--radius-lg); box-shadow: 0 1px 2px rgba(15,33,49,.04);
  }
  .t-mark--sm { font-size: 2.5rem; }
  .t-compact-quote {
    margin: 0; font-size: .9375rem; line-height: 1.65; color: var(--color-slate);
    flex: 1; max-width: none; quotes: none;
  }
  .t-compact .t-attrib { padding-top: 1rem; border-top: 1px solid var(--color-border); }

  /* ════════════ RESPONSIVE ════════════ */
  @media (max-width: 1000px) {
    .t-grid, .t-compact-grid { grid-template-columns: repeat(2, 1fr) !important; }
    .t-feat, .t-feat--rev { grid-template-columns: 1fr; gap: 1.75rem; }
    .t-feat--rev .t-collage { order: 0; }
    .t-collage { height: clamp(280px, 52vw, 380px); }
    .t-feat-quote { max-width: none; }
  }
  @media (max-width: 620px) {
    .t-head { margin-bottom: 2rem; }
    .t-grid, .t-compact-grid { grid-template-columns: 1fr !important; }
    .t-featured-list { gap: 3rem; }
    .t-collage--2, .t-collage--3 { grid-template-columns: 1fr 1fr; grid-template-rows: 1fr; height: 200px; }
    .t-collage--3 .t-collage-cell--0 { grid-row: auto; grid-column: 1 / 3; }
    .t-collage--3 { height: auto; grid-auto-rows: 150px; }
    .t-verified { margin-left: 0; }
  }
</style>

<!-- Lightbox overlay styling — global, since the overlay is created in <body> by JS -->
<style is:global>
  .tlb { position: fixed; inset: 0; z-index: 1000; display: none; align-items: center; justify-content: center; }
  .tlb.is-open { display: flex; animation: tlb-fade .2s ease; }
  @keyframes tlb-fade { from { opacity: 0; } to { opacity: 1; } }
  .tlb-backdrop { position: absolute; inset: 0; background: rgba(8,15,22,.9); backdrop-filter: blur(3px); }
  .tlb-figure { position: relative; z-index: 1; margin: 0; display: flex; flex-direction: column; align-items: center; gap: .85rem; max-width: 94vw; }
  .tlb-img { max-width: 88vw; max-height: 80vh; width: auto; height: auto; border-radius: 12px; box-shadow: 0 24px 70px rgba(0,0,0,.55); background: #11212f; display: block; }
  .tlb-cap { color: rgba(255,255,255,.82); font-size: .9rem; line-height: 1.5; text-align: center; max-width: 68ch; padding: 0 1rem; }
  .tlb-btn {
    position: fixed; z-index: 2; display: flex; align-items: center; justify-content: center;
    width: 48px; height: 48px; border: 0; border-radius: 50%; cursor: pointer;
    background: rgba(255,255,255,.12); color: #fff; font-size: 1.6rem; line-height: 1;
    transition: background .15s ease, transform .15s ease;
  }
  .tlb-btn:hover { background: rgba(255,255,255,.24); }
  .tlb-btn:focus-visible { outline: 3px solid var(--color-teal, #15686E); outline-offset: 2px; }
  .tlb-close { top: 1.1rem; right: 1.1rem; font-size: 1.9rem; }
  .tlb-prev { left: 1.1rem; top: 50%; transform: translateY(-50%); }
  .tlb-next { right: 1.1rem; top: 50%; transform: translateY(-50%); }
  .tlb-prev:hover { transform: translateY(-50%) scale(1.08); }
  .tlb-next:hover { transform: translateY(-50%) scale(1.08); }
  .tlb-counter { position: fixed; top: 1.5rem; left: 50%; transform: translateX(-50%); z-index: 2; color: rgba(255,255,255,.75); font-size: .85rem; font-weight: 600; letter-spacing: .03em; }
  @media (max-width: 620px) {
    .tlb-img { max-width: 94vw; max-height: 72vh; }
    .tlb-btn { width: 42px; height: 42px; }
    .tlb-prev { left: .5rem; } .tlb-next { right: .5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tlb.is-open { animation: none; }
    .tlb-btn, .tlb-img { transition: none; }
  }
</style>

<script>
  // Accessible, dependency-free lightbox for testimonial project photos.
  (function () {
    if ((window as any).__eriuLightbox) return;
    (window as any).__eriuLightbox = true;

    let overlay: HTMLElement, imgEl: HTMLImageElement, capEl: HTMLElement, counterEl: HTMLElement;
    let prevBtn: HTMLElement, nextBtn: HTMLElement;
    let current: { src: string; alt: string }[] = [];
    let idx = 0;
    let lastTrigger: HTMLElement | null = null;

    function build() {
      overlay = document.createElement('div');
      overlay.className = 'tlb';
      overlay.setAttribute('aria-hidden', 'true');
      overlay.innerHTML =
        '<div class="tlb-backdrop" data-close></div>' +
        '<span class="tlb-counter"></span>' +
        '<button class="tlb-btn tlb-close" data-close aria-label="Close gallery">×</button>' +
        '<button class="tlb-btn tlb-prev" data-prev aria-label="Previous photo">‹</button>' +
        '<figure class="tlb-figure"><img class="tlb-img" alt="" /><figcaption class="tlb-cap"></figcaption></figure>' +
        '<button class="tlb-btn tlb-next" data-next aria-label="Next photo">›</button>';
      document.body.appendChild(overlay);
      imgEl = overlay.querySelector('.tlb-img') as HTMLImageElement;
      capEl = overlay.querySelector('.tlb-cap') as HTMLElement;
      counterEl = overlay.querySelector('.tlb-counter') as HTMLElement;
      prevBtn = overlay.querySelector('.tlb-prev') as HTMLElement;
      nextBtn = overlay.querySelector('.tlb-next') as HTMLElement;
      overlay.addEventListener('click', (e) => {
        const el = e.target as HTMLElement;
        if (el.closest('[data-close]')) close();
        else if (el.closest('[data-prev]')) step(-1);
        else if (el.closest('[data-next]')) step(1);
      });
    }

    function render() {
      const p = current[idx];
      if (!p) return;
      imgEl.src = p.src;
      imgEl.alt = p.alt || '';
      capEl.textContent = p.alt || '';
      const multi = current.length > 1;
      counterEl.textContent = multi ? `${idx + 1} / ${current.length}` : '';
      prevBtn.style.display = multi ? '' : 'none';
      nextBtn.style.display = multi ? '' : 'none';
    }

    function step(d: number) { idx = (idx + d + current.length) % current.length; render(); }

    function open(photos: { src: string; alt: string }[], start: number) {
      if (!overlay) build();
      current = photos; idx = start || 0; render();
      overlay.classList.add('is-open');
      overlay.setAttribute('aria-hidden', 'false');
      document.documentElement.style.overflow = 'hidden';
      (overlay.querySelector('.tlb-close') as HTMLElement).focus();
    }

    function close() {
      overlay.classList.remove('is-open');
      overlay.setAttribute('aria-hidden', 'true');
      document.documentElement.style.overflow = '';
      if (lastTrigger) lastTrigger.focus();
    }

    document.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement).closest('.t-media-trigger') as HTMLElement | null;
      if (!trigger) return;
      const galleryEl = trigger.closest('[data-gallery]') as HTMLElement | null;
      if (!galleryEl) return;
      let photos;
      try { photos = JSON.parse(galleryEl.getAttribute('data-gallery') || '[]'); }
      catch (_) { return; }
      if (!photos || !photos.length) return;
      e.preventDefault();
      lastTrigger = trigger;
      open(photos, parseInt(trigger.getAttribute('data-index') || '0', 10));
    });

    document.addEventListener('keydown', (e) => {
      if (!overlay || !overlay.classList.contains('is-open')) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') step(-1);
      else if (e.key === 'ArrowRight') step(1);
    });
  })();
</script>
