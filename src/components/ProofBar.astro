---
// ProofBar.astro, factual trust strip for the modular funnel.
// Every point is a process fact substantiated elsewhere on the page —
// no testimonials, no claims we can't stand over.
interface Props {
  points?: string[];
}
const {
  points = [
    'Inspected in person in China',
    'Photographed at factory, port & site',
    'Full Building-Regs compliance pack',
    'Irish-owned, you ring Ireland',
  ],
} = Astro.props;
---
<ul class="proofbar" aria-label="How we stand over every unit">
  {points.map(p => (
    <li class="proof-item">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="12" cy="12" r="11" fill="rgba(26, 83, 62, .1)" />
        <path d="M7 12.5l3.2 3.2L17 9" stroke="#1a533e" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span>{p}</span>
    </li>
  ))}
</ul>

<style>
  .proofbar {
    list-style: none;
    margin: 0;
    padding: 1.25rem 1.5rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem 1.5rem;
    background: rgba(26, 83, 62, 0.05);
    border: 1px solid rgba(26, 83, 62, 0.15);
    border-radius: 12px;
  }
  .proof-item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-navy);
    line-height: 1.35;
  }
  .proof-item svg { flex-shrink: 0; }
  @media (max-width: 760px) {
    .proofbar { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 420px) {
    .proofbar { grid-template-columns: 1fr; }
  }
</style>
