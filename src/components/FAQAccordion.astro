---
// FAQAccordion.astro — shared FAQ accordion using <details>/<summary>.
//
// Replaces per-template .faq-list + .faq-item duplication across:
// home page, source/[slug], source/[category]/[product], blog/[slug].
//
// Pure HTML/CSS — no JS needed for open/close (native details element).
// Emits no JSON-LD — the page-level FAQPage schema is still emitted from
// the page template (since it lives in the page's @graph).

interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  items: FaqItem[];
  /** When true, the first item is open by default. Useful for short lists. */
  firstOpen?: boolean;
}

const { items, firstOpen = false } = Astro.props;
---

<div class="faq-accordion">
  {items.map((item, i) => (
    <details class="faq-item" open={firstOpen && i === 0}>
      <summary class="faq-q">
        <span>{item.q}</span>
      </summary>
      <div class="faq-a">
        <p>{item.a}</p>
      </div>
    </details>
  ))}
</div>

<style>
  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .faq-item {
    border-bottom: 1px solid rgba(15, 33, 49, 0.08);
  }

  .faq-item:first-child {
    border-top: 1px solid rgba(15, 33, 49, 0.08);
  }

  .faq-q {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-navy);
    padding: 1.25rem 0;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    line-height: 1.4;
    transition: color 0.15s ease;
  }

  /* Hide the default details marker across browsers */
  .faq-q::-webkit-details-marker {
    display: none;
  }

  .faq-q:hover {
    color: var(--color-emerald);
  }

  .faq-q::after {
    content: '+';
    font-size: 1.5rem;
    font-weight: 300;
    color: var(--color-emerald);
    flex-shrink: 0;
    transition: transform 0.2s ease;
    line-height: 1;
  }

  .faq-item[open] .faq-q::after {
    transform: rotate(45deg);
  }

  .faq-a {
    padding: 0 0 1.25rem;
  }

  .faq-a p {
    font-size: 0.9375rem;
    color: #3a3a3a;
    line-height: 1.7;
    margin: 0;
    max-width: 70ch;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-q,
    .faq-q::after {
      transition: none;
    }
  }
</style>
