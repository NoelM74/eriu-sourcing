---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Modular Home Factory Visits in China | Ériu Modular Homes";
const description = "See your future home built. 3-day factory visit to Henan Province from €1,800 per person — fully credited against your confirmed order. Tour 2–3 factories, sign off the spec on the factory floor.";
const canonical = "/modular-homes/factory-visits/";
const siteUrl = "https://eriusourcing.com";

const pageSchemas = [
    {
      "@type": "Service",
      "name": "Modular Home Factory Visit — Henan Province, China",
      "provider": {
        "@type": "Organization",
        "name": "Ériu Modular Homes",
        "url": `${siteUrl}/modular-homes/`
      },
      "description": "Guided 3-day factory visit programme to modular and container home manufacturers in Henan Province. Tour 2–3 vetted factories, meet production teams, sign off build specifications on the factory floor. Trip cost credited in full against a confirmed order.",
      "areaServed": { "@type": "Country", "name": "Ireland" },
      "serviceType": "Factory Visit Programme",
      "url": `${siteUrl}${canonical}`
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/` },
        { "@type": "ListItem", "position": 2, "name": "Modular Homes", "item": `${siteUrl}/modular-homes/` },
        { "@type": "ListItem", "position": 3, "name": "Factory Visits", "item": `${siteUrl}${canonical}` }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much does the factory visit cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The programme fee is €1,800 per person. This covers all in-China logistics: airport transfers, accommodation for 3 nights, factory transportation, meals during factory days, and translation. International flights from Ireland to Zhengzhou are arranged separately. The full €1,800 is credited against your confirmed order."
          }
        },
        {
          "@type": "Question",
          "name": "Is the €1,800 really fully credited against my order?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, 100%. When you place a confirmed order within 90 days of completing the visit, the €1,800 programme fee is deducted from your first deposit. If you bring a second person, their €1,800 is also credited. The credit does not expire if a project timeline shifts — we simply carry it to the deposit stage whenever you're ready."
          }
        },
        {
          "@type": "Question",
          "name": "Which factories will I visit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We select 2–3 factories from our vetted Henan supplier network based on your unit type, budget, and lead-time requirements. All factories on the itinerary manufacture expandable container homes or modular steel-frame units, hold ISO 9001 certification, and have exported to Europe. You will see at minimum one factory currently in active production."
          }
        },
        {
          "@type": "Question",
          "name": "What happens during the 3 days?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Day 1: Arrival into Zhengzhou Xinzheng International Airport (CGO), transfer to hotel, evening briefing on factory selection and spec review. Day 2: Full-day at primary factory — production floor walk, QC station review, spec sign-off meeting with factory engineer, material and finish selection. Day 3: Secondary factory visit in the morning; optional Shenzhen connection for finishing materials (tiles, fixtures, fittings) in the afternoon. Departure on Day 4 or extend for further sourcing."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need to speak Mandarin?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Noel Murphy or a senior Ériu team member accompanies you throughout as resident interpreter and sourcing advisor. All factory meetings are conducted in Mandarin on your behalf. Written spec sheets and contracts are translated into English before signing."
          }
        },
        {
          "@type": "Question",
          "name": "Can I visit with a partner, architect, or builder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Additional participants are welcome at the same €1,800 per person rate, each credit applicable to the same order. Many clients bring a spouse, a local builder for technical sign-off, or a project manager. The more eyes on the factory floor at spec stage, the fewer change orders during production."
          }
        },
        {
          "@type": "Question",
          "name": "What is the lead time after the factory visit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Production lead time after deposit is 14–18 weeks for standard expandable models (20FT, 30FT, 40FT). Custom configurations or the 700Wide series may extend to 20 weeks. Sea freight from Zhengzhou port to Ireland (via rail to Qingdao or Tianjin, then vessel to Dublin or Cork) adds approximately 5–6 weeks. Total Ireland delivery: 19–24 weeks from deposit."
          }
        },
        {
          "@type": "Question",
          "name": "What if I visit but decide not to order?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "There is no obligation to order. The €1,800 programme fee covers the cost of the visit itself — logistics, accommodation, translation, and our time. If you decide the product is not right for your project, you have lost nothing except the programme fee and the cost of your flights. Most clients find that seeing the factory and meeting the production team resolves the doubts that were stopping them from committing."
          }
        }
      ]
    }
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={pageSchemas}>

  <!-- ── HERO ── -->
  <section class="factory-hero">
    <div class="factory-hero__media">
      <img
        src="/images/modular-homes-factory-zhengzhou-floor.webp"
        alt="Modular home factory floor in Henan Province, China — expandable container units in production"
        width="1400"
        height="700"
        loading="eager"
        fetchpriority="high"
        onerror="this.closest('.factory-hero__media').style.background='#1A533E'"
      />
      <div class="factory-hero__overlay"></div>
    </div>
    <div class="factory-hero__content container">
      <p class="eyebrow">Ériu Modular Homes · Factory Visit Programme</p>
      <h1>See Your Home Built.<br>Before You Commit a Cent.</h1>
      <p class="hero-lead">A 3-day guided visit to the factories that will build your unit. You walk the production floor, shake hands with the engineer, choose your finishes — and the entire trip cost is credited against your order.</p>
      <div class="hero-price-badge">
        <span class="price-from">from</span>
        <span class="price-amount">€1,800</span>
        <span class="price-detail">per person · fully credited on order</span>
      </div>
      <a href="/contact/?interest=factory-visit" class="btn btn--white-outline hero-cta">Register Interest</a>
    </div>
  </section>

  <!-- ── NO COMPETITOR CALLOUT ── -->
  <section class="differentiator-bar">
    <div class="container">
      <p><strong>No Irish competitor offers this.</strong> Every other modular home supplier in Ireland will show you a brochure and a 3D render. We will show you the factory, the welds, the insulation panel, and the QC sign-off sheet — in person, before you pay your deposit.</p>
    </div>
  </section>

  <!-- ── WHY THIS MATTERS ── -->
  <section class="section why-visit">
    <div class="container">
      <h2>Why the Factory Visit Changes Everything</h2>
      <p class="section-lead">Buying a modular home is a significant financial decision. Most buyers sign contracts based on renders, spec sheets, and promises. The clients who visit the factory make faster decisions, fewer change-order requests, and have more confidence throughout the build.</p>

      <div class="reasons-grid">
        <div class="reason-card">
          <div class="reason-icon">👁</div>
          <h3>You See the Actual Build Quality</h3>
          <p>Walk the production floor while units similar to yours are being assembled. Inspect weld quality on the steel frame, check insulation panel thickness, examine window seals and roof drainage — not from a photo, but in your hand.</p>
        </div>
        <div class="reason-card">
          <div class="reason-icon">📐</div>
          <h3>Spec Sign-Off at the Source</h3>
          <p>Change requests are free before production starts. After the first cut of steel, they cost time and money. Meeting the factory engineer on-site and signing off your exact specification eliminates the most common cause of delivery disappointment.</p>
        </div>
        <div class="reason-card">
          <div class="reason-icon">🏗</div>
          <h3>You Choose Your Finishes In Person</h3>
          <p>Floor tiles, wall cladding, window frame colour, bathroom fittings — see the physical samples, not a colour code on a PDF. On Day 3 we can visit finishing material suppliers in the same region to extend your options further.</p>
        </div>
        <div class="reason-card">
          <div class="reason-icon">🤝</div>
          <h3>The Factory Knows You</h3>
          <p>A client who has walked your floor gets different treatment. Questions are answered faster. Production updates are more reliable. When a shipping window tightens, your order is the one the factory prioritises.</p>
        </div>
        <div class="reason-card">
          <div class="reason-icon">🔎</div>
          <h3>Compare 2–3 Factories Side by Side</h3>
          <p>We select your itinerary from our vetted Henan supplier network based on your unit type and budget. You see multiple production environments in the same trip and can make a supplier decision based on direct observation.</p>
        </div>
        <div class="reason-card">
          <div class="reason-icon">💶</div>
          <h3>The Cost Is Zero on Confirmation</h3>
          <p>The €1,800 programme fee is credited in full against your deposit. Bring a second person — their fee is also credited. If you come with your architect and a local builder, three sets of critical professional eyes are on the factory floor, all credited.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 3-DAY ITINERARY ── -->
  <section class="section itinerary-section">
    <div class="container">
      <h2>The Three-Day Programme</h2>
      <p class="section-lead">All in-China logistics are included. International flights from Ireland to Zhengzhou (CGO) are arranged separately — typically €650–€950 return via major hubs.</p>

      <div class="itinerary-timeline">

        <div class="itinerary-day">
          <div class="day-marker">
            <span class="day-number">1</span>
          </div>
          <div class="day-content">
            <h3>Day 1 — Arrival & Briefing · Zhengzhou</h3>
            <ul>
              <li>Airport transfer from Zhengzhou Xinzheng International (CGO) to hotel</li>
              <li>Check-in at central Zhengzhou (4-star, twin-room option available)</li>
              <li>Evening briefing with Noel Murphy: factory itinerary, spec review, what to look for</li>
              <li>Dinner at a local restaurant — no factory visits on Day 1</li>
            </ul>
            <p class="day-note">Flight recommendation: morning departure from Dublin (DUB) via Amsterdam (AMS) or Frankfurt (FRA) arrives Zhengzhou same evening or following morning. We can advise on routing once you register.</p>
          </div>
        </div>

        <div class="itinerary-day">
          <div class="day-marker">
            <span class="day-number">2</span>
          </div>
          <div class="day-content">
            <h3>Day 2 — Primary Factory · Full Day</h3>
            <ul>
              <li>Depart hotel 08:30 — factory typically 45–90 mins outside Zhengzhou city</li>
              <li>Production floor walk with factory QC manager (2 hrs)</li>
              <li>Steel frame fabrication area: inspect weld quality and galvanisation</li>
              <li>Insulation panel station: check EPS/PU thickness and compression rating</li>
              <li>Window and door installation bay: seal quality and hardware review</li>
              <li>Spec sign-off session with factory engineer — your exact layout confirmed in writing</li>
              <li>Finish selection: flooring, wall panels, roof profile, window colour</li>
              <li>Lunch on-site with factory management</li>
              <li>Afternoon: completed unit inspection (walk through a finished unit if available)</li>
              <li>Return to Zhengzhou by 18:00</li>
            </ul>
          </div>
        </div>

        <div class="itinerary-day">
          <div class="day-marker">
            <span class="day-number">3</span>
          </div>
          <div class="day-content">
            <h3>Day 3 — Secondary Factory · Morning + Options</h3>
            <ul>
              <li>Second factory visit (morning, 3–4 hrs): comparable or complementary manufacturer</li>
              <li>Side-by-side build quality comparison from direct observation</li>
              <li>Supplier selection discussion with Noel on the return journey</li>
              <li><strong>Option A:</strong> Afternoon free in Zhengzhou — depart Day 4 morning</li>
              <li><strong>Option B:</strong> Afternoon train to Shenzhen finishing materials market (tiles, sanitary ware, fixtures) — adds one night, depart Day 5</li>
              <li><strong>Option C:</strong> Extend stay for additional supplier meetings or a third factory</li>
            </ul>
            <p class="day-note">Most clients choose Option A or B. The Shenzhen extension adds €200–€350 in additional accommodation and rail but gives access to the largest building materials market in China.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── WHAT'S INCLUDED / NOT INCLUDED ── -->
  <section class="section included-section">
    <div class="container">
      <h2>What's Covered by the €1,800 Programme Fee</h2>
      <div class="included-grid">
        <div class="included-col">
          <h3 class="included-heading included-heading--yes">Included</h3>
          <ul class="included-list included-list--yes">
            <li>Airport transfers (arrival and departure)</li>
            <li>Hotel accommodation — 3 nights, central Zhengzhou</li>
            <li>All factory transportation (minibus)</li>
            <li>Full-time Mandarin interpretation throughout</li>
            <li>Meals on factory days (lunch + factory dinner Day 1)</li>
            <li>Spec sign-off documentation (English and Chinese)</li>
            <li>Factory due-diligence report after visit</li>
            <li>Post-visit supplier recommendation memo</li>
            <li>90-day credit window against your order deposit</li>
          </ul>
        </div>
        <div class="included-col">
          <h3 class="included-heading included-heading--no">Not Included</h3>
          <ul class="included-list included-list--no">
            <li>International flights (Dublin or Cork to Zhengzhou CGO)</li>
            <li>Travel insurance (required — arrange before departure)</li>
            <li>Chinese visa (Irish passport holders: apply in advance, typically €75)</li>
            <li>Personal meals outside factory days</li>
            <li>Optional Shenzhen extension (approx. €200–€350 additional)</li>
            <li>Any purchasing at factories or markets</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── WHO SHOULD VISIT ── -->
  <section class="section who-visits">
    <div class="container">
      <div class="who-split">
        <div class="who-text">
          <h2>Who the Visit Is For</h2>
          <p>The factory visit is designed for serious buyers at the decision stage — people who have already shortlisted Ériu Modular Homes as a supplier and want to remove the last uncertainty before committing to a deposit.</p>
          <p>It is particularly valuable for:</p>
          <ul class="who-list">
            <li><strong>Homeowners planning a back-garden unit</strong> — the €1,800 credit against a €40k–€80k purchase represents 2–4% of total cost for complete confidence in what you're buying</li>
            <li><strong>Developers ordering 2+ units</strong> — factory relationship and spec alignment at this stage prevents expensive change orders across multiple units</li>
            <li><strong>Architects and project managers</strong> — technical sign-off on-site removes liability exposure and gives direct access to factory engineering team</li>
            <li><strong>Investors adding a rental unit</strong> — seeing the build quality first-hand makes the yield calculation real rather than theoretical</li>
          </ul>
          <p>The visit is optional. The majority of our clients will order without visiting. But for every client who does visit, the transaction completes faster, with fewer queries, and with higher satisfaction at delivery.</p>
        </div>
        <div class="who-stats">
          <div class="visit-stat">
            <span class="visit-stat__number">3</span>
            <span class="visit-stat__label">days in China</span>
          </div>
          <div class="visit-stat">
            <span class="visit-stat__number">2–3</span>
            <span class="visit-stat__label">factories visited</span>
          </div>
          <div class="visit-stat">
            <span class="visit-stat__number">€1,800</span>
            <span class="visit-stat__label">per person</span>
          </div>
          <div class="visit-stat visit-stat--highlight">
            <span class="visit-stat__number">100%</span>
            <span class="visit-stat__label">credited on order</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── NOEL CONTEXT ── -->
  <section class="section noel-section">
    <div class="container">
      <div class="noel-card">
        <div class="noel-card__body">
          <p class="noel-eyebrow">Your guide in Henan</p>
          <h2>Zhengzhou Has Been My Office Since 2008</h2>
          <p>I moved to Zhengzhou in 2008 to work directly with Chinese manufacturers. Over 16 years I have built relationships with factory owners, QC managers, and freight partners across Henan Province — the same province that produces most of China's expandable container homes.</p>
          <p>When you visit with Ériu, you are not being guided by a tour operator. You are walking factory floors with someone who knows the production manager by name, who has seen the factory's best work and its worst, and who will tell you honestly which supplier is right for your project.</p>
          <p>I do not represent any factory. I represent the client — you. That is what sourcing agents do.</p>
          <cite>— Noel Murphy, Founder · Ériu Sourcing · Based in Zhengzhou since 2008</cite>
        </div>
      </div>
    </div>
  </section>

  <!-- ── HENAN CONTEXT ── -->
  <section class="section henan-section">
    <div class="container">
      <h2>Why Henan Province?</h2>
      <div class="henan-grid">
        <div class="henan-text">
          <p>Henan Province is China's primary manufacturing hub for expandable container homes and modular steel-frame structures. The concentration of specialised manufacturers, steel suppliers, insulation panel producers, and component fabricators in one region creates a supply chain that produces cost advantages not replicable elsewhere in China — or anywhere in Europe.</p>
          <p>The factories on our approved list have all:</p>
          <ul>
            <li>Held ISO 9001 quality management certification for ≥ 3 years</li>
            <li>Exported completed units to at least one EU country</li>
            <li>Passed our in-person due-diligence audit (production capacity, workforce stability, financial health indicators)</li>
            <li>Provided reference contacts from prior European clients</li>
          </ul>
          <p>We do not work with every factory in Henan. We work with the subset whose quality, communication, and export compliance standards meet the bar for Irish construction projects.</p>
        </div>
        <div class="henan-facts">
          <h3>Henan Modular Manufacturing — Key Facts</h3>
          <dl class="henan-dl">
            <dt>Province population</dt>
            <dd>99 million — largest in China by population</dd>
            <dt>Central China logistics hub</dt>
            <dd>Rail connection to Qingdao and Tianjin ports (3–4 days to port)</dd>
            <dt>Steel availability</dt>
            <dd>Multiple integrated steel mills within 200km — lower input cost vs coastal factories</dd>
            <dt>Expandable home manufacturers</dt>
            <dd>40+ active manufacturers in the Zhengzhou–Xinxiang–Kaifeng corridor</dd>
            <dt>EU export experience</dt>
            <dd>Established shipping routes to Germany, Netherlands, UK — CE-certified components available</dd>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="section visit-cta-section">
    <div class="container">
      <div class="visit-cta-box">
        <h2>Register Your Interest</h2>
        <p>Factory visit dates are arranged around client availability — there is no fixed group departure. Fill in the form below and we will discuss your project timeline, unit requirements, and proposed travel dates.</p>
        <p>There is no commitment required at this stage. We will send you a full programme outline including recommended flight routes, visa guidance, and factory shortlist once we understand your project brief.</p>
        <a href="/contact/?interest=factory-visit" class="btn btn--primary btn--large">Register Factory Visit Interest</a>
        <p class="cta-sub">Or call to discuss: <a href="tel:+353">contact us for our number</a></p>
      </div>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="section faq-section">
    <div class="container faq-container">
      <h2>Factory Visit — Frequently Asked Questions</h2>
      <p class="faq-updated">Last reviewed: May 2026</p>

      <details>
        <summary>How much does the factory visit cost?</summary>
        <p>The programme fee is €1,800 per person. This covers all in-China logistics: airport transfers, accommodation for 3 nights, factory transportation, meals during factory days, and translation. International flights from Ireland to Zhengzhou are arranged separately. The full €1,800 is credited against your confirmed order.</p>
      </details>

      <details>
        <summary>Is the €1,800 really fully credited against my order?</summary>
        <p>Yes, 100%. When you place a confirmed order within 90 days of completing the visit, the €1,800 programme fee is deducted from your first deposit. If you bring a second person, their €1,800 is also credited. The credit does not expire if a project timeline shifts — we simply carry it to the deposit stage whenever you're ready.</p>
      </details>

      <details>
        <summary>Which factories will I visit?</summary>
        <p>We select 2–3 factories from our vetted Henan supplier network based on your unit type, budget, and lead-time requirements. All factories on the itinerary manufacture expandable container homes or modular steel-frame units, hold ISO 9001 certification, and have exported to Europe. You will see at minimum one factory currently in active production.</p>
      </details>

      <details>
        <summary>Do I need to speak Mandarin?</summary>
        <p>No. Noel Murphy or a senior Ériu team member accompanies you throughout as resident interpreter and sourcing advisor. All factory meetings are conducted in Mandarin on your behalf. Written spec sheets and contracts are translated into English before signing.</p>
      </details>

      <details>
        <summary>Can I visit with a partner, architect, or builder?</summary>
        <p>Yes. Additional participants are welcome at the same €1,800 per person rate, each credit applicable to the same order. Many clients bring a spouse, a local builder for technical sign-off, or a project manager. The more eyes on the factory floor at spec stage, the fewer change orders during production.</p>
      </details>

      <details>
        <summary>What is the lead time after the factory visit?</summary>
        <p>Production lead time after deposit is 14–18 weeks for standard expandable models (20FT, 30FT, 40FT). Custom configurations or the 700Wide series may extend to 20 weeks. Sea freight from Zhengzhou port to Ireland (via rail to Qingdao or Tianjin, then vessel to Dublin or Cork) adds approximately 5–6 weeks. Total Ireland delivery: 19–24 weeks from deposit.</p>
      </details>

      <details>
        <summary>What if I visit but decide not to order?</summary>
        <p>There is no obligation to order. The €1,800 programme fee covers the cost of the visit itself — logistics, accommodation, translation, and our time. If you decide the product is not right for your project, you have lost nothing except the programme fee and the cost of your flights. Most clients find that seeing the factory and meeting the production team resolves the doubts that were stopping them from committing.</p>
      </details>

      <details>
        <summary>What visa do I need and how do I get it?</summary>
        <p>Irish passport holders require a Chinese tourist or business visa. Applications are made through the Chinese Visa Application Service Centre in Dublin. Processing time is typically 4–7 working days for standard service. The fee is approximately €75. We provide a support letter for your visa application confirming the business purpose of your visit. We recommend applying at least 3 weeks before your intended travel date.</p>
      </details>
    </div>
  </section>

  <!-- ── BACK-LINK ── -->
  <section class="section back-nav">
    <div class="container">
      <a href="/modular-homes/" class="back-link">← Back to Ériu Modular Homes Overview</a>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero ── */
  .factory-hero {
    position: relative;
    min-height: 72vh;
    display: flex;
    align-items: center;
    color: #fff;
    overflow: hidden;
  }

  .factory-hero__media {
    position: absolute;
    inset: 0;
    background: #1A533E;
  }

  .factory-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .factory-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(15,33,49,0.75) 0%, rgba(26,83,62,0.55) 100%);
  }

  .factory-hero__content {
    position: relative;
    z-index: 2;
    padding-top: 5rem;
    padding-bottom: 5rem;
    max-width: 680px;
  }

  .eyebrow {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.75);
    margin-bottom: 1rem;
  }

  .factory-hero__content h1 {
    font-family: 'Boska', Georgia, serif;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 1.25rem;
    color: #fff;
  }

  .hero-lead {
    font-size: 1.125rem;
    line-height: 1.65;
    color: rgba(255,255,255,0.9);
    margin-bottom: 2rem;
    max-width: 560px;
  }

  .hero-price-badge {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 8px;
    padding: 0.75rem 1.25rem;
    margin-bottom: 2rem;
    backdrop-filter: blur(4px);
    flex-wrap: wrap;
  }

  .price-from {
    font-size: 0.875rem;
    color: rgba(255,255,255,0.7);
  }

  .price-amount {
    font-family: 'Boska', Georgia, serif;
    font-size: 2rem;
    font-weight: 700;
    color: #fff;
    line-height: 1;
  }

  .price-detail {
    font-size: 0.875rem;
    color: rgba(255,255,255,0.75);
  }

  .btn--white-outline {
    background: transparent;
    border: 2px solid rgba(255,255,255,0.7);
    color: #fff;
