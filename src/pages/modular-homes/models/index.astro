---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { modularHomeModels } from '../../../data/modular-home-models.js';

const title = "Expandable Container Home Models | Ériu Modular Homes";
const description = "Expandable steel-frame container home models — 20ft, 30ft, 40ft and 20FT700. Dimensions, internal area, weight, container loading and floor-plan layouts.";
const canonical = "/modular-homes/models/";
const siteUrl = "https://eriusourcing.com";

const models = modularHomeModels;

const pageSchemas = [
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
      { "@type": "ListItem", "position": 2, "name": "Modular Homes", "item": `${siteUrl}/modular-homes/` },
      { "@type": "ListItem", "position": 3, "name": "Models", "item": `${siteUrl}${canonical}` }
    ]
  },
  {
    "@type": "ItemList",
    "name": "Ériu Modular Homes — Expandable Container Home Models",
    "description": "Four expandable steel-frame container home models supplied factory-direct from Henan Province to Ireland.",
    "itemListElement": models.map((m, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": m.name,
      "description": m.tagline
    }))
  },
  {
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is an expandable container home?",
        "acceptedAnswer": { "@type": "Answer", "text": "An expandable container home is a steel-frame modular dwelling that ships flat in standard ISO container dimensions, then folds open on site to deliver internal floor area roughly 2.5 to 3 times the folded footprint. The 20ft model folds to 5.9 × 2.2 metres for shipping and expands to approximately 34 square metres of internal living space. The expansion mechanism uses hinged side panels, deployed by crane or a small site team within 1 to 2 days of arrival." }
      },
      {
        "@type": "Question",
        "name": "How many expandable container homes fit in a single 40ft HQ container?",
        "acceptedAnswer": { "@type": "Answer", "text": "Loading capacity varies by model: the 20FT700 foldable unit ships 6 sets per 40HQ container (highest shipping efficiency), the 20ft expandable ships 2 sets per 40HQ, and the 30ft and 40ft expandable models each ship 1 set per 40HQ. For multi-unit projects, the 20FT700 model offers dramatically lower per-unit freight cost." }
      },
      {
        "@type": "Question",
        "name": "What is the internal ceiling height of an expandable container home?",
        "acceptedAnswer": { "@type": "Answer", "text": "The 20ft and 20FT700 units have an internal clear ceiling height of 2,240 mm (2.24 metres). The 30ft and 40ft units have an internal clear ceiling height of 2,200 mm. All four models exceed the minimum habitable room ceiling height requirements in Irish Building Regulations Technical Guidance Document A." }
      },
      {
        "@type": "Question",
        "name": "How long does it take to deploy an expandable container home on site in Ireland?",
        "acceptedAnswer": { "@type": "Answer", "text": "On a prepared foundation, the structural deployment from folded to fully expanded takes 1 to 2 days for the 20ft, 30ft and 40ft models. Services connection (water, electricity, drainage) and internal fit-out are completed in the following 2 to 3 weeks for a Tier 2 Turnkey specification." }
      },
      {
        "@type": "Question",
        "name": "Which model is best for a 45 m² Irish back-garden auxiliary dwelling?",
        "acceptedAnswer": { "@type": "Answer", "text": "For the 45 m² maximum under the 2026 Irish Auxiliary Dwelling exemption, the 30ft expandable at ~52 m² internal is the closest fit and fits within the exempted footprint with careful siting. The 20ft at ~34 m² is ideal for a single-bedroom unit. The 40ft at ~70 m² exceeds the exempted area and requires full planning permission as a habitable dwelling." }
      }
    ]
  }
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={pageSchemas}>

  <!-- HERO -->
  <section class="page-hero section--lg">
    <div class="container--narrow">
      <span class="section-eyebrow">Models</span>
      <h1>Four expandable container home models. One spec sheet.</h1>
      <p class="lead">Steel-frame, factory-direct from Henan Province. Each unit ships flat in standard ISO container dimensions and folds open on your foundation. Full dimensions, internal area, weight and container loading data — everything you need to spec your project.</p>
      <a href="/contact/" class="btn btn--primary">Request a quote for your project →</a>
    </div>
  </section>

  <!-- COMPARISON TABLE -->
  <section class="section section--alt">
    <div class="container">
      <span class="section-eyebrow">At a glance</span>
      <h2>Compare all four models</h2>
      <p class="table-intro">Folded dimensions are the shipping size. Expanded dimensions are the deployed size on your foundation. Internal dimensions are the usable habitable space.</p>
      <div class="models-table-wrap">
        <table class="models-table">
          <thead>
            <tr>
              <th>Spec</th>
              {models.map(m => <th>{m.name}</th>)}
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Expanded size</th>
              {models.map(m => <td>{m.expanded}</td>)}
            </tr>
            <tr>
              <th scope="row">Internal size</th>
              {models.map(m => <td>{m.internal}</td>)}
            </tr>
            <tr>
              <th scope="row">Folded size (shipping)</th>
              {models.map(m => <td>{m.folded}</td>)}
            </tr>
            <tr>
              <th scope="row">Internal floor area</th>
              {models.map(m => <td><strong>{m.internalArea}</strong></td>)}
            </tr>
            <tr>
              <th scope="row">Total net weight</th>
              {models.map(m => <td>{m.weight}</td>)}
            </tr>
            <tr>
              <th scope="row">Loading per 40HQ</th>
              {models.map(m => <td>{m.loading}</td>)}
            </tr>
            <tr class="best-for-row">
              <th scope="row">Best for</th>
              {models.map(m => <td class="best-for-cell">{m.bestFor}</td>)}
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- BUILD QUALITY -->
  <section class="section">
    <div class="container">
      <span class="section-eyebrow">Build quality</span>
      <h2>What's inside every unit</h2>
      <p class="table-intro">Every model in the Ériu range is built to the same structural specification regardless of size.</p>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">🏗</div>
          <h3>9.0 mm channel steel frame</h3>
          <p>Thicker than standard modular construction. The heavy-gauge channel steel base frame provides structural rigidity during shipping, lifting and long-term load-bearing on Irish foundations.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🔩</div>
          <h3>1.3 mm steel roof plate</h3>
          <p>Container-grade steel plate on the roof, not composite panel. Rated for the wind and snow loads applicable in Ireland without additional reinforcement.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🧱</div>
          <h3>18 mm wall thickness</h3>
          <p>Wall panels at 18 mm connect firmly to the frame at each joint, providing both structural continuity and an effective weather seal at all seams.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">💧</div>
          <h3>Pre-designed drainage system</h3>
          <p>Rainwater drainage channels are engineered into the roof profile and wall junctions at the factory, not added on site. Connects to standard Irish drainage fittings.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">⚡</div>
          <h3>Earthed electrical fittings</h3>
          <p>All electrical fittings are anti-electric-shock rated, dustproof and waterproof. Wiring is routed through the frame to Irish electrical regulation standards on Tier 2 and Tier 3 units.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🔐</div>
          <h3>Sealed expansion joints</h3>
          <p>The hinged expansion panels are sealed at all junctions with purpose-made gaskets to prevent air infiltration and water ingress at the fold line — the most common failure point in cheaper expandable units.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- MODEL DETAIL CARDS — link to dedicated SEO landing pages -->
  <section class="section">
    <div class="container">
      <span class="section-eyebrow">Browse by model</span>
      <h2>Open the full spec sheet for any model</h2>
      <p class="table-intro">Each model has a dedicated page with the full specification, available floor plans, typical Irish use cases, and model-specific FAQ.</p>
      <div class="model-cards-grid">
        {models.map(model => (
          <a href={`/modular-homes/models/${model.slug}/`} class="model-card lift">
            <div class="model-card-image">
              <img src={model.image} alt={model.imageAlt} width="560" height="380" loading="lazy" />
            </div>
            <div class="model-card-body">
              <span class="model-card-eyebrow">{model.eyebrow}</span>
              <h3>{model.name}</h3>
              <p class="model-card-tagline">{model.tagline}</p>
              <ul class="model-card-spec" role="list">
                <li><strong>{model.internalArea}</strong> internal</li>
                <li>{model.loading}</li>
                <li>{model.weight}</li>
              </ul>
              <span class="model-card-cta">Open the {model.name} spec sheet →</span>
            </div>
          </a>
        ))}
      </div>

      <div class="floorplans-deep-link">
        <p><a href="/modular-homes/models/floor-plans/" class="inline-link">See all available floor plan layouts across the four models →</a></p>
      </div>
    </div>
  </section>

  <!-- INTERIOR PHOTOS -->
  <section class="section section--alt">
    <div class="container">
      <span class="section-eyebrow">Inside the unit</span>
      <h2>Factory-fitted interiors</h2>
      <p class="table-intro">Tier 2 (Turnkey) and Tier 3 (Furnished Living) units leave the factory with bathroom, kitchen and flooring installed. You connect services on site — no fit-out crew required.</p>
      <div class="interior-grid interior-grid--multi">
        <figure class="interior-figure interior-figure--main">
          <img
            src="/images/modular-homes-interior-fitted.webp"
            alt="Expandable container home interior — kitchen, corner glazing, open-plan living and dining areas fitted out at factory"
            width="800" height="560" loading="lazy"
            onerror="this.closest('figure').style.display='none'"
          />
          <figcaption>Tier 2 fitted interior — living, kitchen and dining areas</figcaption>
        </figure>
        <figure class="interior-figure">
          <img
            src="/images/modular-homes-interior.webp"
            alt="Factory-fitted kitchen in expandable container home — grey units, marble-effect worktop, black-frame window"
            width="560" height="420" loading="lazy"
            onerror="this.closest('figure').style.display='none'"
          />
          <figcaption>Fitted kitchen — units, worktop and sink factory-installed</figcaption>
        </figure>
        <figure class="interior-figure">
          <img
            src="/images/modular-homes-interior-shell.webp"
            alt="Container home shell interior — white kitchen cabinets, light wood-effect floor, fitted ceiling panels and windows"
            width="560" height="420" loading="lazy"
            onerror="this.closest('figure').style.display='none'"
          />
          <figcaption>Shell unit with fitted cabinetry — ready for services connection on site</figcaption>
        </figure>
        <figure class="interior-figure interior-figure--wide">
          <img
            src="/images/modular-homes-interior-40ft.webp"
            alt="40ft expandable container home interior corridor — full depth of unit showing multiple rooms and light wood flooring"
            width="800" height="480" loading="lazy"
            onerror="this.closest('figure').style.display='none'"
          />
          <figcaption>40ft interior depth — full length view showing room partitioning and natural light</figcaption>
        </figure>
        <figure class="interior-figure interior-figure--wide">
          <img
            src="/images/modular-homes-interior-fitted-2.webp"
            alt="Expandable container home interior — additional fitted living space view"
            width="800" height="480" loading="lazy"
            onerror="this.closest('figure').style.display='none'"
          />
          <figcaption>Tier 2 interior — additional living space configuration</figcaption>
        </figure>
      </div>
      <div class="interior-features">
        <div class="int-feature"><strong>Bathroom:</strong> Vanity unit, toilet, shower or bath, mirror cabinet. Washing machine connection included on Tier 3.</div>
        <div class="int-feature"><strong>Kitchen:</strong> Base units, sink, worktop. Appliances specified at order stage.</div>
        <div class="int-feature"><strong>Flooring:</strong> Wood-effect SPC flooring throughout — waterproof, durable, warm underfoot.</div>
        <div class="int-feature"><strong>Partitioning:</strong> Internal walls factory-fitted to your chosen layout. Bedroom and bathroom doors included.</div>
        <div class="int-feature"><strong>Lighting:</strong> Ceiling LED panels in all rooms. Sockets and switches wired to Irish standards on Tier 2+.</div>
        <div class="int-feature"><strong>Ceiling:</strong> Finished ceiling panels throughout — no exposed steel.</div>
      </div>
    </div>
  </section>

  <!-- COMPLIANCE NOTE -->
  <section class="section section--emerald">
    <div class="container--narrow">
      <span class="section-eyebrow section-eyebrow--light">Compliance</span>
      <h2>Every model. Every order. The Ériu Standard.</h2>
      <p>Every unit supplied — regardless of model or tier — ships with CE marking under the Construction Products Regulation, a Declaration of Performance referencing the relevant EN harmonised standards, a written TGD compliance pack covering Parts A to M of the Irish Building Regulations, and an independent pre-shipment QC report signed at the factory floor by Noel Murphy. A BER assessment is conducted by an Irish-registered assessor on completion.</p>
      <a href="/modular-homes/" class="btn btn--white-outline" style="margin-top: 1rem">See the full Ériu Standard →</a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container--narrow">
      <span class="section-eyebrow">Model questions</span>
      <h2>Specification questions, answered</h2>
      <p class="faq-updated">Last reviewed: June 2026</p>
      <div class="faq-list">
        <details class="faq-item">
          <summary>What is an expandable container home?</summary>
          <p>An expandable container home is a steel-frame modular dwelling that ships flat in standard ISO container dimensions, then folds open on site to deliver internal floor area roughly 2.5 to 3 times the folded footprint. The 20ft model folds to 5.9 × 2.2 metres for shipping and expands to approximately 34 square metres of internal living space. The expansion mechanism uses hinged side panels, deployed by crane or a small site team within 1 to 2 days of arrival.</p>
        </details>
        <details class="faq-item">
          <summary>How many expandable container homes fit in a single 40ft HQ container?</summary>
          <p>Loading capacity varies by model: the 20FT700 foldable unit ships 6 sets per 40HQ container (highest shipping efficiency), the 20ft expandable ships 2 sets per 40HQ, and the 30ft and 40ft expandable models each ship 1 set per 40HQ. For multi-unit projects, the 20FT700 model offers dramatically lower per-unit freight cost.</p>
        </details>
        <details class="faq-item">
          <summary>What is the internal ceiling height of an expandable container home?</summary>
          <p>The 20ft and 20FT700 units have an internal clear ceiling height of 2,240 mm (2.24 metres). The 30ft and 40ft units have an internal clear ceiling height of 2,200 mm. All four models exceed the minimum habitable room ceiling height requirements in Irish Building Regulations Technical Guidance Document A.</p>
        </details>
        <details class="faq-item">
          <summary>How long does it take to deploy an expandable container home on site in Ireland?</summary>
          <p>On a prepared foundation, the structural deployment from folded to fully expanded takes 1 to 2 days for the 20ft, 30ft and 40ft models. Services connection (water, electricity, drainage) and internal fit-out are completed in the following 2 to 3 weeks for a Tier 2 Turnkey specification.</p>
        </details>
        <details class="faq-item">
          <summary>Which model is best for a 45 m² Irish back-garden auxiliary dwelling?</summary>
          <p>For the 45 m² maximum under the 2026 Irish Auxiliary Dwelling exemption, the 30ft expandable at ~52 m² internal is the closest fit and sits within the exempted footprint with careful siting. The 20ft at ~34 m² is ideal for a single-bedroom unit. The 40ft at ~70 m² exceeds the exempted area and requires full planning permission as a habitable dwelling.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--emerald">
    <div class="container--narrow" style="text-align: center">
      <span class="section-eyebrow section-eyebrow--light">Ready to specify your project?</span>
      <h2>Tell us your site and your tier. We come back with a fixed quote.</h2>
      <p>Garden dimensions, access constraints, services position, tier preference, timeline. Ten minutes is enough to get a real factory-direct quote on the table.</p>
      <a href="/contact/" class="btn btn--white-outline" style="margin-top: 1rem">Request a quote →</a>
    </div>
  </section>

</BaseLayout>

<style>
  .page-hero { background: var(--color-bg-alt); border-bottom: 1px solid rgba(15,33,49,.08); }
  .page-hero h1 { font-size: clamp(2rem, 4.5vw, 3.5rem); margin: .75rem 0 1.25rem; }
  .lead { font-size: 1.125rem; color: #4a4a4a; line-height: 1.7; max-width: 64ch; margin-bottom: 1.5rem; }

  /* TABLE */
  .table-intro { font-size: .9375rem; color: var(--color-slate); max-width: 70ch; margin: .5rem 0 1.75rem; }
  .models-table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; border: 1px solid rgba(15,33,49,.1); border-radius: 12px; }
  .models-table { width: 100%; border-collapse: collapse; font-size: .9375rem; min-width: 720px; }
  .models-table thead tr { background: #1A533E; color: #fff; }
  .models-table th {
    padding: 1rem 1.25rem; text-align: left;
    font-size: .8125rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: .05em;
    white-space: nowrap;
  }
  .models-table tbody th {
    background: rgba(26,83,62,.05); color: var(--color-navy);
    font-weight: 600; text-transform: none; letter-spacing: 0;
  }
  .models-table td { padding: .875rem 1.25rem; border-bottom: 1px solid rgba(15,33,49,.07); color: var(--color-navy); }
  .models-table tbody tr:last-child td { border-bottom: none; }
  .models-table tbody tr:nth-child(even) td { background: rgba(15,33,49,.02); }
  .best-for-row td.best-for-cell { font-size: .875rem; color: #4a4a4a; line-height: 1.45; }

  /* BUILD QUALITY FEATURES */
  .features-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .feature-card { background: #F7F6F2; border: 1px solid rgba(15,33,49,.08); border-radius: 10px; padding: 1.5rem; }
  .feature-icon { font-size: 1.5rem; margin-bottom: .625rem; }
  .feature-card h3 { font-size: .9375rem; font-weight: 700; color: #0F2131; margin: 0 0 .5rem; }
  .feature-card p { font-size: .875rem; line-height: 1.65; color: #3a4a56; margin: 0; }

  /* MODEL CARDS GRID (links to detail pages) */
  .model-cards-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; margin-top: 2rem; }
  .model-card {
    display: flex; flex-direction: column;
    background: var(--color-white); border: 1px solid rgba(15,33,49,.1); border-radius: 12px;
    overflow: hidden; text-decoration: none; color: inherit;
  }
  .model-card-image { aspect-ratio: 4 / 3; background: var(--color-bg-alt); overflow: hidden; }
  .model-card-image img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .model-card-body { padding: 1.5rem 1.5rem 1.625rem; display: flex; flex-direction: column; gap: .625rem; }
  .model-card-eyebrow { font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--color-teal, #1C7C83); }
  .model-card h3 { font-size: 1.375rem; margin: 0; color: var(--color-navy); }
  .model-card-tagline { font-size: .9375rem; color: var(--color-slate); line-height: 1.6; margin: 0 0 .25rem; }
  .model-card-spec { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .25rem .75rem; font-size: .8125rem; color: #555; }
  .model-card-spec li::after { content: '·'; margin-left: .75rem; color: #bbb; }
  .model-card-spec li:last-child::after { content: ''; }
  .model-card-cta {
    margin-top: .5rem; font-size: .9375rem; font-weight: 600; color: var(--color-emerald);
    border-bottom: 1.5px solid transparent; align-self: flex-start;
    transition: border-color .15s ease;
  }
  .model-card:hover .model-card-cta { border-color: var(--color-emerald); }

  .floorplans-deep-link { margin-top: 2.5rem; text-align: center; }
  .floorplans-deep-link p { font-size: 1rem; color: var(--color-slate); margin: 0; }

  /* FLOORPLANS */
  .floorplans-block { margin-top: 3rem; }
  .floorplans-block h3 { font-size: 1.25rem; margin-bottom: 1.25rem; color: var(--color-navy); }
  .floorplan-figure--full { margin: 0; background: var(--color-white); border: 1px solid rgba(15,33,49,.08); border-radius: 10px; overflow: hidden; }
  .floorplan-figure--full img { width: 100%; height: auto; display: block; }
  .floorplan-figure--full figcaption { padding: .875rem 1.25rem; font-size: .875rem; color: var(--color-slate); text-align: center; border-top: 1px solid rgba(15,33,49,.06); }

  /* INTERIORS */
  .interior-grid { margin-bottom: 2rem; }
  .interior-grid--multi { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .interior-figure--main { grid-column: 1 / -1; }
  .interior-figure--wide { grid-column: 1 / -1; }
  .interior-figure { margin: 0; border-radius: 12px; overflow: hidden; border: 1px solid rgba(15,33,49,.08); }
  .interior-figure img { width: 100%; height: 320px; display: block; object-fit: cover; }
  .interior-figure--main img { height: 420px; }
  .interior-figure--wide img { height: 280px; }
  .interior-figure figcaption { padding: .875rem 1.25rem; font-size: .875rem; color: var(--color-slate); background: var(--color-bg-alt); text-align: center; }
  .interior-features { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .int-feature { font-size: .9rem; line-height: 1.6; color: #3a4a56; background: #F7F6F2; border-radius: 8px; padding: 1rem 1.125rem; }
  .int-feature strong { color: #0F2131; display: block; margin-bottom: .2rem; }

  /* FAQ */
  .faq-updated { font-size: .8125rem; color: #888; margin: .25rem 0 1.5rem; }
  .faq-list { display: flex; flex-direction: column; gap: 0; margin-top: 1rem; }
  .faq-item { border-bottom: 1px solid rgba(15,33,49,.1); padding: 0; }
  .faq-item summary { font-weight: 600; font-size: 1rem; color: var(--color-navy); cursor: pointer; padding: 1.25rem 0; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; font-size: 1.25rem; font-weight: 300; color: var(--color-emerald); flex-shrink: 0; transition: transform .2s ease; }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item p { padding: 0 0 1.25rem; color: #4a4a4a; font-size: .9375rem; margin: 0; line-height: 1.7; }

  @media (max-width: 900px) {
    .model-cards-grid { grid-template-columns: 1fr; }
    .features-grid { grid-template-columns: 1fr 1fr; }
    .interior-features { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 600px) {
    .features-grid, .interior-features { grid-template-columns: 1fr; }
  }
</style>
