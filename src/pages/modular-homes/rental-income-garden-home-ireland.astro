---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import MediaFigure from '../../components/MediaFigure.astro';
import MediaStrip from '../../components/MediaStrip.astro';
import ProofBar from '../../components/ProofBar.astro';

const title = "Rental Income from a Garden Home in Ireland | Ériu";
const description = "Rent out a Class 3A garden home long-term, outside the RTB's remit, on ground you already own. The honest yield and tax maths, and the caveats.";
const canonical = "/modular-homes/rental-income-garden-home-ireland/";
const siteUrl = "https://eriusourcing.com";

// ── PRICING / YIELD ─────────────────────────────────────────────────────
// Installed cost is ALWAYS site-specific, so the yield is modelled per quote
// rather than published as a fixed %: the "we'll model your exact yield" route
// below is canonical, not a placeholder. `allInNum` stays null by design; the
// optional computed branch is retained only if a representative worked example
// is ever agreed. Per policy, the single yield % lives ONLY on this Income page.
const allInNum: number | null = null;
const annualRent = 13800;                 // €1,150/mo long-term let, gross before tax
const allIn = allInNum ? `€${allInNum.toLocaleString('en-IE')}` : null;
const yieldPct = allInNum ? ((annualRent / allInNum) * 100).toFixed(1) : null;
const paybackYrs = allInNum ? Math.round(allInNum / annualRent) : null;
const startPrice = "€25,000";
const irishBuilt = "€110,000–€180,000";
const warrantyClaim = "30-year anti-corrosion warranty"; // ⚠ confirm before merge

// FAQ: single source for both the FAQPage schema and the visible section below.
const faqs = [
  { q: 'Can I earn rental income from a home in my garden in Ireland?', a: 'Yes, from a long-term let. A garden home built under Class 3A of S.I. No. 340 of 2026, in force since 27 July 2026, can be rented out, but not for short-term letting, and it must be occupied with the main house and can\'t be sold separately. Plan on the rent being taxable: Revenue\'s Rent-a-Room guidance states that a self-contained unit not attached to the property cannot qualify for the relief, so the rent is ordinary rental income with allowable expenses deducted. Confirm the tax position with a qualified accountant before relying on any projected return.' },
  { q: 'Is rent from a garden home tax-free under Rent-a-Room?', a: 'Plan on it not being tax-free. Revenue\'s Rent-a-Room guidance states that a self-contained unit which is not attached to the property cannot qualify for the relief, and a Class 3A garden home is detached. Taxed as ordinary rental income, €13,800 a year works out at roughly €7,100 after tax for a higher-rate taxpayer and roughly €9,900 for a standard-rate taxpayer, before allowable expenses. Confirm your own position with an accountant.' },
  { q: 'What yield does a garden rental home produce?', a: 'The gross yield is simply the annual rent divided by your all-in installed cost, so it depends on what you spend. Let at €1,150 a month, a unit earns €13,800 a year before tax. Because the Ériu 20ft Expandable starts from €25,000 delivered and a fully-fitted compliant unit lands at a fraction of the €110,000–€180,000 an Irish-built equivalent costs, the ratio is strong, but the only honest figure is the one calculated against a real quote for your site. We model it for you, gross and after tax at your rate.' },
  { q: 'Do RTB rules and rent-pressure-zone limits apply to a garden rental?', a: 'The RTB has stated that renting a qualifying Class 3A garden home does not come under its remit and does not need to be registered with the RTB. That only applies where the unit meets every Class 3A condition, and short-term letting is not permitted. Confirm your position with your solicitor before letting.' },
  { q: 'Does a rented garden home pay Local Property Tax?', a: 'Yes. Revenue has confirmed that a permanent garden home suitable for use as a separate dwelling attracts its own LPT charge. It is valued in its own right, gets its own property ID, and LPT is payable even when it is empty. Your home insurance must also be updated to declare the structure.' },
];

// NB: BreadcrumbList is emitted by the <Breadcrumbs> component below.
const pageSchemas = [
  {
    "@type": "Product",
    "name": "Ériu 20ft Expandable, Income Garden Home",
    "image": [`${siteUrl}/images/modular-homes-20ft-expandable.webp`, `${siteUrl}/images/modular-homes-hero-back-garden-ireland.webp`],
    "description": "A self-contained 34 m² garden home, specified to Irish Building Regulations with an A2 BER, for a long-term let under the Class 3A exemption, outside the RTB's remit.",
    "brand": { "@type": "Brand", "name": "Ériu Modular Homes" },
    "offers": {
      "@type": "Offer",
      "priceCurrency": "EUR",
      "price": "25000",
      "priceValidUntil": "2026-12-31",
      "availability": "https://schema.org/InStock",
      "description": "Starting price for a basic livable 20ft Expandable delivered to Ireland; fully-fitted and installed cost is project-specific."
    }
  },
  {
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  }
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={pageSchemas}>

  <!-- HERO -->
  <section class="page-hero">
    <div class="container--narrow">
      <Breadcrumbs items={[{ label: 'Modular Homes', href: '/modular-homes/' }, { label: 'Rental Income Garden Home' }]} />
      <span class="section-eyebrow">Long-term let · outside the RTB · on ground you already own</span>
      <h1>Your back garden could be the best-performing asset you own.</h1>
      <p class="lead">There's a quiet shift in Irish property most people haven't done the maths on yet.</p>
      <p>Since 27 July 2026, the Class 3A exemption lets you place a self-contained 32–45 m² home in your rear garden with no planning application, where the conditions are met. Let it long-term and, the RTB has stated, the tenancy sits outside its remit: no RTB registration. Let at €1,150 a month, that's €13,800 a year in rent.</p>
      <p>For a homeowner with a usable garden and some capital, that's not a renovation. It's an income stream parked between the kitchen window and the back fence.</p>
      <div class="hero-cta"><a href="/contact/?interest=modular-quote" class="btn btn--primary">Request your quote + yield breakdown →</a></div>
    </div>
  </section>

  <!-- SHOWCASE -->
  <section class="section media-section">
    <div class="container--narrow">
      <MediaFigure
        src="/images/modular-homes-20ft-expandable.webp"
        alt="The Ériu 20ft Expandable, a self-contained garden home for a long-term let"
        caption="The 20ft Expandable, an income unit on ground you already own."
      />
    </div>
  </section>

  <!-- THE NUMBERS -->
  <section class="section section--alt">
    <div class="container--narrow">
      <span class="section-eyebrow">The numbers, run honestly</span>
      <h2>Let's do it properly, the honest version is more persuasive than the hyped one</h2>
      <p>Let a fully-fitted, compliant Ériu unit to a single tenant or couple at €1,150 a month and that's <strong>€13,800 a year</strong> in gross rent.</p>
      <p>Now the tax, told straight. When the draft rules came out in April, a lot of the coverage, ours included, expected this rent to be tax-free under Rent-a-Room. Revenue's published guidance says a self-contained unit <strong>not attached to the property cannot qualify</strong>, so plan on it being taxed as ordinary rental income, with allowable expenses deducted. Roughly, before expenses:</p>
      <ul class="exempt-list">
        <li><strong>Higher-rate taxpayer:</strong> about €7,100 a year after income tax, USC and PRSI</li>
        <li><strong>Standard-rate taxpayer:</strong> about €9,900 a year after tax</li>
      </ul>

      {allInNum ? (
        <div class="yield-box">
          <p>On an all-in installed cost of <strong>{allIn}</strong>, €13,800 is a gross yield of <strong>~{yieldPct}%</strong> before tax, with a payback of roughly <strong>{paybackYrs} years</strong>, after which it's largely income. <span class="yield-caveat">Figures are illustrative and assume the rent is taxable, in line with Revenue's current Rent-a-Room guidance, and that the unit meets every Class 3A condition. Your net return depends on your marginal rate and allowable expenses. Confirm the tax position with a qualified accountant before relying on any projected return.</span></p>
        </div>
      ) : (
        <div class="yield-box">
          <p>Your gross yield is simply <strong>€13,800 ÷ your all-in installed cost</strong>, and the payback is the inverse, so the figure is only honest once it's run against a real quote for your site. <strong>We model your exact yield and payback for you</strong>, gross and after tax at your rate, with every cost line shown. <span class="yield-caveat">Figures are illustrative and assume the rent is taxable, in line with Revenue's current Rent-a-Room guidance, and that the unit meets every Class 3A condition. Your net return depends on your marginal rate and allowable expenses. Confirm the tax position with a qualified accountant before relying on any projected return.</span></p>
        </div>
      )}
      <p>We'd rather you went in clear-eyed than excited and wrong.</p>
      <div class="hero-cta"><a href="/contact/?interest=modular-quote" class="btn btn--primary">Get my numbers for my site →</a></div>
    </div>
  </section>

  <!-- WHY IT WORKS: ENTRY PRICE -->
  <section class="section">
    <div class="container--narrow">
      <span class="section-eyebrow">Why this works at all</span>
      <h2>The reason the yield is this strong is the entry price</h2>
      <p>The 20ft Expandable starts at <strong>{startPrice} delivered</strong> and reaches a fully-fitted, rentable, BER-A2 home at a fraction of the {irishBuilt} an Irish-built equivalent costs. The yield maths that follows is simply a function of that.</p>
      <p>It's possible because our founder has sourced direct from the Henan factories since 2008 and inspects every unit in person. Factory-direct, not corner-cut: same compliance, same A2 BER, and the same {warrantyClaim}, given by the factory and carried by Ériu, so the cover is held here in Ireland.</p>
      <MediaStrip
        items={[
          { src: '/images/modular-homes-interior.webp', alt: 'Fitted modular home kitchen, the standard a tenant rents' },
          { src: '/images/modular-homes-interior-fitted-2.webp', alt: 'Furnished modular home living and dining space' },
          { src: '/images/modular-homes-hero-back-garden-ireland.webp', alt: 'Self-contained modular rental home sited in an Irish back garden' },
        ]}
        caption="A rentable, A2-BER home, finished to a standard a tenant pays for."
      />
      <a href="/modular-homes/cost/" class="inline-link">See the full cost breakdown →</a>
    </div>
  </section>

  <!-- INVESTOR CAVEATS -->
  <section class="section section--alt">
    <div class="container--narrow">
      <span class="section-eyebrow">Before you sign</span>
      <h2>What a serious investor needs to know, told straight</h2>
      <div class="caveat-grid">
        <div class="caveat-card">
          <h3>Outside the RTB, long-term only</h3>
          <p>The RTB has stated that renting a qualifying Class 3A unit does not come under its remit and needs no RTB registration. That's a genuine operational advantage over a conventional rental. The trade-off: <strong>no short-term letting</strong>, the unit stays with the main house, and it can't be sold separately.</p>
        </div>
        <div class="caveat-card">
          <h3>LPT and insurance</h3>
          <p>Revenue has confirmed the unit attracts its own LPT charge, separate from your house and payable even when empty, and your home insurance must be updated to declare the structure, or you risk invalidating cover on the principal house. Most insurers quote an uplift rather than a separate policy.</p>
        </div>
        <div class="caveat-card">
          <h3>Mortgage and resale</h3>
          <p>Most Irish lenders will not currently mortgage a property with a second self-contained dwelling on the same title, which has resale and portability implications. Many investors fund the unit through other finance specifically to ring-fence the house mortgage.</p>
        </div>
      </div>
      <p class="callout">We provide a written LPT, insurance and mortgage briefing with every quote, and recommend your solicitor reviews it. <a href="/modular-homes/auxiliary-dwelling-ireland/" class="inline-link">Full detail on the financial and legal treatment is here.</a></p>
    </div>
  </section>

  <!-- COMPLIANCE PROTECTS INCOME -->
  <section class="section">
    <div class="container--narrow">
      <span class="section-eyebrow">Compliance protects the income</span>
      <h2>An income stream is only as good as its legality</h2>
      <p>Every Ériu unit is specified to Building Regulations (TGD Parts A–M), supplied BER-ready to A2, and delivered with a full compliance pack and a path through the Commencement Notice and BER assessment. A unit that isn't lawfully occupiable can't be lawfully let, so the compliance is part of the investment case.</p>
      <a href="/modular-homes/building-regulations-ireland/" class="inline-link">See exactly what that involves →</a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--alt">
    <div class="container--narrow">
      <span class="section-eyebrow">Common questions</span>
      <h2>Renting out a garden home, questions answered</h2>
      <p class="faq-updated">Last reviewed: September 2026</p>
      <div class="faq-list">
        {faqs.map(f => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- PROOF -->
  <section class="section media-section">
    <div class="container--narrow">
      <ProofBar />
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--emerald">
    <div class="container--narrow" style="text-align:center">
      <span class="section-eyebrow section-eyebrow--light">Every figure shown honestly</span>
      <h2>Get your site reviewed and your yield modelled.</h2>
      <p>Send us your site, county and target spec. We'll come back with a factory-direct quote, your specific yield breakdown, and the LPT/insurance/finance briefing. Direct reply from Noel within 24 hours.</p>
      <a href="/contact/?interest=modular-quote" class="btn btn--white-outline" style="margin-top:1rem">Request your quote + yield breakdown →</a>
    </div>
  </section>

</BaseLayout>

<style>
  .page-hero { background: var(--color-bg-alt); padding: 4.5rem 0 3rem; border-bottom: 1px solid rgba(15, 33, 49, .08); }
  .page-hero h1 { font-size: clamp(2rem, 4vw, 3.25rem); margin: .75rem 0 1.25rem; line-height: 1.15; }
  .lead { font-size: 1.1875rem; color: var(--color-navy); line-height: 1.7; margin: 0 0 1rem; max-width: 64ch; font-weight: 500; }
  .page-hero p { color: #3a3a3a; line-height: 1.7; margin: 0 0 1rem; max-width: 64ch; }
  .hero-cta { margin-top: 1.5rem; }

  .section h2 { margin-bottom: 1rem; }
  .section h3 { font-size: 1.0625rem; margin: 0 0 .5rem; color: var(--color-navy); }
  .section p { color: #3a3a3a; line-height: 1.75; margin-bottom: 1rem; }
  .section--emerald p { color: rgba(255,255,255, 0.88); }
  .section--emerald h2 { color: #fff; }
  .exempt-list { list-style: disc; padding-left: 1.5rem; margin: 1rem 0; display: flex; flex-direction: column; gap: .4rem; }
  .exempt-list li { font-size: .9375rem; color: #3a3a3a; }
  .inline-link { color: var(--color-emerald); font-weight: 600; font-size: .9375rem; text-decoration: none; }
  .inline-link:hover { text-decoration: underline; }
  .callout { padding: 1.25rem 1.5rem; background: rgba(196,122, 77, .08); border-left: 4px solid #c47a4d; border-radius: 0 8px 8px 0; font-size: .9375rem; color: #4a4a4a; margin-top: 1.5rem; line-height: 1.7; }

  .yield-box { background: rgba(26, 83, 62, .06); border: 1px solid rgba(26, 83, 62, .18); border-radius: 10px; padding: 1.25rem 1.5rem; margin: 1.25rem 0; }
  .yield-box p { margin: 0; color: var(--color-navy); }
  .yield-caveat { display: block; margin-top: .75rem; font-size: .8125rem; color: #5a5a5a; font-style: italic; line-height: 1.6; }

  .caveat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; margin: 1.5rem 0; }
  .caveat-card { padding: 1.5rem; background: var(--color-white); border: 1px solid rgba(15, 33, 49, .08); border-radius: 10px; }
  .caveat-card p { font-size: .9rem; line-height: 1.6; margin: 0; }

  @media (max-width: 900px) { .caveat-grid { grid-template-columns: 1fr; } }

  /* FAQ */
  .faq-updated { font-size: .8125rem; color: #888; margin: .25rem 0 1.5rem; }
  .faq-list { display: flex; flex-direction: column; gap: 0; margin-top: 1rem; }
  .faq-item { border-bottom: 1px solid rgba(15, 33, 49, .1); padding: 0; }
  .faq-item summary { font-weight: 600; font-size: 1rem; color: var(--color-navy); cursor: pointer; padding: 1.25rem 0; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; font-size: 1.25rem; font-weight: 300; color: var(--color-emerald); flex-shrink: 0; transition: transform .2s ease; }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item p { padding: 0 0 1.25rem; color: #4a4a4a; font-size: .9375rem; margin: 0; line-height: 1.75; }
</style>
