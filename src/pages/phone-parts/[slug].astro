---
// Ériu Phones & Parts product pages, data in src/data/parts.js.
import PartsLayout from '../../layouts/PartsLayout.astro';
import GuaranteeSeal from '../../components/parts/GuaranteeSeal.astro';
import WaButton from '../../components/parts/WaButton.astro';
import BatchBoard from '../../components/parts/BatchBoard.astro';
import PhotoCredit from '../../components/parts/PhotoCredit.astro';
import { partsProducts, guarantee } from '../../data/parts.js';
import { partsGuides } from '../../data/partsGuides.js';

export function getStaticPaths() {
  return partsProducts.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const siteUrl = 'https://eriusourcing.com';
const canonical = `/phone-parts/${p.slug}/`;
const related = p.related.map((s) => partsProducts.find((x) => x.slug === s)).filter(Boolean);
const showBoard = p.slug.includes('screens');
const guides = (p.guides ?? []).map((s) => partsGuides.find((g) => g.slug === s)).filter(Boolean);

const pageSchemas = [
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Ériu Sourcing", "item": siteUrl },
      { "@type": "ListItem", "position": 2, "name": "Phones & Parts", "item": `${siteUrl}/phone-parts/` },
      { "@type": "ListItem", "position": 3, "name": p.nav, "item": `${siteUrl}${canonical}` }
    ]
  },
  {
    "@type": "Service",
    "name": p.h1,
    "serviceType": `Wholesale ${p.nav.toLowerCase()} supplier`,
    "description": p.description,
    "provider": { "@type": "ProfessionalService", "@id": `${siteUrl}/#organization` },
    "areaServed": "Worldwide",
    "image": `${siteUrl}${p.image}`
  },
  {
    "@type": "FAQPage",
    "mainEntity": p.faqs.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
  }
];
---

<PartsLayout title={p.title} description={p.description} canonical={canonical} ogImage={p.image} ogImageAlt={p.imageAlt} jsonLd={pageSchemas} waText={p.wa}>

  <section class="pp-hero pp-dark">
    <div class="pp-hero-bg"><img src={p.image} alt="" width="1216" height="832" loading="eager" fetchpriority="high" /></div>
    <div class="container" style="position:relative;z-index:1"><div style="max-width:880px">
      <nav class="pp-crumbs" aria-label="Breadcrumb"><a href="/phone-parts/">Phones &amp; Parts</a> / {p.nav}</nav>
      <span class="pp-eyebrow">{p.eyebrow}</span>
      <h1>{p.h1}</h1>
      <p class="pp-lead">{p.sub}</p>
      <div class="pp-actions">
        <WaButton text={p.wa} label={`WhatsApp for ${p.nav.toLowerCase()} prices`} />
        <a href="/phone-parts/quote/" class="pp-btn pp-btn--line">Get prices →</a>
      </div>
      <p class="pp-micro">{p.group === 'devices' ? 'Bought on the floor in Huaqiangbei · ' : ''}No minimum on your first order · Batch video before you pay the balance · Dead on arrival replaced or credited</p>
    </div></div>
    <PhotoCredit id={p.credit} overlay />
  </section>

  <section class="pp-section">
    <div class="container pp-split">
      <div class="pp-prose fade-up">
        <h2 class="pp-h2">{p.pain.h2}</h2>
        {p.pain.paras.map((t) => <p>{t}</p>)}
      </div>
      <div class="fade-up">
        {showBoard
          ? <BatchBoard />
          : <figure style="margin:0"><img src={p.image} alt={p.imageAlt} width="1216" height="832" loading="lazy" class="pp-img" /><PhotoCredit id={p.credit} /></figure>}
      </div>
    </div>
  </section>

  <section class="pp-section pp-alt">
    <div class="container">
      <span class="pp-eyebrow">What you can order</span>
      <h2 class="pp-h2">Options, honestly described.</h2>
      <table class="pp-table">
        <thead><tr><th>Option</th><th>What it is</th><th>Best for</th></tr></thead>
        <tbody>
          {p.grades.map(([a, b, c]) => (<tr><td>{a}</td><td>{b}</td><td>{c}</td></tr>))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="pp-section">
    <div class="container pp-split pp-split--top">
      <div>
        <span class="pp-eyebrow">Checked before it ships</span>
        <h2 class="pp-h2">{p.group === 'devices' ? 'What we check on every device. You get the record.' : 'What we check, and you get the record.'}</h2>
        <a href="/phone-parts/how-we-test/" class="pp-card-cta">See the full testing protocol →</a>
        {guides.length > 0 && (
          <div class="pp-guides">
            <span class="pp-guides-label">Buyer guides</span>
            {guides.map((g) => <a href={`/phone-parts/guides/${g.slug}/`}>{g.h1}</a>)}
          </div>
        )}
      </div>
      <ul class="pp-checks">
        {p.tests.map((t) => <li>{t}</li>)}
      </ul>
    </div>
  </section>

  {p.extra && (
    <section class="pp-section pp-alt">
      <div class="container pp-prose">
        <h2 class="pp-h2">{p.extra.h2}</h2>
        {p.extra.paras.map((t) => <p>{t}</p>)}
      </div>
    </section>
  )}

  <section class="pp-section pp-dark">
    <div class="container pp-guarantee">
      <GuaranteeSeal />
      <div>
        <span class="pp-eyebrow">{guarantee.name}</span>
        <h2 class="pp-h2">The risk sits with us, not you.</h2>
        <div class="pp-promises">
          <div class="pp-promise"><span class="pp-promise-num">PROMISE 01</span><h3>{guarantee.one.h}</h3><p>{guarantee.one.p}</p></div>
          <div class="pp-promise"><span class="pp-promise-num">PROMISE 02</span><h3>{guarantee.two.h}</h3><p>{guarantee.two.p}</p></div>
        </div>
        <p class="pp-fine">{guarantee.fine}</p>
      </div>
    </div>
  </section>

  <section class="pp-section">
    <div class="container">
      <span class="pp-eyebrow">Questions</span>
      <h2 class="pp-h2">{p.nav}, answered.</h2>
      <div class="pp-faq">
        {p.faqs.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </div>
    </div>
  </section>

  <section class="pp-section pp-alt">
    <div class="container">
      <span class="pp-eyebrow">Ship them together</span>
      <h2 class="pp-h2">Most shops add these to the same order.</h2>
      <div class="pp-cards">
        {related.map((r) => (
          <a href={`/phone-parts/${r.slug}/`} class="pp-card">
            <img src={r.image} alt="" width="1216" height="760" loading="lazy" />
            <div class="pp-card-body"><h3>{r.nav}</h3><p>{r.description}</p><span class="pp-card-cta">See {r.nav.toLowerCase()} →</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="pp-section pp-dark pp-final">
    <div class="container">
      <h2 class="pp-h2">Send your list. Watch your batch get tested. Then decide.</h2>
      <p class="pp-lead">No minimum on your first order, no balance until you have seen your parts pass.</p>
      <div class="pp-actions">
        <WaButton text={p.wa} />
        <a href="/phone-parts/quote/" class="pp-btn pp-btn--light">Get prices →</a>
      </div>
    </div>
  </section>

</PartsLayout>

<style>
  .pp-crumbs { font-size: .8125rem; color: rgba(255,255,255,.55); margin-bottom: 1rem; }
  .pp-crumbs a { color: rgba(255,255,255,.75); }
  .pp-guides { margin-top: 1.75rem; padding: 1rem 1.25rem; border-left: 3px solid var(--color-emerald, #0f8a6a); background: rgba(15,138,106,.06); border-radius: 0 10px 10px 0; display: grid; gap: .5rem; }
  .pp-guides-label { font-size: .75rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #5a5a5a; }
  .pp-guides a { color: var(--color-navy, #0F2131); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
</style>
