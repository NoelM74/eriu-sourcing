---
// Index of Ériu Phones & Parts buyer guides.
import PartsLayout from '../../../layouts/PartsLayout.astro';
import { partsGuides } from '../../../data/partsGuides.js';

const title = "Buyer Guides: Wholesale Phones and Parts | Ériu";
const description = "Plain-English guides for phone shops buying wholesale: used iPhone grades, global vs China version phones, and how to check used iPhones before you pay.";
const canonical = "/phone-parts/guides/";
const siteUrl = 'https://eriusourcing.com';
const pageSchemas = [
  { "@type": "BreadcrumbList", "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Ériu Sourcing", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Phones & Parts", "item": `${siteUrl}/phone-parts/` },
    { "@type": "ListItem", "position": 3, "name": "Buyer Guides", "item": `${siteUrl}${canonical}` } ] },
  { "@type": "ItemList", "itemListElement": partsGuides.map((g, i) => ({ "@type": "ListItem", "position": i + 1, "name": g.h1, "url": `${siteUrl}/phone-parts/guides/${g.slug}/` })) }
];
---

<PartsLayout title={title} description={description} canonical={canonical} ogImage="/images/used-iphones-pile.webp" jsonLd={pageSchemas}>
  <section class="pp-hero pp-dark" style="padding-bottom:3rem">
    <div class="container"><div style="max-width:820px">
      <span class="pp-eyebrow">Buyer guides</span>
      <h1>Know what you're buying <span class="pp-accent">before the money leaves your account.</span></h1>
      <p class="pp-lead">Straight answers for phone shops and repair businesses buying phones and parts from China, written from the market floor in Shenzhen.</p>
    </div></div>
  </section>
  <section class="pp-section pp-alt">
    <div class="container">
      <div class="pp-cards">
        {partsGuides.map((g) => (
          <a href={`/phone-parts/guides/${g.slug}/`} class="pp-card">
            <img src={g.image} alt="" width="1216" height="760" loading="lazy" />
            <div class="pp-card-body"><h3>{g.h1}</h3><p>{g.excerpt}</p><span class="pp-card-cta">Read the guide →</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>
</PartsLayout>
