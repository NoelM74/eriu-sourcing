---
// Ériu Phones & Parts buyer guides, data in src/data/partsGuides.js.
import PartsLayout from '../../../layouts/PartsLayout.astro';
import WaButton from '../../../components/parts/WaButton.astro';
import PhotoCredit from '../../../components/parts/PhotoCredit.astro';
import { partsGuides } from '../../../data/partsGuides.js';

export function getStaticPaths() {
  return partsGuides.map((g) => ({ params: { slug: g.slug }, props: { g } }));
}

const { g } = Astro.props;
const siteUrl = 'https://eriusourcing.com';
const canonical = `/phone-parts/guides/${g.slug}/`;
const others = partsGuides.filter((x) => x.slug !== g.slug);
const date = new Date(g.publishDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const pageSchemas = [
  { "@type": "BreadcrumbList", "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Ériu Sourcing", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Phones & Parts", "item": `${siteUrl}/phone-parts/` },
    { "@type": "ListItem", "position": 3, "name": "Buyer Guides", "item": `${siteUrl}/phone-parts/guides/` },
    { "@type": "ListItem", "position": 4, "name": g.h1, "item": `${siteUrl}${canonical}` } ] },
  {
    "@type": "Article",
    "headline": g.h1,
    "description": g.description,
    "inLanguage": "en",
    "datePublished": g.publishDate,
    "dateModified": g.publishDate,
    "image": `${siteUrl}${g.image}`,
    "author": { "@type": "Person", "name": "Noel Murphy", "url": `${siteUrl}/about/` },
    "publisher": { "@type": "Organization", "@id": `${siteUrl}/#organization` },
    "mainEntityOfPage": `${siteUrl}${canonical}`
  },
  { "@type": "FAQPage", "mainEntity": g.faq.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })) }
];
---

<PartsLayout title={g.title} description={g.description} canonical={canonical} ogImage={g.image} ogImageAlt={g.imageAlt} jsonLd={pageSchemas}>
  <article class="pg-article">
    <div class="container--narrow">
      <nav class="pg-crumbs" aria-label="Breadcrumb"><a href="/phone-parts/">Phones &amp; Parts</a> / <a href="/phone-parts/guides/">Buyer Guides</a></nav>
      <span class="pp-eyebrow" style="color:var(--color-emerald)">{g.eyebrow}</span>
      <h1>{g.h1}</h1>
      <p class="pg-meta">By <a href="/about/">Noel Murphy</a> · {date}</p>
      <figure class="pg-hero"><img src={g.image} alt={g.imageAlt} width="1024" height="700" loading="eager" fetchpriority="high" /><PhotoCredit id={g.credit} /></figure>
      <div class="pg-content" set:html={g.body} />

      <section class="pg-faq">
        <h2>Questions</h2>
        {g.faq.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </section>

      <div class="pg-cta">
        <h2>Want us to do the checking?</h2>
        <p>Our buyer works the Huaqiangbei floors full time and every unit is tested in Shenzhen. You see your batch on video before you pay the balance. No minimum on your first order.</p>
        <div class="pp-actions"><WaButton /><a href="/phone-parts/quote/" class="pp-btn pp-btn--line" style="color:var(--color-navy);border-color:rgba(15,33,49,.3)">Get prices →</a></div>
      </div>

      <section class="pg-more">
        <h2>More buyer guides</h2>
        <ul>{others.map((o) => <li><a href={`/phone-parts/guides/${o.slug}/`}>{o.h1}</a></li>)}</ul>
      </section>
    </div>
  </article>
</PartsLayout>

<style>
  .pg-article { padding: 3rem 0 4.5rem; }
  .pg-crumbs { font-size: .8125rem; color: #6b6b6b; margin-bottom: 1.25rem; }
  .pg-crumbs a { color: inherit; }
  .pg-article h1 { font-size: clamp(1.75rem, 3.6vw, 2.5rem); line-height: 1.15; margin: .5rem 0 1rem; }
  .pg-meta { font-size: .875rem; color: #6b6b6b; margin-bottom: 1.75rem; }
  .pg-meta a { color: inherit; }
  .pg-hero { margin: 0 0 2rem; }
  .pg-hero img { width: 100%; height: auto; border-radius: 12px; display: block; }
  .pg-content { font-size: 1.0625rem; line-height: 1.75; color: #2a2a2a; max-width: 72ch; }
  .pg-content :global(h2) { margin: 2.5rem 0 1rem; font-size: clamp(1.375rem, 2.5vw, 1.75rem); }
  .pg-content :global(p) { margin: 0 0 1.25rem; }
  .pg-content :global(ul) { margin: 0 0 1.25rem; padding-left: 1.5rem; }
  .pg-content :global(li) { margin-bottom: .375rem; }
  .pg-content :global(a) { color: var(--color-emerald); text-decoration: underline; text-underline-offset: 2px; }
  .pg-content :global(.article-summary) { background: var(--color-teal-light); border-left: 4px solid var(--color-emerald); border-radius: 0 10px 10px 0; padding: 1.125rem 1.375rem; margin: 0 0 2rem; font-size: 1rem; line-height: 1.7; color: var(--color-navy); }
  .pg-faq { margin-top: 3rem; }
  .pg-faq details { border-bottom: 1px solid rgba(15, 33, 49, .1); }
  .pg-faq summary { font-weight: 600; cursor: pointer; padding: 1.125rem 0; color: var(--color-navy); }
  .pg-faq p { padding: 0 0 1.125rem; margin: 0; color: #4a4a4a; font-size: .9375rem; line-height: 1.65; }
  .pg-cta { margin-top: 3rem; padding: 2rem; background: var(--color-bg-alt); border-radius: 12px; }
  .pg-cta h2 { font-size: 1.375rem; margin: 0 0 .75rem; }
  .pg-cta p { color: #3a3a3a; margin: 0 0 1.25rem; }
  .pg-more { margin-top: 3rem; }
  .pg-more h2 { font-size: 1.25rem; }
  .pg-more a { color: var(--color-emerald); }
</style>
