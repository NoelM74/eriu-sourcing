---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import StatsRow from '../../components/StatsRow.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import CtaSection from '../../components/CtaSection.astro';
import { sourcingPages } from '../../data/sourcingPages.js';
import { products } from '../../data/products.js';

export async function getStaticPaths() {
  return sourcingPages.map(page => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const siteUrl = 'https://eriusourcing.com';

// Build-time review stamp — surfaces a freshness signal to readers and matches
// the dateModified value emitted in the Service JSON-LD below.
const lastReviewed = new Date().toLocaleDateString('en-IE', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Product guides that live under this category (data/products.js).
// Used to render an internal-linking block on the category hub.
const categoryProducts = products.filter(p => p.categoryFullSlug === page.slug);

const caseStudyMap: Record<string, { anchor: string; label: string }> = {
  'electronics-from-china-ireland': { anchor: 'electronics', label: 'Electronics Retail case study' },
  'construction-materials-from-china-ireland': { anchor: 'construction', label: 'Construction & Materials case study' },
  'hospitality-fitout-from-china-ireland': { anchor: 'hospitality', label: 'Hospitality Fit-Out case study' },
};
const caseStudy = caseStudyMap[page.slug] ?? null;

// BreadcrumbList JSON-LD is emitted by the <Breadcrumbs> component itself.
const pageSchemas = [
  {
    "@type": "Service",
    "name": `${page.eyebrow} — China Direct Sourcing for Ireland`,
    "description": page.description,
    "provider": { "@type": "ProfessionalService", "@id": `${siteUrl}/#organization` },
    "areaServed": [
      { "@type": "Country", "name": "Ireland" },
      { "@type": "Country", "name": "United Kingdom" }
    ],
    "serviceType": "China Sourcing Agent",
    "dateModified": new Date().toISOString().split('T')[0]
  },
  {
    "@type": "FAQPage",
    "mainEntity": page.faq.map(item => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": { "@type": "Answer", "text": item.a }
    }))
  }
];
---

<BaseLayout
  title={page.title}
  description={page.description}
  canonical={`/source/${page.slug}/`}
  ogImage={page.image}
  ogImageAlt={page.imageAlt}
  jsonLd={pageSchemas}
>

  <PageHero
    breadcrumbs={[
      { label: 'What We Source', href: '/source/' },
      { label: page.eyebrow }
    ]}
    eyebrow={page.eyebrow}
    h1={page.h1}
    lead={page.intro}
    ctas={[
      { href: '/contact/', label: 'Get a sourcing quote →', variant: 'primary' },
      { href: '/why-direct/', label: 'Why factory-direct →', variant: 'secondary' }
    ]}
    lastReviewed={new Date().toISOString().split('T')[0]}
  />

  <StatsRow items={[
    { figure: page.savings, label: 'Typical saving vs Irish wholesale' },
    { figure: '18 yrs', label: 'China factory experience' },
    { figure: page.leadTime, label: 'Typical lead time to Ireland' },
    { figure: page.minOrderShort, label: 'Min. order range' }
  ]} />

  <!-- HUB DETAIL -->
  <section class="section section--alt">
    <div class="container">
      <div class="hub-grid">
        <div class="hub-content">
          <span class="section-eyebrow">Manufacturing Hub</span>
          <h2>Where {page.eyebrow.toLowerCase()} is made in China</h2>
          <p class="hub-location">{page.hub}</p>
          <p>{page.hubDetail}</p>
          <a href="/china-network/" class="inline-link">See our full China network →</a>
        </div>
        <div class="hub-image">
          <img
            src={page.image}
            alt={page.imageAlt}
            width="560"
            height="380"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT WE SOURCE -->
  <section class="section">
    <div class="container">
      <div class="products-layout">
        <div class="products-header">
          <span class="section-eyebrow">What we source</span>
          <h2>{page.eyebrow} — products we source directly</h2>
        </div>
        <ul class="products-list">
          {page.keyProducts.map(product => (
            <li>
              <span class="product-check">✓</span>
              <span>{product}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- PRODUCT GUIDES (deep sub-pages for this category) -->
  {categoryProducts.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <span class="section-eyebrow">Product-level sourcing guides</span>
        <h2>Specific products we source in {page.eyebrow.toLowerCase()}</h2>
        <p style="max-width:64ch;color:#3a3a3a;margin-bottom:2rem">
          Deeper, product-specific guides covering manufacturing region, technical specification, EU compliance, and landed-cost context for Ireland.
        </p>
        <ul class="product-guide-grid">
          {categoryProducts.map(p => (
            <li>
              <a href={`/source/${p.categorySlug}/${p.slug}/`} class="product-guide-card lift">
                <span class="product-guide-eyebrow">{p.region.split('(')[0].trim()}</span>
                <h3>{p.h1}</h3>
                <p>{p.description}</p>
                <span class="product-guide-cta">Read the guide →</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- CE COMPLIANCE -->
  <section class="section section--emerald">
    <div class="container--narrow">
      <span class="section-eyebrow section-eyebrow--light">EU & Irish Compliance</span>
      <h2>CE compliance verified at source — not at Dublin Port</h2>
      <p>{page.ceNote}</p>
      <p>Every order includes full compliance documentation. Goods that do not meet Irish and EU standards stay in China at the factory's cost — you do not pay freight on non-compliant products.</p>
      <a href="/contact/" class="btn btn--white-outline" style="margin-top:1rem">Ask about compliance documentation →</a>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section">
    <div class="container">
      <span class="section-eyebrow">How it works</span>
      <h2>From your brief to goods landed in Ireland</h2>
      <div class="process-steps">
        <div class="process-step">
          <span class="step-num">01</span>
          <h3>Send a brief</h3>
          <p>Product name, quantity, quality grade, and target price. A photo or reference product is helpful. No commitment required to get a quote.</p>
        </div>
        <div class="process-step">
          <span class="step-num">02</span>
          <h3>Factory identification</h3>
          <p>We identify and physically visit shortlisted {page.eyebrow.toLowerCase()} factories in {page.hub.split('•')[0].trim()}. Factory-gate pricing negotiated directly.</p>
        </div>
        <div class="process-step">
          <span class="step-num">03</span>
          <h3>Pre-shipment QC</h3>
          <p>Finished goods inspected at the factory before the container is sealed. Compliance documentation verified. Failed goods stay in China.</p>
        </div>
        <div class="process-step">
          <span class="step-num">04</span>
          <h3>Freight to Ireland</h3>
          <p>Sea freight from China to Ireland in {page.leadTime}. Full documentation for Dublin Port customs clearance provided.</p>
        </div>
      </div>
      <div style="margin-top:2rem">
        <a href="/how-it-works/" class="btn btn--secondary">See the full process →</a>
      </div>
    </div>
  </section>

  <!-- EDITORIAL BODY -->
  {page.contentBody && (
    <section class="section">
      <div class="container--narrow editorial-body">
        <span class="section-eyebrow">What buyers need to know</span>
        <h2>Sourcing {page.eyebrow.toLowerCase()} from China — the full picture</h2>
        <div class="editorial-prose" set:html={page.contentBody} />
      </div>
    </section>
  )}

  <!-- CASE STUDY CALLOUT -->
  {caseStudy && (
    <section class="section">
      <div class="container--narrow">
        <div class="case-callout">
          <div class="case-callout-body">
            <span class="section-eyebrow">See it in practice</span>
            <h2>How an Irish business sourced {page.eyebrow.toLowerCase()} direct from China</h2>
            <p>Read the {caseStudy.label} to see the actual savings, lead times, and compliance process on a real order.</p>
          </div>
          <a href={`/case-studies/#${caseStudy.anchor}`} class="btn btn--secondary">Read the case study →</a>
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="section section--alt">
    <div class="container--narrow">
      <span class="section-eyebrow">Common questions</span>
      <h2>{page.eyebrow} — sourcing questions answered</h2>
      <FAQAccordion items={page.faq} />
    </div>
  </section>

  <CtaSection
    eyebrow="Ready to start?"
    h2={`Get factory-direct ${page.eyebrow.toLowerCase()} pricing for your business`}
    body="Send a brief — product, quantity, timeline. We come back with factory-level pricing, a supplier shortlist, and a clear plan. No obligation."
    ctas={[
      { href: '/contact/', label: 'Get a quote →', variant: 'white-outline' }
    ]}
  />

</BaseLayout>

<style>
  /* Page-local styles — hero/stats/FAQ/CTA moved into shared components.
     The remaining styles below own the hub-grid, product list, process
     steps, editorial body, case-callout, and product-guide grid —
     category-page-specific patterns not yet extracted. */

  /* ── HUB ── */
  .hub-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .hub-location {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-teal);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 1rem;
  }

  .hub-image img {
    width: 100%;
    height: 340px;
    object-fit: cover;
    border-radius: 4px;
  }

  .hub-image--dual {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .hub-image--dual img {
    height: 195px;
  }

  .inline-link {
    color: var(--color-emerald);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .inline-link:hover { text-decoration: underline; }

  /* ── PRODUCTS ── */
  .products-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .products-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .products-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: var(--text-base);
    color: var(--color-navy);
    line-height: 1.5;
  }

  .product-check {
    color: var(--color-emerald);
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 0.1em;
  }

  /* ── PROCESS ── */
  .process-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    margin-top: 2.5rem;
  }

  .process-step {
    padding: 2rem 1.5rem 2rem 0;
    border-top: 2px solid var(--color-emerald);
  }

  .step-num {
    display: block;
    font-family: var(--font-body);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-teal);
    opacity: 0.35;
    line-height: 1;
    margin-bottom: 0.75rem;
    letter-spacing: -0.04em;
  }

  .process-step h3 {
    font-size: var(--text-base);
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--color-navy);
  }

  .process-step p {
    font-size: 0.9375rem;
    color: #4a4a4a;
    max-width: 100%;
    margin: 0;
  }

  /* ── CASE STUDY CALLOUT ── */
  .case-callout {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 2rem 2.5rem;
    background: var(--color-white);
    border: 1px solid rgba(15,33,49,0.1);
    border-left: 4px solid var(--color-teal);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .case-callout-body h2 {
    font-size: 1.25rem;
    margin: 0.375rem 0 0.625rem;
  }

  .case-callout-body p {
    font-size: 0.9375rem;
    color: var(--color-slate);
    margin: 0;
    max-width: 52ch;
  }

  @media (max-width: 700px) {
    .case-callout {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /* ── EDITORIAL BODY ── */
  .editorial-body h2 {
    margin-bottom: 1.75rem;
  }

  .editorial-prose {
    color: var(--color-slate);
    line-height: 1.75;
    font-size: var(--text-base);
  }

  .editorial-prose p {
    margin-bottom: 1.25rem;
  }

  .editorial-prose h3 {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-navy);
    margin: 1.75rem 0 0.5rem;
  }

  .editorial-prose strong {
    color: var(--color-navy);
    font-weight: 600;
  }

  .editorial-prose ul {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .editorial-prose li {
    line-height: 1.6;
  }

  .editorial-prose blockquote {
    background: rgba(26,83,62,0.05);
    border-left: 3px solid var(--color-emerald);
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .editorial-prose blockquote p {
    margin: 0;
    color: var(--color-navy);
    font-size: 0.9375rem;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .hub-grid,
    .products-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .hub-image img { height: 260px; }

    .process-steps {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }

    .process-step {
      padding: 1.5rem 0 0;
    }
  }

  @media (max-width: 600px) {
    .process-steps { grid-template-columns: 1fr; }
  }

  /* ── PRODUCT GUIDE GRID ── */
  .product-guide-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .product-guide-card {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1.5rem;
    background: #fff;
    border: 1px solid rgba(15, 33, 49, 0.1);
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    height: 100%;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }

  .product-guide-card:hover {
    border-color: var(--color-emerald, #1A533E);
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(15, 33, 49, 0.08);
  }

  .product-guide-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-teal, #1C7C83);
  }

  .product-guide-card h3 {
    font-size: 1.0625rem;
    line-height: 1.35;
    margin: 0;
    color: #0F2131;
  }

  .product-guide-card p {
    font-size: 0.875rem;
    color: #5a5a5a;
    line-height: 1.55;
    margin: 0;
    flex: 1;
  }

  .product-guide-cta {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-emerald, #1A533E);
    margin-top: 0.25rem;
  }
</style>
