---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Precast Wall-Panel & Floor-Slab Lines from China | Ériu";
const description = "Complete precast wall-panel & floor-slab lines from Zhengzhou for European concrete plants — vetted, QC'd and shipped, without Western OEM price tags.";
const canonical = "/source/precast-wall-panel-floor-slab-lines-from-china/";
const ogImage = "/images/precast-wall-panel-production-line-china.webp";
const ogImageAlt = "Precast wall-panel and floor-slab production line in a Henan factory — casting beds, machinery and reinforcement work";
const siteUrl = 'https://eriusourcing.com';

const pageSchemas = [
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
      { "@type": "ListItem", "position": 2, "name": "What We Source", "item": `${siteUrl}/source/` },
      { "@type": "ListItem", "position": 3, "name": "Precast Wall-Panel & Floor-Slab Lines", "item": `${siteUrl}${canonical}` }
    ]
  },
  {
    "@type": "Service",
    "name": "Precast Wall-Panel & Floor-Slab Production Lines from China — Europe",
    "description": description,
    "provider": { "@type": "ProfessionalService", "@id": `${siteUrl}/#organization` },
    "areaServed": { "@type": "Place", "name": "Europe" },
    "serviceType": "Precast Machinery Sourcing Agent",
    "dateModified": new Date().toISOString().split('T')[0]
  },
  {
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Who are precast wall-panel and floor-slab lines from China for?",
        "acceptedAnswer": { "@type": "Answer", "text": "Existing precast concrete plants adding or modernising wall-panel and floor-slab lines; modular and offsite builders planning an in-house precast facility; and contractors or developers setting up new precast operations. If you plan to produce hollow-core slabs, solid or sandwich wall panels, or structural elements at medium to high volume, a Henan-sourced line can deliver the capacity per euro of capex that Western OEM equipment often cannot." }
      },
      {
        "@type": "Question",
        "name": "What is included in a precast wall-panel and floor-slab production line?",
        "acceptedAnswer": { "@type": "Answer", "text": "A complete or modular line typically includes concrete wall-panel extrusion machines (hollow or solid), hollow-core floor-slab machines for prestressed slabs, optional beam/column and boundary-wall machines, mixing/batching/distribution equipment sized to your targets, and hydraulic installation and handling systems. Equipment is customised to the panel dimensions and reinforcement schemes your local structural codes require." }
      },
      {
        "@type": "Question",
        "name": "How much can a Chinese precast line save versus a Western OEM?",
        "acceptedAnswer": { "@type": "Answer", "text": "Chinese precast-machinery makers specialise in complete, modular, cost-effective lines and are typically well below Western OEM capex for comparable performance, while willing to customise machines and moulds. As a benchmark, complete European block plants are published at roughly US$65,000–US$90,000; precast lines scale from there by configuration. For many European buyers this is the difference between no plant and a viable operation — provided the line is matched to standards and properly supported." }
      },
      {
        "@type": "Question",
        "name": "What output can a Henan wall-panel line deliver?",
        "acceptedAnswer": { "@type": "Answer", "text": "A typical mid-sized wall-panel line handles panel widths of about 600–1,200 mm and thicknesses of 60–200 mm, with multiple shifts producing hundreds of linear metres of wall panel per day depending on machine type, mould count and labour. For context on throughput, semi-automatic block machines output around 3,300–5,800 hollow blocks per day depending on mould size and cycle time, with high-speed lines well above that. Exact figures are set when the line is specified to your products and targets." }
      },
      {
        "@type": "Question",
        "name": "How do you handle CE compliance, installation and support for the line?",
        "acceptedAnswer": { "@type": "Answer", "text": "We work only with equipment makers that provide clear installation, operation and maintenance documentation, compatible electrical and safety standards for your country, and a training and support plan (onsite or remote). CE conformity under the Machinery Directive, the technical file, and electrical/guarding standards are verified before shipment, and a clear testing and acceptance protocol is agreed during the factory visit. You arrange the local civil and MEP team to install and integrate the line." }
      }
    ]
  }
];
---

<BaseLayout title={title} description={description} canonical={canonical} ogImage={ogImage} ogImageAlt={ogImageAlt} jsonLd={pageSchemas}>

  <!-- HERO -->
  <section class="page-hero">
    <div class="hero-bg">
      <img
        src="/images/precast-wall-panel-production-line-china.webp"
        alt="Precast wall-panel and floor-slab production line in a Zhengzhou factory — casting beds, machinery and reinforcement work"
        width="1440"
        height="810"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero-overlay"></div>
    </div>
    <div class="hero-content container">
      <span class="hero-eyebrow">Precast Production Lines — Europe</span>
      <h1>Turn raw concrete into<br />high-value wall &amp; floor systems.</h1>
      <p class="hero-sub">A factory-backed precast wall-panel and floor-slab line from Zhengzhou — sourced from proven Chinese suppliers, with on-the-ground vetting, QC and logistics. Capacity upgrades without Western OEM price tags.</p>
      <div class="hero-actions">
        <a href="/contact/" class="btn btn--white">Get a precast line shortlist →</a>
        <a href="#whatyouget" class="btn btn--white-outline">What you get</a>
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <section class="trust-bar">
    <div class="container">
      <div class="trust-grid">
        <div class="trust-item">
          <span class="trust-num">Complete lines</span>
          <span class="trust-label">Or modular, built to your brief</span>
        </div>
        <div class="trust-divider"></div>
        <div class="trust-item">
          <span class="trust-num">60–200 mm</span>
          <span class="trust-label">Panel thickness · 600–1,200 mm wide</span>
        </div>
        <div class="trust-divider"></div>
        <div class="trust-item">
          <span class="trust-num">25–45%</span>
          <span class="trust-label">Typical capex saving vs Western OEM</span>
        </div>
        <div class="trust-divider"></div>
        <div class="trust-item">
          <span class="trust-num">1–3 makers</span>
          <span class="trust-label">Vetted, compared, your choice</span>
        </div>
      </div>
    </div>
  </section>

  <!-- WHO THIS IS FOR -->
  <section class="section section--alt">
    <div class="container">
      <div class="split-grid">
        <div class="split-content">
          <span class="section-eyebrow">Who this offer is for</span>
          <h2>Built for plants that want capacity per euro of capex</h2>
          <p>If you plan to produce hollow-core slabs, solid wall panels, sandwich wall panels or structural elements at medium to high volume, this is built for you:</p>
          <ul class="tick-list">
            <li>Existing precast concrete plants adding or modernising wall-panel and floor-slab lines.</li>
            <li>Modular and offsite builders planning an in-house precast facility.</li>
            <li>Contractors and developers setting up new precast operations in growth markets.</li>
          </ul>
          <a href="/source/building-materials-production-systems-from-china-ireland/" class="inline-link">See the full building-materials &amp; systems category →</a>
        </div>
        <div class="split-image">
          <img
            src="/images/sandwich-panels-precast-pillar-hero.webp"
            alt="European construction site installing precast wall panels and sandwich panels, with materials staged on site"
            width="640"
            height="480"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT YOU GET -->
  <section class="section" id="whatyouget">
    <div class="container">
      <div class="products-layout">
        <div class="products-header">
          <span class="section-eyebrow">What you get</span>
          <h2>Wall-panel and slab production systems</h2>
          <p>We shortlist specialised Henan manufacturers and put together a complete or modular line — customised to the panel dimensions and reinforcement schemes your local structural codes require.</p>
        </div>
        <ul class="products-list">
          <li><span class="product-check">✓</span><span>Concrete wall-panel extrusion machines for hollow or solid panels</span></li>
          <li><span class="product-check">✓</span><span>Hollow-core floor-slab machines for prestressed slabs</span></li>
          <li><span class="product-check">✓</span><span>T-beam, column and boundary-wall machines as needed</span></li>
          <li><span class="product-check">✓</span><span>Mixing, batching and distribution equipment sized to your targets</span></li>
          <li><span class="product-check">✓</span><span>Hydraulic installation machines and handling systems for transport and erection</span></li>
          <li><span class="product-check">✓</span><span>Moulds, spares and a commissioning, training and support plan</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- CAPACITY -->
  <section class="section section--alt">
    <div class="container--narrow">
      <span class="section-eyebrow">Example capacity &amp; output</span>
      <h2>What a mid-sized Henan wall-panel line can deliver</h2>
      <ul class="tick-list tick-list--lg">
        <li>Panel widths <strong>600–1,200 mm</strong>; thickness <strong>60–200 mm</strong>.</li>
        <li>Multiple shifts producing <strong>hundreds of linear metres</strong> of wall panel per day — exact figures depend on machine type, mould count and labour.</li>
        <li>Integration with hollow-core slab production and column/beam machines for full structural systems.</li>
      </ul>
      <p class="fit-note">For throughput context, semi-automatic block machines output roughly <strong>3,300–5,800 hollow blocks per day</strong> depending on mould size and cycle time; high-speed lines greatly exceed this. The point is simply that output scales predictably once a line is correctly specified to your products and targets.</p>
    </div>
  </section>

  <!-- WHY CHINESE LINES -->
  <section class="section">
    <div class="container">
      <div class="split-grid split-grid--reverse">
        <div class="split-image">
          <img
            src="/images/sandwich-panel-machine-europe-china-comparison.webp"
            alt="Engineer comparing European and Chinese options for wall-panel machinery — documentation and cost analysis side by side"
            width="640"
            height="480"
            loading="lazy"
          />
        </div>
        <div class="split-content">
          <span class="section-eyebrow">Why Chinese precast lines make sense</span>
          <h2>Complete, modular, cost-effective — properly matched</h2>
          <p>Chinese precast-machinery makers specialise in full line solutions, with strong experience exporting to both developing and developed markets, competitive pricing versus Western OEMs, and a willingness to customise machines and moulds for specific local products.</p>
          <p>For European buyers facing high capital costs, that can be the difference between no plant and a viable precast operation — as long as the equipment is matched to your standards and quality expectations, and properly supported over its life. That matching and support is exactly what we manage, independently, on your behalf.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section section--alt">
    <div class="container">
      <span class="section-eyebrow">How Ériu Sourcing manages it</span>
      <h2>Independent sourcing and QC, end to end</h2>
      <div class="process-steps">
        <div class="process-step">
          <span class="step-num">01</span>
          <h3>Requirements analysis</h3>
          <p>Plant location, target products (walls, floors, beams), capacities, local codes, automation level, and budget.</p>
        </div>
        <div class="process-step">
          <span class="step-num">02</span>
          <h3>Supplier matching</h3>
          <p>We shortlist 1–3 credible Zhengzhou/Henan equipment makers and request detailed proposals and offers.</p>
        </div>
        <div class="process-step">
          <span class="step-num">03</span>
          <h3>Technical comparison</h3>
          <p>We help you compare configuration, throughput, automation, after-sales service and pricing on a like-for-like basis.</p>
        </div>
        <div class="process-step">
          <span class="step-num">04</span>
          <h3>Visit &amp; acceptance</h3>
          <p>We conduct onsite visits and agree a clear testing and acceptance protocol before shipment.</p>
        </div>
        <div class="process-step">
          <span class="step-num">05</span>
          <h3>Contract &amp; oversight</h3>
          <p>We support contract signing, payment milestones, and production updates through the build.</p>
        </div>
        <div class="process-step">
          <span class="step-num">06</span>
          <h3>Inspection &amp; logistics</h3>
          <p>Pre-shipment checks, consolidation, documentation, and transport to your port.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- COMPLIANCE -->
  <section class="section section--emerald">
    <div class="container--narrow">
      <span class="section-eyebrow section-eyebrow--light">Compliance, standards &amp; support</span>
      <h2>Equipment that arrives documented and supportable</h2>
      <p>Precast machinery has to be backed by clear installation, operation and maintenance documentation, electrical and safety standards compatible with your country, and a defined training and support plan — onsite or remote. We work only with makers that provide CE conformity under the Machinery Directive, the technical file, and a commitment to supporting European customers over the equipment lifecycle.</p>
      <p>You arrange a strong local civil and MEP team to install and integrate the line; we make sure the factory side — documentation, acceptance testing, and spares — is built to support them.</p>
      <a href="/source/building-materials-production-systems-from-china-ireland/" class="btn btn--white-outline" style="margin-top:1rem">See the full category &amp; compliance picture →</a>
    </div>
  </section>

  <!-- IS THIS RIGHT FOR YOU -->
  <section class="section">
    <div class="container--narrow">
      <span class="section-eyebrow">Is a Chinese precast line right for you?</span>
      <h2>It can be an excellent fit if…</h2>
      <ul class="tick-list tick-list--lg">
        <li>You have or plan a precast plant and need to maximise capacity per euro of capex.</li>
        <li>You can arrange a strong local civil/MEP team to install and integrate the line.</li>
        <li>You value independent China-side representation to de-risk the purchase.</li>
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--alt">
    <div class="container--narrow">
      <span class="section-eyebrow">Common questions</span>
      <h2>Precast line sourcing — questions answered</h2>
      <p class="faq-updated">Last reviewed: June 2026</p>
      <div class="faq-list">
        <details class="faq-item">
          <summary>Who are precast wall-panel and floor-slab lines from China for?</summary>
          <p>Existing precast concrete plants adding or modernising wall-panel and floor-slab lines; modular and offsite builders planning an in-house precast facility; and contractors or developers setting up new precast operations. If you plan to produce hollow-core slabs, solid or sandwich wall panels, or structural elements at medium to high volume, a Henan-sourced line can deliver the capacity per euro of capex that Western OEM equipment often cannot.</p>
        </details>
        <details class="faq-item">
          <summary>What is included in a precast wall-panel and floor-slab production line?</summary>
          <p>A complete or modular line typically includes concrete wall-panel extrusion machines (hollow or solid), hollow-core floor-slab machines for prestressed slabs, optional beam/column and boundary-wall machines, mixing/batching/distribution equipment sized to your targets, and hydraulic installation and handling systems. Equipment is customised to the panel dimensions and reinforcement schemes your local structural codes require.</p>
        </details>
        <details class="faq-item">
          <summary>How much can a Chinese precast line save versus a Western OEM?</summary>
          <p>Chinese precast-machinery makers specialise in complete, modular, cost-effective lines and are typically well below Western OEM capex for comparable performance, while willing to customise machines and moulds. As a benchmark, complete European block plants are published at roughly US$65,000–US$90,000; precast lines scale from there by configuration. For many European buyers this is the difference between no plant and a viable operation — provided the line is matched to standards and properly supported.</p>
        </details>
        <details class="faq-item">
          <summary>What output can a Henan wall-panel line deliver?</summary>
          <p>A typical mid-sized wall-panel line handles panel widths of about 600–1,200 mm and thicknesses of 60–200 mm, with multiple shifts producing hundreds of linear metres of wall panel per day depending on machine type, mould count and labour. For context on throughput, semi-automatic block machines output around 3,300–5,800 hollow blocks per day depending on mould size and cycle time, with high-speed lines well above that. Exact figures are set when the line is specified to your products and targets.</p>
        </details>
        <details class="faq-item">
          <summary>How do you handle CE compliance, installation and support for the line?</summary>
          <p>We work only with equipment makers that provide clear installation, operation and maintenance documentation, compatible electrical and safety standards for your country, and a training and support plan (onsite or remote). CE conformity under the Machinery Directive, the technical file, and electrical/guarding standards are verified before shipment, and a clear testing and acceptance protocol is agreed during the factory visit. You arrange the local civil and MEP team to install and integrate the line.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--emerald">
    <div class="container--narrow" style="text-align:center">
      <span class="section-eyebrow section-eyebrow--light">Ready to scope a line?</span>
      <h2>Get a shortlist of 1–2 realistic precast line options.</h2>
      <p>Share your target products, capacity and location, and we'll build a shortlist from Henan with indicative capex and timeline — no obligation.</p>
      <a href="/contact/" class="btn btn--white-outline" style="margin-top:1rem">Scope my precast line →</a>
    </div>
  </section>

</BaseLayout>

<style>
  /* HERO */
  .page-hero { position: relative; min-height: 70vh; display: flex; align-items: flex-end; overflow: hidden; }
  .hero-bg { position: absolute; inset: 0; }
  .hero-bg img { width: 100%; height: 100%; object-fit: cover; object-position: center 40%; }
  .hero-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(10,28,18,.9) 0%, rgba(10,28,18,.55) 50%, rgba(10,28,18,.2) 100%); }
  .hero-content { position: relative; z-index: 2; padding: 4rem 0 5rem; max-width: 900px; }
  .hero-eyebrow { font-size: .8125rem; font-weight: 700; color: rgba(255,255,255,.65); text-transform: uppercase; letter-spacing: .1em; margin-bottom: 1.25rem; display: block; }
  .hero-content h1 { color: #fff; font-size: clamp(2.25rem, 5vw, 4rem); line-height: 1.05; margin-bottom: 1.5rem; letter-spacing: -.03em; }
  .hero-sub { font-size: clamp(1rem, 1.5vw, 1.1875rem); color: rgba(255,255,255,.82); line-height: 1.7; margin-bottom: 2rem; max-width: 640px; }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }

  /* TRUST BAR */
  .trust-bar { background: #fff; border-bottom: 1px solid rgba(15,33,49,.08); padding: 2.5rem 0; }
  .trust-grid { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
  .trust-item { display: flex; flex-direction: column; gap: .25rem; flex: 1; min-width: 160px; }
  .trust-num { font-family: var(--font-body); font-size: clamp(1.25rem, 2.5vw, 1.875rem); font-weight: 700; color: var(--color-emerald); line-height: 1; letter-spacing: -.03em; }
  .trust-label { font-size: .875rem; color: #5a5a5a; }
  .trust-divider { width: 1px; height: 48px; background: rgba(15,33,49,.12); flex-shrink: 0; }

  /* SPLITS */
  .split-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
  .split-grid--reverse { direction: rtl; }
  .split-grid--reverse > * { direction: ltr; }
  .split-content h2 { margin-bottom: 1.25rem; }
  .split-content p { color: #3a3a3a; margin-bottom: 1rem; }
  .split-image img { width: 100%; height: 420px; object-fit: cover; border-radius: 12px; }
  .inline-link { color: var(--color-emerald); font-weight: 600; font-size: .9375rem; text-decoration: none; }
  .inline-link:hover { text-decoration: underline; }

  /* TICK LISTS */
  .tick-list { list-style: none; margin: 0 0 1.25rem; padding: 0; display: flex; flex-direction: column; gap: .625rem; }
  .tick-list li { position: relative; padding-left: 1.5rem; color: #3a3a3a; line-height: 1.55; }
  .tick-list li::before { content: '✓'; position: absolute; left: 0; color: var(--color-emerald); font-weight: 700; }
  .tick-list--lg li { font-size: 1.0625rem; color: var(--color-navy); }
  .fit-note { color: var(--color-slate); font-size: .9375rem; margin-top: 1rem; }

  /* PRODUCTS LAYOUT */
  .products-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; }
  .products-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .875rem; }
  .products-list li { display: flex; align-items: flex-start; gap: .75rem; font-size: 1rem; color: var(--color-navy); line-height: 1.5; }
  .product-check { color: var(--color-emerald); font-weight: 700; flex-shrink: 0; margin-top: .1em; }
  .products-header p { color: var(--color-slate); margin-top: 1rem; }

  /* PROCESS STEPS */
  .process-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem 2.5rem; margin-top: 2.5rem; }
  .process-step { padding: 1.5rem 1.25rem 0 0; border-top: 2px solid var(--color-emerald); }
  .step-num { display: block; font-family: var(--font-body); font-size: 2.5rem; font-weight: 700; color: var(--color-teal); opacity: .35; line-height: 1; margin-bottom: .75rem; letter-spacing: -.04em; }
  .process-step h3 { font-size: 1rem; font-weight: 700; margin-bottom: .5rem; color: var(--color-navy); }
  .process-step p { font-size: .9375rem; color: #4a4a4a; max-width: 100%; margin: 0; }

  /* FAQ */
  .faq-updated { font-size: .8125rem; color: #888; margin: .25rem 0 1.5rem; }
  .faq-list { display: flex; flex-direction: column; gap: 0; margin-top: 1rem; }
  .faq-item { border-bottom: 1px solid rgba(15,33,49,.1); padding: 0; }
  .faq-item summary { font-weight: 600; font-size: 1rem; color: var(--color-navy); cursor: pointer; padding: 1.25rem 0; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; font-size: 1.25rem; font-weight: 300; color: var(--color-emerald); flex-shrink: 0; transition: transform .2s ease; }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item p { padding: 0 0 1.25rem; color: #4a4a4a; font-size: .9375rem; margin: 0; line-height: 1.65; }

  @media (max-width: 900px) {
    .split-grid, .split-grid--reverse { grid-template-columns: 1fr; gap: 2rem; direction: ltr; }
    .split-image img { height: 280px; }
    .products-layout { grid-template-columns: 1fr; gap: 2rem; }
    .process-steps { grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .process-step { padding: 1.25rem 0 0; }
    .trust-divider { display: none; }
  }
  @media (max-width: 600px) {
    .process-steps { grid-template-columns: 1fr; }
    .hero-actions { flex-direction: column; }
    .trust-grid { gap: 1rem; }
  }
</style>
