---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "EV Charger Sourcing for Installers — Ireland & UK | Ériu";
const description = "Factory-direct EV charger sourcing for Irish & UK installers and CPOs — AC wallboxes and DC fast chargers, CE/IEC-verified, with QC through Zhengzhou.";
const canonical = "/source/ev-charger-sourcing-installers-ireland-uk/";
const ogImage = "/images/ev-charger-production-line-china-ac-dc-hardware.webp";
const ogImageAlt = "EV charger production line in China — AC wallboxes and DC fast chargers for Irish and UK installers";
const siteUrl = 'https://eriusourcing.com';

const pageSchemas = [
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
      { "@type": "ListItem", "position": 2, "name": "What We Source", "item": `${siteUrl}/source/` },
      { "@type": "ListItem", "position": 3, "name": "EV Charger Sourcing for Installers", "item": `${siteUrl}${canonical}` }
    ]
  },
  {
    "@type": "Service",
    "name": "AC & DC EV Charger Sourcing for Installers — Ireland & UK",
    "description": description,
    "provider": { "@type": "ProfessionalService", "@id": `${siteUrl}/#organization` },
    "areaServed": [
      { "@type": "Country", "name": "Ireland" },
      { "@type": "Country", "name": "United Kingdom" }
    ],
    "serviceType": "EV Charger Sourcing Agent",
    "dateModified": new Date().toISOString().split('T')[0]
  },
  {
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How much can Irish and UK installers save sourcing EV chargers direct from China?",
        "acceptedAnswer": { "@type": "Answer", "text": "Industry estimates put the hardware saving at 30–50% versus well-known Western brands, driven by manufacturing scale and integrated R&D. A premium-brand 7.4 kW wallbox bought through a local distributor at around €1,149 ex VAT can be matched on quality factory-direct and land at roughly €749 ex VAT once hardware, freight, duty, and our fee are included — about €400 saved per unit (~35%) before volume discounts. On a DC site, swapping a €25,000 unit for a quality €15,000–€18,000 equivalent frees several thousand euros per install." }
      },
      {
        "@type": "Question",
        "name": "What EV charging hardware do you help installers source?",
        "acceptedAnswer": { "@type": "Answer", "text": "AC: 7.4 kW single-phase wallboxes for domestic installs, and 11–22 kW three-phase wallboxes and pedestals for workplaces, car parks, and multi-unit developments, with OCPP, app control, RFID, load balancing, and solar integration where available. DC: 20–40 kW compact units for smaller commercial sites and fleet depots, and 60–120 kW units for busier and corridor sites. We also source charging cables, Type 2 / CCS2 connector sets, pedestals, and protective enclosures as part of complete site kits." }
      },
      {
        "@type": "Question",
        "name": "Are the chargers CE and IEC-compliant for the Irish and UK market?",
        "acceptedAnswer": { "@type": "Answer", "text": "We source only from factories that can provide CE marking, RoHS, and the relevant IEC test reports (IEC 61851 for the charging system, IEC 62196 for Type 2 / CCS2 connectors), with TÜV or UL documentation where available, plus EU Declarations of Conformity and test reports suitable for local authorities and insurers. Compliance is verified at the factory before shipment. The installer remains responsible for local electrical regulations, safety checks, and any grant-scheme rules — we make the hardware base defensible." }
      },
      {
        "@type": "Question",
        "name": "What warranty and after-sales support comes with Chinese EV chargers?",
        "acceptedAnswer": { "@type": "Answer", "text": "We agree warranty terms (typically 2–5 years on hardware) and confirm spare-part stocks before committing to a supplier. A defined technical-support pathway — remote diagnostics and firmware updates via the manufacturer or your software partner — is established as part of the framework agreement, so your network stays supportable after deployment." }
      },
      {
        "@type": "Question",
        "name": "What order volume makes EV charger sourcing from China worthwhile?",
        "acceptedAnswer": { "@type": "Answer", "text": "The service fits best if you install roughly 50+ chargers per year, are planning larger commercial or depot projects with DC elements, or want to own your hardware roadmap rather than be a box-mover. First orders can be a small test batch (5–20 units) to prove the units, QC, and support before you commit to rolling orders and framework terms." }
      }
    ]
  }
];
---

<BaseLayout title={title} description={description} canonical={canonical} ogImage={ogImage} ogImageAlt={ogImageAlt} jsonLd={pageSchemas}>

  <!-- HERO -->
  <section class="page-hero">
    <div class="hero-bg">
      <img
        src="/images/ev-charger-production-line-china-ac-dc-hardware.webp"
        alt="EV charger production line in China — DC fast chargers and AC wallboxes assembled and inspected for export to Ireland and the UK"
        width="1440"
        height="810"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero-overlay"></div>
    </div>
    <div class="hero-content container">
      <span class="hero-eyebrow">EV Charger Sourcing — Ireland & UK Installers</span>
      <h1>You handle the installs.<br />We handle China.</h1>
      <p class="hero-sub">Direct access to export-grade Chinese AC &amp; DC charging hardware, curated for European standards, with on-the-ground QC and logistics through Zhengzhou. Recover 30–50% on hardware cost and own your charger roadmap.</p>
      <div class="hero-actions">
        <a href="/contact/" class="btn btn--white">Request the Installer Intro Pack →</a>
        <a href="#hardware" class="btn btn--white-outline">See hardware types</a>
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <section class="trust-bar">
    <div class="container">
      <div class="trust-grid">
        <div class="trust-item">
          <span class="trust-num">30–50%</span>
          <span class="trust-label">Hardware saving vs Western brands</span>
        </div>
        <div class="trust-divider"></div>
        <div class="trust-item">
          <span class="trust-num">AC + DC</span>
          <span class="trust-label">7.4–22 kW wallboxes to 120 kW+ DC</span>
        </div>
        <div class="trust-divider"></div>
        <div class="trust-item">
          <span class="trust-num">CE · IEC</span>
          <span class="trust-label">61851 / 62196 verified before shipment</span>
        </div>
        <div class="trust-divider"></div>
        <div class="trust-item">
          <span class="trust-num">5–20 units</span>
          <span class="trust-label">Typical first test batch</span>
        </div>
      </div>
    </div>
  </section>

  <!-- WHO THIS IS FOR -->
  <section class="section section--alt">
    <div class="container">
      <div class="split-grid">
        <div class="split-content">
          <span class="section-eyebrow">Who this is for</span>
          <h2>Built for installers who want margin and control</h2>
          <p>If you are currently buying chargers through wholesalers or brand importers, this service is for you. We work with:</p>
          <ul class="tick-list">
            <li>Electrical contractors and EV charger installers looking to improve margins and control over hardware.</li>
            <li>Small to mid-size charge-point operators building local networks or white-label solutions.</li>
            <li>PV and heat-pump installers adding EV chargers as a bundled offering.</li>
          </ul>
          <a href="/source/ev-chargers-from-china-ireland/" class="inline-link">See the full EV charger category →</a>
        </div>
        <div class="split-image">
          <img
            src="/images/ev-charger-pre-shipment-qc-inspection-china.webp"
            alt="Pre-shipment QC inspection of an AC wallbox EV charger in China before export to Ireland and the UK"
            width="640"
            height="480"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- HARDWARE TYPES -->
  <section class="section" id="hardware">
    <div class="container">
      <span class="section-eyebrow">Hardware types</span>
      <h2>The combinations that make commercial sense in Ireland &amp; the UK</h2>
      <p class="cat-intro">We focus on the AC and DC hardware that earns its place on a typical Irish or UK install schedule — domestic, workplace, commercial, and fleet — with the smart features networks expect.</p>
      <div class="cat-grid cat-grid--2">
        <div class="cat-card cat-card--static">
          <h3>AC charging</h3>
          <p><strong>7.4 kW single-phase wallboxes</strong> — ideal for domestic installs. <strong>11–22 kW three-phase</strong> wallboxes and pedestals for workplaces, car parks, and multi-unit developments. Smart features: OCPP, app control, RFID, load balancing, and solar integration where available.</p>
        </div>
        <div class="cat-card cat-card--static">
          <h3>DC fast charging</h3>
          <p><strong>20–40 kW compact DC</strong> for smaller commercial sites and fleet depots — European retail examples advertise these from around €6,000–€13,000 per station for basic configurations. <strong>60–120 kW DC</strong> for busier and corridor sites, where European pricing typically starts above €20,000 per unit for quality equipment.</p>
        </div>
      </div>
      <p class="cat-note">We can also help with charging cables, Type 2 / CCS2 connector sets, pedestals, and protective enclosures as part of complete site kits.</p>
    </div>
  </section>

  <!-- INSTALLER ECONOMICS -->
  <section class="section section--alt">
    <div class="container">
      <div class="split-grid split-grid--reverse">
        <div class="split-image">
          <img
            src="/images/ev-charger-installer-cost-comparison.webp"
            alt="Factory-direct versus local-distributor EV charger pricing — an installer fitting a wallbox at an Irish home"
            width="640"
            height="480"
            loading="lazy"
          />
        </div>
        <div class="split-content">
          <span class="section-eyebrow">Example installer economics</span>
          <h2>Where the margin actually comes from</h2>
          <p>Take a premium-brand 7.4 kW wallbox you would normally buy through a local distributor at around <strong>€1,149 ex VAT</strong>.</p>
          <p>The same-quality, certified unit sourced factory-direct through us lands at roughly <strong>€749 ex VAT</strong> — hardware, freight, duty, and your share of our fee all included.</p>
          <p>That is about <strong>€400 saved per unit (~35%)</strong> — margin you keep, or pass on to win the job. Across a year of installs it compounds, and on a DC site the numbers are starker: swapping a €25,000 unit for a quality €15,000–€18,000 equivalent frees several thousand euros per install.</p>
          <a href="/why-direct/" class="inline-link">See the full cost argument →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY SUPERVISED -->
  <section class="section">
    <div class="container">
      <div class="products-layout">
        <div class="products-header">
          <span class="section-eyebrow">Why go direct with a supervised partner</span>
          <h2>Direct-to-China saves 30–50% — going direct unsupervised is where it goes wrong</h2>
          <p>Without oversight, the risks are real: factories without proper certification, missed spec points (connector standards, metering requirements), shipping delays, quality inconsistency, and weak after-sales support. Ériu Sourcing removes those risks:</p>
        </div>
        <ul class="products-list">
          <li><span class="product-check">✓</span><span>Operating from Zhengzhou's NEV industrial parks, embedded among EV-parts and battery suppliers</span></li>
          <li><span class="product-check">✓</span><span>In-person supplier vetting, factory visits, and pre-shipment inspections as standard</span></li>
          <li><span class="product-check">✓</span><span>CE / RoHS and IEC 61851 / 62196 documentation verified at the factory</span></li>
          <li><span class="product-check">✓</span><span>OCPP version and back-end compatibility confirmed against your software partner</span></li>
          <li><span class="product-check">✓</span><span>Warranty terms (typically 2–5 years) and spare-part stocks agreed up front</span></li>
          <li><span class="product-check">✓</span><span>Logistics coordinated via rail/sea routes optimised for Europe</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section section--alt">
    <div class="container">
      <span class="section-eyebrow">How the service works</span>
      <h2>From scoping call to rolling orders</h2>
      <div class="process-steps">
        <div class="process-step">
          <span class="step-num">01</span>
          <h3>Initial scoping call</h3>
          <p>We clarify your install mix (domestic vs commercial, AC vs DC), annual volume, and software/backend preferences.</p>
        </div>
        <div class="process-step">
          <span class="step-num">02</span>
          <h3>Curated shortlist</h3>
          <p>2–3 vetted factory options and product families matched to your needs — data sheets, certifications, and indicative pricing.</p>
        </div>
        <div class="process-step">
          <span class="step-num">03</span>
          <h3>Sample &amp; field test</h3>
          <p>You order and install a test batch (5–20 units). We oversee production and QC in China.</p>
        </div>
        <div class="process-step">
          <span class="step-num">04</span>
          <h3>Framework &amp; branding</h3>
          <p>Once units and support are proven, we agree standard terms and branding options with the manufacturer.</p>
        </div>
        <div class="process-step">
          <span class="step-num">05</span>
          <h3>Rolling orders</h3>
          <p>You forecast demand; we group orders, manage production slots, run inspections, and ship to Ireland/UK on established routes.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- COMPLIANCE -->
  <section class="section section--emerald">
    <div class="container--narrow">
      <span class="section-eyebrow section-eyebrow--light">Compliance, warranties &amp; support</span>
      <h2>A hardware base your authorities and insurers will accept</h2>
      <p>We make sure factories provide CE, RoHS, and the relevant IEC documentation (IEC 61851 / 62196) plus test reports suitable for local authorities and insurers; that warranty terms and spare-part stocks are clear; and that there is a defined technical-support pathway — remote diagnostics and firmware updates — via the manufacturer or your software partner.</p>
      <p>You remain responsible for complying with local electrical regulations, safety checks, and any grant-scheme rules — but we ensure the hardware base is defensible.</p>
      <a href="/source/ev-chargers-from-china-ireland/" class="btn btn--white-outline" style="margin-top:1rem">Read the full compliance picture →</a>
    </div>
  </section>

  <!-- IS THIS RIGHT FOR YOU -->
  <section class="section">
    <div class="container--narrow">
      <span class="section-eyebrow">Is this right for you?</span>
      <h2>This service is a good fit if…</h2>
      <ul class="tick-list tick-list--lg">
        <li>You install 50+ chargers per year and want better economics and control.</li>
        <li>You are planning larger commercial or depot projects with DC elements.</li>
        <li>You want to avoid becoming a "box mover" and instead own your hardware roadmap.</li>
      </ul>
      <p class="fit-note">If you are below those volumes, a standard EU distributor may still make more sense — and we will tell you that on the first call rather than waste your time.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--alt">
    <div class="container--narrow">
      <span class="section-eyebrow">Common questions</span>
      <h2>EV charger sourcing for installers — questions answered</h2>
      <p class="faq-updated">Last reviewed: June 2026</p>
      <div class="faq-list">
        <details class="faq-item">
          <summary>How much can Irish and UK installers save sourcing EV chargers direct from China?</summary>
          <p>Industry estimates put the hardware saving at 30–50% versus well-known Western brands, driven by manufacturing scale and integrated R&amp;D. A premium-brand 7.4 kW wallbox bought through a local distributor at around €1,149 ex VAT can be matched on quality factory-direct and land at roughly €749 ex VAT once hardware, freight, duty, and our fee are included — about €400 saved per unit (~35%) before volume discounts. On a DC site, swapping a €25,000 unit for a quality €15,000–€18,000 equivalent frees several thousand euros per install.</p>
        </details>
        <details class="faq-item">
          <summary>What EV charging hardware do you help installers source?</summary>
          <p>AC: 7.4 kW single-phase wallboxes for domestic installs, and 11–22 kW three-phase wallboxes and pedestals for workplaces, car parks, and multi-unit developments, with OCPP, app control, RFID, load balancing, and solar integration where available. DC: 20–40 kW compact units for smaller commercial sites and fleet depots, and 60–120 kW units for busier and corridor sites. We also source charging cables, Type 2 / CCS2 connector sets, pedestals, and protective enclosures as part of complete site kits.</p>
        </details>
        <details class="faq-item">
          <summary>Are the chargers CE and IEC-compliant for the Irish and UK market?</summary>
          <p>We source only from factories that can provide CE marking, RoHS, and the relevant IEC test reports (IEC 61851 for the charging system, IEC 62196 for Type 2 / CCS2 connectors), with TÜV or UL documentation where available, plus EU Declarations of Conformity and test reports suitable for local authorities and insurers. Compliance is verified at the factory before shipment. The installer remains responsible for local electrical regulations, safety checks, and any grant-scheme rules — we make the hardware base defensible.</p>
        </details>
        <details class="faq-item">
          <summary>What warranty and after-sales support comes with Chinese EV chargers?</summary>
          <p>We agree warranty terms (typically 2–5 years on hardware) and confirm spare-part stocks before committing to a supplier. A defined technical-support pathway — remote diagnostics and firmware updates via the manufacturer or your software partner — is established as part of the framework agreement, so your network stays supportable after deployment.</p>
        </details>
        <details class="faq-item">
          <summary>What order volume makes EV charger sourcing from China worthwhile?</summary>
          <p>The service fits best if you install roughly 50+ chargers per year, are planning larger commercial or depot projects with DC elements, or want to own your hardware roadmap rather than be a box-mover. First orders can be a small test batch (5–20 units) to prove the units, QC, and support before you commit to rolling orders and framework terms.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--emerald">
    <div class="container--narrow" style="text-align:center">
      <span class="section-eyebrow section-eyebrow--light">Ready to map it out?</span>
      <h2>Request the EV Installer Sourcing Intro Pack.</h2>
      <p>Sample product lists, spec sheets, and outline pricing bands for Ireland &amp; the UK. Tell us your typical install mix and annual volume — no obligation, no sales pitch.</p>
      <a href="/contact/" class="btn btn--white-outline" style="margin-top:1rem">Request the Intro Pack →</a>
    </div>
  </section>

</BaseLayout>

<style>
  /* HERO */
  .page-hero {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .hero-bg { position: absolute; inset: 0; }
  .hero-bg img { width: 100%; height: 100%; object-fit: cover; object-position: center 40%; }
  .hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(10,28,18,.9) 0%, rgba(10,28,18,.55) 50%, rgba(10,28,18,.2) 100%);
  }
  .hero-content { position: relative; z-index: 2; padding: 4rem 0 5rem; max-width: 900px; }
  .hero-eyebrow {
    font-size: .8125rem; font-weight: 700; color: rgba(255,255,255,.65);
    text-transform: uppercase; letter-spacing: .1em; margin-bottom: 1.25rem; display: block;
  }
  .hero-content h1 {
    color: #fff; font-size: clamp(2.25rem, 5vw, 4rem); line-height: 1.05;
    margin-bottom: 1.5rem; letter-spacing: -.03em;
  }
  .hero-sub {
    font-size: clamp(1rem, 1.5vw, 1.1875rem); color: rgba(255,255,255,.82);
    line-height: 1.7; margin-bottom: 2rem; max-width: 640px;
  }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }

  /* TRUST BAR */
  .trust-bar { background: #fff; border-bottom: 1px solid rgba(15,33,49,.08); padding: 2.5rem 0; }
  .trust-grid { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
  .trust-item { display: flex; flex-direction: column; gap: .25rem; flex: 1; min-width: 160px; }
  .trust-num {
    font-family: var(--font-body); font-size: clamp(1.25rem, 2.5vw, 1.875rem);
    font-weight: 700; color: var(--color-emerald); line-height: 1; letter-spacing: -.03em;
  }
  .trust-label { font-size: .875rem; color: #5a5a5a; }
  .trust-divider { width: 1px; height: 48px; background: rgba(15,33,49,.12); flex-shrink: 0; }

  /* SPLITS */
  .split-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
  .split-grid--reverse { direction: rtl; }
  .split-grid--reverse > * { direction: ltr; }
  .split-content h2 { margin-bottom: 1.25rem; }
  .split-content p { color: #3a3a3a; margin-bottom: 1rem; }
  .split-image img { width: 100%; height: 420px; object-fit: cover; border-radius: 12px; }
  .inline-link { color: var(--color-emerald); font-weight: 600; font-size: .9375rem; text-decoration: none; }
  .inline-link:hover { text-decoration: underline; }

  /* TICK LISTS */
  .tick-list { list-style: none; margin: 0 0 1.25rem; padding: 0; display: flex; flex-direction: column; gap: .625rem; }
  .tick-list li { position: relative; padding-left: 1.5rem; color: #3a3a3a; line-height: 1.55; }
  .tick-list li::before { content: '✓'; position: absolute; left: 0; color: var(--color-emerald); font-weight: 700; }
  .tick-list--lg li { font-size: 1.0625rem; color: var(--color-navy); }
  .fit-note { color: var(--color-slate); font-size: .9375rem; margin-top: 1rem; }

  /* HARDWARE CARDS */
  .cat-intro { color: var(--color-slate); max-width: 70ch; margin: 1rem 0 2rem; }
  .cat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .cat-grid--2 { grid-template-columns: 1fr 1fr; }
  .cat-card {
    display: block; padding: 1.5rem; background: var(--color-white);
    border: 1px solid rgba(15,33,49,.09); border-radius: 12px;
    text-decoration: none; color: inherit;
  }
  .cat-card--static h3 { font-size: 1.0625rem; color: var(--color-navy); margin: 0 0 .625rem; }
  .cat-card--static p { font-size: .9375rem; color: #3a3a3a; margin: 0; line-height: 1.6; }
  .cat-note { color: var(--color-slate); font-size: .9375rem; margin-top: 1.5rem; max-width: 70ch; }

  /* PRODUCTS LAYOUT */
  .products-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; }
  .products-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .875rem; }
  .products-list li { display: flex; align-items: flex-start; gap: .75rem; font-size: 1rem; color: var(--color-navy); line-height: 1.5; }
  .product-check { color: var(--color-emerald); font-weight: 700; flex-shrink: 0; margin-top: .1em; }
  .products-header p { color: var(--color-slate); margin-top: 1rem; }

  /* PROCESS STEPS */
  .process-steps { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0; margin-top: 2.5rem; }
  .process-step { padding: 2rem 1.25rem 2rem 0; border-top: 2px solid var(--color-emerald); }
  .step-num {
    display: block; font-family: var(--font-body); font-size: 2.5rem; font-weight: 700;
    color: var(--color-teal); opacity: .35; line-height: 1; margin-bottom: .75rem; letter-spacing: -.04em;
  }
  .process-step h3 { font-size: 1rem; font-weight: 700; margin-bottom: .5rem; color: var(--color-navy); }
  .process-step p { font-size: .9375rem; color: #4a4a4a; max-width: 100%; margin: 0; }

  /* FAQ */
  .faq-updated { font-size: .8125rem; color: #888; margin: .25rem 0 1.5rem; }
  .faq-list { display: flex; flex-direction: column; gap: 0; margin-top: 1rem; }
  .faq-item { border-bottom: 1px solid rgba(15,33,49,.1); padding: 0; }
  .faq-item summary {
    font-weight: 600; font-size: 1rem; color: var(--color-navy); cursor: pointer;
    padding: 1.25rem 0; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 1rem;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after {
    content: '+'; font-size: 1.25rem; font-weight: 300; color: var(--color-emerald);
    flex-shrink: 0; transition: transform .2s ease;
  }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item p { padding: 0 0 1.25rem; color: #4a4a4a; font-size: .9375rem; margin: 0; line-height: 1.65; }

  @media (max-width: 900px) {
    .split-grid, .split-grid--reverse { grid-template-columns: 1fr; gap: 2rem; direction: ltr; }
    .split-image img { height: 280px; }
