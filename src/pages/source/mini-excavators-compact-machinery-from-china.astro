---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Mini Excavator & Compact Machinery Sourcing | Ériu";
const description = "Source Stage V mini excavators, compact loaders and site machinery from China for European contractors and fleets — CE, hydraulics QC, logistics handled.";
const canonical = "/source/mini-excavators-compact-machinery-from-china/";
const ogImage = "/images/china-mini-excavator-compact-machinery.webp";
const ogImageAlt = "Compact Chinese mini excavator working on a construction site, tracked machine with operator";
const siteUrl = 'https://eriusourcing.com';

const pageSchemas = [
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
      { "@type": "ListItem", "position": 2, "name": "What We Source", "item": `${siteUrl}/source/` },
      { "@type": "ListItem", "position": 3, "name": "Mini Excavators & Compact Machinery", "item": `${siteUrl}${canonical}` }
    ]
  },
  {
    "@type": "Service",
    "name": "Mini Excavator & Compact Machinery Sourcing from China — Europe",
    "description": description,
    "provider": { "@type": "ProfessionalService", "@id": `${siteUrl}/#organization` },
    "areaServed": { "@type": "Place", "name": "Europe" },
    "serviceType": "Construction Machinery Sourcing Agent",
    "dateModified": new Date().toISOString().split('T')[0]
  },
  {
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Who is this compact machinery sourcing service for?",
        "acceptedAnswer": { "@type": "Answer", "text": "Civil and utility contractors running mini excavators day in, day out; rental companies expanding 1–8 tonne excavator and compact-loader fleets; and landscapers and small contractors who need versatile, affordable machines with strong ROI. If you are responsible for fleet purchasing or rental capex and are open to carefully vetted Chinese OEMs under controlled conditions, this is built for you." }
      },
      {
        "@type": "Question",
        "name": "What machines do you focus on?",
        "acceptedAnswer": { "@type": "Answer", "text": "Compact and mid excavators — 1–3 tonne micro/mini for tight access and landscaping, 3–8 tonne compact for civil and utility work, and up to ~20 tonne mid machines for broader earthworks where appropriate. Plus compact wheel loaders and skid steers, site dumpers, plate compactors and small rollers, and mobile concrete mixers and small batching plants. We focus on categories where Chinese OEM volume is high, export experience is established, and Stage V engine and CE solutions exist." }
      },
      {
        "@type": "Question",
        "name": "How much can I save versus a Western-OEM machine?",
        "acceptedAnswer": { "@type": "Answer", "text": "As a directional example in the 3–5 tonne class, a Western-OEM machine might land and be prepped at €65,000–€80,000, while a vetted Chinese machine with a Stage V engine and CE documentation might land in the €40,000–€55,000 band including freight and duties — roughly a 20–40% capex gap, depending on spec and volume. We help you weigh that against parts, support and residual value with realistic assumptions, not wishful thinking, and compare on total cost of ownership." }
      },
      {
        "@type": "Question",
        "name": "Will the machines be Stage V and CE compliant?",
        "acceptedAnswer": { "@type": "Answer", "text": "That is the starting point of every project. We confirm the applicable Stage V power band and ensure engines are type-approved under Regulation (EU) 2016/1628 with documentation, and we ensure the OEM can provide a risk assessment, conformity with harmonised standards, a technical file, EC Declaration of Conformity and visible CE marking under the Machinery Directive 2006/42/EC. We avoid grey machines designed only for other jurisdictions that lack Stage V and CE-ready designs." }
      },
      {
        "@type": "Question",
        "name": "How do you protect against poor hydraulics and welds?",
        "acceptedAnswer": { "@type": "Answer", "text": "We have a qualified engineer review hydraulic schematics and component specs — pumps, valves, cylinders, hoses and seals — and inspect weld penetration, steel grades and reinforcement at the boom, arm and undercarriage. We favour OEMs with documented QA and recognised hydraulic suppliers, and we run pilot units with independent inspection and field testing before any fleet order is placed." }
      }
    ]
  }
];
---

<BaseLayout title={title} description={description} canonical={canonical} ogImage={ogImage} ogImageAlt={ogImageAlt} jsonLd={pageSchemas}>

  <!-- HERO -->
  <section class="page-hero">
    <div class="hero-bg">
      <img
        src="/images/china-mini-excavator-compact-machinery.webp"
        alt="Compact Chinese mini excavator working on a construction site, tracked machine with operator in the cab"
        width="1440"
        height="810"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero-overlay"></div>
    </div>
    <div class="hero-content container">
      <span class="hero-eyebrow">Mini Excavators & Compact Machinery — Contractors & Rental</span>
      <h1>Compact machines.<br />Real capex control.</h1>
      <p class="hero-sub">Compact machines are where site productivity and cost control collide. From our base in Zhengzhou, we help European contractors and rental fleets access Stage V-capable Chinese mini excavators, compact loaders and site equipment — with CE documentation, hydraulics QC and technical vetting handled on the ground in China.</p>
      <div class="hero-actions">
        <a href="/contact/" class="btn btn--white">Tell us what you'd pilot →</a>
        <a href="#whatyouget" class="btn btn--white-outline">What we source</a>
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <section class="trust-bar">
    <div class="container">
      <div class="trust-grid">
        <div class="trust-item">
          <span class="trust-num">Stage V + CE</span>
          <span class="trust-label">Verified at the factory, not assumed</span>
        </div>
        <div class="trust-divider"></div>
        <div class="trust-item">
          <span class="trust-num">20–40%</span>
          <span class="trust-label">Indicative machine capex saving (varies)</span>
        </div>
        <div class="trust-divider"></div>
        <div class="trust-item">
          <span class="trust-num">Hydraulics QC</span>
          <span class="trust-label">Pumps, hoses, welds, undercarriage</span>
        </div>
        <div class="trust-divider"></div>
        <div class="trust-item">
          <span class="trust-num">Pilot first</span>
          <span class="trust-label">Independent inspection before fleet orders</span>
        </div>
      </div>
    </div>
  </section>

  <!-- WHO THIS IS FOR -->
  <section class="section section--alt">
    <div class="container">
      <div class="split-grid">
        <div class="split-content">
          <span class="section-eyebrow">Who this offer is for</span>
          <h2>For fleets open to vetted alternatives</h2>
          <p>If you are responsible for fleet purchasing or rental capex and are open to carefully vetted Chinese OEMs under controlled conditions, this is for you:</p>
          <ul class="tick-list">
            <li>Civil and utility contractors using mini excavators day in, day out on streets, utilities and small sites.</li>
            <li>Rental companies expanding 1–8 tonne excavator fleets and compact loaders.</li>
            <li>Landscapers and small contractors needing versatile, affordable machines with strong ROI.</li>
          </ul>
          <a href="/source/construction-machinery-from-china-ireland/" class="inline-link">See the full construction machinery category →</a>
        </div>
        <div class="split-image">
          <img
            src="/images/compact-wheel-loader-skid-steer-china.webp"
            alt="Compact Chinese wheel loader and skid-steer loader on a construction site, ready for utility and site work"
            width="640"
            height="480"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT YOU GET -->
  <section class="section" id="whatyouget">
    <div class="container">
      <div class="products-layout">
        <div class="products-header">
          <span class="section-eyebrow">What we focus on</span>
          <h2>Compact machines that travel well and earn</h2>
          <p>We concentrate on categories where Chinese OEM volume is high, export experience is established, and engine and CE solutions already exist — not whatever is cheapest this week.</p>
        </div>
        <ul class="products-list">
          <li><span class="product-check">✓</span><span>1–3 tonne micro/mini excavators for tight access and landscaping</span></li>
          <li><span class="product-check">✓</span><span>3–8 tonne compact excavators for civil and utility work</span></li>
          <li><span class="product-check">✓</span><span>Up to ~20 tonne mid excavators for broader earthworks, where appropriate</span></li>
          <li><span class="product-check">✓</span><span>Compact wheel loaders and skid steers</span></li>
          <li><span class="product-check">✓</span><span>Site dumpers, plate compactors and small rollers</span></li>
          <li><span class="product-check">✓</span><span>Mobile concrete mixers and small batching plants to support your own civils or rental customers</span></li>
          <li><span class="product-check">✓</span><span>Configuration options — canopy or cab, zero-tail, rubber or steel tracks</span></li>
          <li><span class="product-check">✓</span><span>Stage V engines and complete CE technical files specified from the start</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- WHY CHINESE -->
  <section class="section section--alt">
    <div class="container">
      <div class="split-grid split-grid--reverse">
        <div class="split-image">
          <img
            src="/images/excavator-hydraulics-weld-inspection-china.webp"
            alt="Inspector checking excavator hydraulic cylinders, hoses and boom welds at a Chinese factory during pre-shipment quality control"
            width="640"
            height="480"
            loading="lazy"
          />
        </div>
        <div class="split-content">
          <span class="section-eyebrow">Why Chinese compact machinery makes sense</span>
          <h2>The market is real — the vetting is the value</h2>
          <p>The scale is genuine: Chinese OEMs exported around 7,953 of the 14,647 excavators sold in August 2024, and loader exports rose more than 30% year on year in July 2024. Meanwhile Europe's own market for mini and mid excavators was worth roughly €/USD 2.09 billion in 2024 — more than 30% of the global mini-excavator market — and compact machines are the fastest-growing segment. There is real room for vetted alternative OEMs to compete.</p>
          <p>But a better capex profile only counts if the machine lasts. That is why the work that matters happens on the ground: confirming Stage V engines and CE files, reviewing hydraulic schematics and component quality, and inspecting welds and structure before a single machine — let alone a fleet — is committed.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ECONOMICS -->
  <section class="section">
    <div class="container--narrow">
      <span class="section-eyebrow">Example economics</span>
      <h2>What a 3–5 tonne mini excavator looks like</h2>
      <p style="color:#3a3a3a;line-height:1.7;margin-bottom:1rem">Take a single mini-excavator category as an illustration (actual prices vary by spec and volume):</p>
      <ul class="tick-list tick-list--lg">
        <li>A well-known Western-OEM machine: <strong>€65,000–€80,000</strong> landed and prepped.</li>
        <li>A vetted Chinese machine, Stage V engine and CE documentation: <strong>€40,000–€55,000</strong> landed, including freight and duties.</li>
      </ul>
      <p class="fit-note">Where reliability, parts and residual values stack up, that gap turns into <strong>five-figure euro capex savings per machine</strong> — room to reinvest in attachments, telematics or extra units. We help you calculate those trade-offs with realistic assumptions, not wishful thinking, and we compare on total cost of ownership rather than the sticker price.</p>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section section--alt">
    <div class="container">
      <span class="section-eyebrow">How the sourcing process works</span>
      <h2>From requirements brief to a fleet you trust</h2>
      <div class="process-steps">
        <div class="process-step">
          <span class="step-num">01</span>
          <h3>Requirements brief</h3>
          <p>You specify tonnage, attachments, duty cycles and configuration — canopy/cab, zero-tail, rubber/steel tracks.</p>
        </div>
        <div class="process-step">
          <span class="step-num">02</span>
          <h3>OEM shortlist</h3>
          <p>We identify 2–3 manufacturers whose machines comply, or can be configured to comply, with Stage V and CE — and have real export experience.</p>
        </div>
        <div class="process-step">
          <span class="step-num">03</span>
          <h3>Technical comparison</h3>
          <p>We compare specs, engine approvals, cycle times, fuel consumption, warranties and pricing on a like-for-like basis.</p>
        </div>
        <div class="process-step">
          <span class="step-num">04</span>
          <h3>Pilot units &amp; testing</h3>
          <p>We arrange 1–3 pilot machines and coordinate third-party inspection and in-field trials before any scale commitment.</p>
        </div>
        <div class="process-step">
          <span class="step-num">05</span>
          <h3>Fleet deal structuring</h3>
          <p>If the pilot succeeds, we negotiate fleet pricing, after-sales support, spare-parts availability and operator training.</p>
        </div>
        <div class="process-step">
          <span class="step-num">06</span>
          <h3>QC &amp; logistics</h3>
          <p>For subsequent orders we oversee production, pre-shipment inspection and logistics via Zhengzhou's multimodal links.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- COMPLIANCE -->
  <section class="section section--emerald">
    <div class="container--narrow">
      <span class="section-eyebrow section-eyebrow--light">Critical compliance</span>
      <h2>Stage V and CE — worked backwards from the rules</h2>
      <p>For every machine we start from the European requirement. <strong>Stage V engines</strong> (Regulation (EU) 2016/1628): we determine the applicable power band and ensure engines are type-approved with supporting documentation. <strong>Machinery Directive 2006/42/EC</strong>: we ensure the OEM can provide a risk assessment, conformity with harmonised standards, a technical file, EC Declaration of Conformity and visible CE marking. <strong>Other directives as needed</strong> — EMC, noise, pressure equipment or ATEX, depending on machine type.</p>
      <p>We avoid grey machines designed only for other jurisdictions that lack Stage V and CE-ready designs. You remain responsible for placing the machine on the market and for in-service compliance — our job is to make sure the equipment and paperwork are genuinely there to support it.</p>
      <a href="/source/construction-machinery-from-china-ireland/" class="btn btn--white-outline" style="margin-top:1rem">See the full category &amp; compliance picture →</a>
    </div>
  </section>

  <!-- IS THIS RIGHT FOR YOU -->
  <section class="section">
    <div class="container--narrow">
      <span class="section-eyebrow">Is this offer right for you?</span>
      <h2>It's a strong fit if…</h2>
      <ul class="tick-list tick-list--lg">
        <li>You are open to piloting non-Western OEM machines under controlled conditions.</li>
        <li>You have the internal capability — or partners — to maintain mixed fleets.</li>
        <li>You value China-side oversight on compliance, QC and logistics rather than ad-hoc purchases.</li>
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--alt">
    <div class="container--narrow">
      <span class="section-eyebrow">Common questions</span>
      <h2>Compact machinery sourcing — questions answered</h2>
      <p class="faq-updated">Last reviewed: June 2026</p>
      <div class="faq-list">
        <details class="faq-item">
          <summary>Who is this compact machinery sourcing service for?</summary>
          <p>Civil and utility contractors running mini excavators day in, day out; rental companies expanding 1–8 tonne excavator and compact-loader fleets; and landscapers and small contractors who need versatile, affordable machines with strong ROI. If you are responsible for fleet purchasing or rental capex and are open to carefully vetted Chinese OEMs under controlled conditions, this is built for you.</p>
        </details>
        <details class="faq-item">
          <summary>What machines do you focus on?</summary>
          <p>Compact and mid excavators — 1–3 tonne micro/mini for tight access and landscaping, 3–8 tonne compact for civil and utility work, and up to ~20 tonne mid machines for broader earthworks where appropriate. Plus compact wheel loaders and skid steers, site dumpers, plate compactors and small rollers, and mobile concrete mixers and small batching plants. We focus on categories where Chinese OEM volume is high, export experience is established, and Stage V engine and CE solutions exist.</p>
        </details>
        <details class="faq-item">
          <summary>How much can I save versus a Western-OEM machine?</summary>
          <p>As a directional example in the 3–5 tonne class, a Western-OEM machine might land and be prepped at €65,000–€80,000, while a vetted Chinese machine with a Stage V engine and CE documentation might land in the €40,000–€55,000 band including freight and duties — roughly a 20–40% capex gap, depending on spec and volume. We help you weigh that against parts, support and residual value with realistic assumptions, not wishful thinking, and compare on total cost of ownership.</p>
        </details>
        <details class="faq-item">
          <summary>Will the machines be Stage V and CE compliant?</summary>
          <p>That is the starting point of every project. We confirm the applicable Stage V power band and ensure engines are type-approved under Regulation (EU) 2016/1628 with documentation, and we ensure the OEM can provide a risk assessment, conformity with harmonised standards, a technical file, EC Declaration of Conformity and visible CE marking under the Machinery Directive 2006/42/EC. We avoid grey machines designed only for other jurisdictions that lack Stage V and CE-ready designs.</p>
        </details>
        <details class="faq-item">
          <summary>How do you protect against poor hydraulics and welds?</summary>
          <p>We have a qualified engineer review hydraulic schematics and component specs — pumps, valves, cylinders, hoses and seals — and inspect weld penetration, steel grades and reinforcement at the boom, arm and undercarriage. We favour OEMs with documented QA and recognised hydraulic suppliers, and we run pilot units with independent inspection and field testing before any fleet order is placed.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--emerald">
    <div class="container--narrow" style="text-align:center">
      <span class="section-eyebrow section-eyebrow--light">Ready to scope it?</span>
      <h2>Tell us one machine type you'd pilot.</h2>
      <p>Name a single compact category you're open to trialling and we'll propose a shortlist of Chinese OEM options — with the compliance path, indicative economics and a safe pilot plan against your real duty cycle, no obligation.</p>
      <a href="/contact/" class="btn btn--white-outline" style="margin-top:1rem">Outline my machinery pilot →</a>
    </div>
  </section>

</BaseLayout>

<style>
  /* HERO */
  .page-hero { position: relative; min-height: 70vh; display: flex; align-items: flex-end; overflow: hidden; }
  .hero-bg { position: absolute; inset: 0; }
  .hero-bg img { width: 100%; height: 100%; object-fit: cover; object-position: center 40%; }
  .hero-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(10,28,18,.9) 0%, rgba(10,28,18,.55) 50%, rgba(10,28,18,.2) 100%); }
  .hero-content { position: relative; z-index: 2; padding: 4rem 0 5rem; max-width: 900px; }
  .hero-eyebrow { font-size: .8125rem; font-weight: 700; color: rgba(255,255,255,.65); text-transform: uppercase; letter-spacing: .1em; margin-bottom: 1.25rem; display: block; }
  .hero-content h1 { color: #fff; font-size: clamp(2.25rem, 5vw, 4rem); line-height: 1.05; margin-bottom: 1.5rem; letter-spacing: -.03em; }
  .hero-sub { font-size: clamp(1rem, 1.5vw, 1.1875rem); color: rgba(255,255,255,.82); line-height: 1.7; margin-bottom: 2rem; max-width: 640px; }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }

  /* TRUST BAR */
  .trust-bar { background: #fff; border-bottom: 1px solid rgba(15,33,49,.08); padding: 2.5rem 0; }
  .trust-grid { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
  .trust-item { display: flex; flex-direction: column; gap: .25rem; flex: 1; min-width: 160px; }
  .trust-num { font-family: var(--font-body); font-size: clamp(1.25rem, 2.5vw, 1.875rem); font-weight: 700; color: var(--color-emerald); line-height: 1; letter-spacing: -.03em; }
  .trust-label { font-size: .875rem; color: #5a5a5a; }
  .trust-divider { width: 1px; height: 48px; background: rgba(15,33,49,.12); flex-shrink: 0; }

  /* SPLITS */
  .split-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
  .split-grid--reverse { direction: rtl; }
  .split-grid--reverse > * { direction: ltr; }
  .split-content h2 { margin-bottom: 1.25rem; }
  .split-content p { color: #3a3a3a; margin-bottom: 1rem; }
  .split-image img { width: 100%; height: 420px; object-fit: cover; border-radius: 12px; }
  .inline-link { color: var(--color-emerald); font-weight: 600; font-size: .9375rem; text-decoration: none; }
  .inline-link:hover { text-decoration: underline; }

  /* TICK LISTS */
  .tick-list { list-style: none; margin: 0 0 1.25rem; padding: 0; display: flex; flex-direction: column; gap: .625rem; }
  .tick-list li { position: relative; padding-left: 1.5rem; color: #3a3a3a; line-height: 1.55; }
  .tick-list li::before { content: '✓'; position: absolute; left: 0; color: var(--color-emerald); font-weight: 700; }
  .tick-list--lg li { font-size: 1.0625rem; color: var(--color-navy); }
  .fit-note { color: var(--color-slate); font-size: .9375rem; margin-top: 1rem; }

  /* PRODUCTS LAYOUT */
  .products-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; }
  .products-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .875rem; }
  .products-list li { display: flex; align-items: flex-start; gap: .75rem; font-size: 1rem; color: var(--color-navy); line-height: 1.5; }
  .product-check { color: var(--color-emerald); font-weight: 700; flex-shrink: 0; margin-top: .1em; }
  .products-header p { color: var(--color-slate); margin-top: 1rem; }

  /* PROCESS STEPS */
  .process-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem 2.5rem; margin-top: 2.5rem; }
  .process-step { padding: 1.5rem 1.25rem 0 0; border-top: 2px solid var(--color-emerald); }
  .step-num { display: block; font-family: var(--font-body); font-size: 2.5rem; font-weight: 700; color: var(--color-teal); opacity: .35; line-height: 1; margin-bottom: .75rem; letter-spacing: -.04em; }
  .process-step h3 { font-size: 1rem; font-weight: 700; margin-bottom: .5rem; color: var(--color-navy); }
  .process-step p { font-size: .9375rem; color: #4a4a4a; max-width: 100%; margin: 0; }

  /* FAQ */
  .faq-updated { font-size: .8125rem; color: #888; margin: .25rem 0 1.5rem; }
  .faq-list { display: flex; flex-direction: column; gap: 0; margin-top: 1rem; }
  .faq-item { border-bottom: 1px solid rgba(15,33,49,.1); padding: 0; }
  .faq-item summary { font-weight: 600; font-size: 1rem; color: var(--color-navy); cursor: pointer; padding: 1.25rem 0; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; font-size: 1.25rem; font-weight: 300; color: var(--color-emerald); flex-shrink: 0; transition: transform .2s ease; }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item p { padding: 0 0 1.25rem; color: #4a4a4a; font-size: .9375rem; margin: 0; line-height: 1.65; }

  @media (max-width: 900px) {
    .split-grid, .split-grid--reverse { grid-template-columns: 1fr; gap: 2rem; direction: ltr; }
    .split-image img { height: 280px; }
    .products-layout { grid-template-columns: 1fr; gap: 2rem; }
    .process-steps { grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .process-step { padding: 1.25rem 0 0; }
    .trust-divider { display: none; }
  }
  @media (max-width: 600px) {
    .process-steps { grid-template-columns: 1fr; }
    .hero-actions { flex-direction: column; }
    .trust-grid { gap: 1rem; }
  }
</style>
