---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { sourcingPages } from '../../data/sourcingPages.js';

const title = "Source Products Direct from China to Ireland | Ériu Sourcing";
const description = "Factory-direct sourcing from China to Ireland across 7 product categories. Electronics, furniture, construction materials, hospitality fit-out, pet supplies, modular buildings, and fiber optic cable.";

const siteUrl = 'https://eriusourcing.com';
const pageSchemas = [
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
      { "@type": "ListItem", "position": 2, "name": "What We Source", "item": `${siteUrl}/source/` }
    ]
  },
  {
    "@type": "ItemList",
    "name": "China Sourcing Categories — Ireland",
    "description": "Seven product categories sourced factory-direct from China to Ireland by Ériu Sourcing.",
    "itemListElement": [
      ...sourcingPages.map((page, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": page.eyebrow,
        "url": `${siteUrl}/source/${page.slug}/`
      })),
      { "@type": "ListItem", "position": sourcingPages.length + 1, "name": "Fiber Optic Cable", "url": `${siteUrl}/source/fiber-optic-cable/` }
    ]
  },
  {
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What product categories can Ériu Sourcing source from China?",
        "acceptedAnswer": { "@type": "Answer", "text": "Ériu Sourcing works across seven categories: electronics and technology, furniture and furnishings, construction and building materials, hospitality fit-out, pet supplies, modular buildings and sandwich panels, and fiber optic cable (G.657.A2 bend-insensitive fiber and OPGW-24 G.652 ULL optical ground wire). All categories are sourced factory-direct from verified Chinese manufacturers with pre-shipment quality control and CE compliance documentation." }
      },
      {
        "@type": "Question",
        "name": "What savings can Irish businesses expect when sourcing direct from China?",
        "acceptedAnswer": { "@type": "Answer", "text": "Typical savings range from 35% to 55% compared to Irish wholesale prices, depending on the product category. Electronics and furniture typically show the largest savings due to high retail markups in Ireland. Construction materials and hospitality fit-out regularly come in at 38–45% below the best Irish or UK trade quotes, with full CE compliance documentation included." }
      },
      {
        "@type": "Question",
        "name": "How long does it take to source goods from China to Ireland?",
        "acceptedAnswer": { "@type": "Answer", "text": "Typical lead times from brief to goods landed in Ireland are 8–12 weeks, depending on the category and whether the product is stock or custom-manufactured. Factory identification, sampling, pre-shipment inspection, and sea freight from China to Dublin Port are all included in the timeline." }
      }
    ]
  }
];

// Category icon map for visual variety
const categoryIcons = {
  'electronics-from-china-ireland': '⚡',
  'furniture-from-china-ireland': '🪑',
  'construction-materials-from-china-ireland': '🏗️',
  'hospitality-fitout-from-china-ireland': '🏨',
  'pet-supplies-from-china-ireland': '🐾',
  'modular-buildings-from-china-ireland': '🏠',
  'ev-chargers-from-china-ireland': '🔋',
  'glamping-pods-cabins-from-china-ireland': '🏕️',
  'building-materials-production-systems-from-china-ireland': '🧱',
  'logistics-warehouse-equipment-from-china-ireland': '📦',
};
---

<BaseLayout title={title} description={description} canonical="/source/" jsonLd={pageSchemas}>

  <!-- HERO -->
  <section class="page-hero section--lg">
    <div class="container--narrow">
      <Breadcrumbs items={[{ label: 'What We Source' }]} />
      <span class="section-eyebrow">What We Source</span>
      <h1>Factory-direct from China to Ireland — across every category.</h1>
      <p class="lead">Seven product categories. One point of contact. Pre-shipment QC and CE compliance on every order. No Alibaba resellers, no trading company middlemen.</p>
      <div class="hero-ctas">
        <a href="/contact/" class="btn btn--primary">Get a sourcing quote →</a>
        <a href="#categories" class="btn btn--secondary">Browse categories ↓</a>
      </div>
    </div>
  </section>

  <!-- STATS BAR -->
  <section class="stats-bar">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-item">
          <span class="stat-num">7</span>
          <span class="stat-label">Product categories</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-num">18 yrs</span>
          <span class="stat-label">China factory experience</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-num">35—55%</span>
          <span class="stat-label">Typical savings vs Irish wholesale</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-num">100%</span>
          <span class="stat-label">CE compliance verified before shipment</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CATEGORY GRID -->
  <section id="categories" class="section section--alt">
    <div class="container">
      <div class="grid-header">
        <span class="section-eyebrow">All categories</span>
        <h2>Choose a category to see factory hubs, products, lead times, and typical pricing</h2>
      </div>
      <div class="category-grid">
        {sourcingPages.map(page => (
          <a href={`/source/${page.slug}/`} class="category-card lift">
            <div class="card-top">
              <span class="card-icon" aria-hidden="true">{categoryIcons[page.slug] || '📦'}</span>
              <span class="card-eyebrow">{page.eyebrow}</span>
            </div>
            <h3>{page.h1}</h3>
            <p class="card-intro">{page.intro.slice(0, 140).trim()}…</p>
            <div class="card-meta">
              <span class="meta-item">
                <span class="meta-label">Typical saving</span>
                <span class="meta-value">{page.savings}</span>
              </span>
              <span class="meta-divider"></span>
              <span class="meta-item">
                <span class="meta-label">Lead time</span>
                <span class="meta-value">{page.leadTime}</span>
              </span>
            </div>
            <span class="card-link">See {page.eyebrow.toLowerCase()} sourcing →</span>
          </a>
        ))}
        <!-- Fiber Optic Cable — standalone category not in sourcingPages.js -->
        <a href="/source/fiber-optic-cable/" class="category-card lift">
          <div class="card-top">
            <span class="card-icon" aria-hidden="true">🔌</span>
            <span class="card-eyebrow">Fiber Optic Cable</span>
          </div>
          <h3>G.657.A2 bend-insensitive fiber & OPGW-24 G.652 ULL optical ground wire</h3>
          <p class="card-intro">Factory-direct fiber optic cable for data centres and power utilities. G.657.A2 for dense DC patching. OPGW-24 for overhead transmission lines…</p>
          <div class="card-meta">
            <span class="meta-item">
              <span class="meta-label">Products</span>
              <span class="meta-value">G.657.A2 · OPGW-24</span>
            </span>
            <span class="meta-divider"></span>
            <span class="meta-item">
              <span class="meta-label">Lead time</span>
              <span class="meta-value">8–14 weeks</span>
            </span>
          </div>
          <span class="card-link">See fiber optic cable sourcing →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- MOQ TABLE -->
  <section class="section">
    <div class="container">
      <span class="section-eyebrow">At a glance</span>
      <h2>MOQ, savings, and lead times by category</h2>
      <p class="table-intro">All figures are typical ranges based on standard orders from verified Chinese factories shipped to Ireland. Actual figures depend on product specification and order volume.</p>
      <div class="moq-table-wrap">
        <table class="moq-table">
          <thead>
            <tr>
              <th>Category</th>
              <th>Typical saving vs Irish wholesale</th>
              <th>Min. order (typical)</th>
              <th>Lead time to Ireland</th>
            </tr>
          </thead>
          <tbody>
            {sourcingPages.map(page => (
              <tr>
                <td><a href={`/source/${page.slug}/`}>{page.eyebrow}</a></td>
                <td>{page.savings}</td>
                <td>{page.minOrderShort}</td>
                <td>{page.leadTime}</td>
              </tr>
            ))}
            <tr>
              <td><a href="/source/fiber-optic-cable/">Fiber Optic Cable</a></td>
              <td>Factory-direct pricing</td>
              <td>Project-dependent</td>
              <td>8–14 weeks</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- BUYER TYPE SECTION -->
  <section class="section">
    <div class="container">
      <span class="section-eyebrow">Browse by business type</span>
      <h2>Not sure which category fits? Start here.</h2>
      <p class="buyer-intro">Two buyer-type guides for businesses that don't fit neatly into a single product category.</p>
      <div class="buyer-type-grid">
        <a href="/source/private-label-from-china-ireland/" class="buyer-type-card">
          <span class="buyer-type-icon" aria-hidden="true">🏷️</span>
          <div>
            <h3>Private Label & Custom Manufacturing →</h3>
            <p>OEM / ODM sourcing for Irish brands. Your spec, your packaging, IP-protected. Cosmetics, supplements, electronics, pet products, apparel.</p>
          </div>
        </a>
        <a href="/source/retail-wholesale-from-china-ireland/" class="buyer-type-card">
          <span class="buyer-type-icon" aria-hidden="true">📦</span>
          <div>
            <h3>Retail & Wholesale Importers →</h3>
            <p>Stock products, repeat orders, container-scale volume. Save 35–60% on COGS across electronics, pet supplies, furniture, and more.</p>
          </div>
        </a>
        <a href="/source/ev-charger-sourcing-installers-ireland-uk/" class="buyer-type-card">
          <span class="buyer-type-icon" aria-hidden="true">🔌</span>
          <div>
            <h3>EV Charger Installers & CPOs →</h3>
            <p>AC &amp; DC charging hardware for Irish and UK installers and networks. Recover 30–50% on hardware, CE/IEC-verified, QC through Zhengzhou.</p>
          </div>
        </a>
        <a href="/source/3-pod-glamping-cabin-package-ireland-uk/" class="buyer-type-card">
          <span class="buyer-type-icon" aria-hidden="true">🏕️</span>
          <div>
            <h3>Glamping & Campsite Operators →</h3>
            <p>Glamping pods and container cabins for Irish &amp; UK campsites and farm stays. Start with a ready-to-assemble 3-pod cluster, QC'd in Zhengzhou.</p>
          </div>
        </a>
        <a href="/source/precast-wall-panel-floor-slab-lines-from-china/" class="buyer-type-card">
          <span class="buyer-type-icon" aria-hidden="true">🏭</span>
          <div>
            <h3>Precast Plants & Offsite Builders →</h3>
            <p>Complete precast wall-panel &amp; floor-slab production lines from Henan — capacity upgrades without Western OEM price tags, vetted and QC'd in Zhengzhou.</p>
          </div>
        </a>
        <a href="/source/warehouse-racking-conveyor-systems-from-china/" class="buyer-type-card">
          <span class="buyer-type-icon" aria-hidden="true">📦</span>
          <div>
            <h3>3PLs & E-commerce Warehouses →</h3>
            <p>Engineered pallet racking &amp; conveyor systems from China for European fulfilment and 3PL operations — localised layouts, on-site QC, multimodal routing.</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- WHY DIRECT -->
  <section class="section section--alt">
    <div class="container--narrow">
      <span class="section-eyebrow">Why factory-direct</span>
      <h2>What changes when you remove the middlemen</h2>
      <div class="reasons-grid">
        <div class="reason">
          <h3>Factory-gate pricing</h3>
          <p>You buy at the price European distributors buy at — before they add 60–100% margin. No Alibaba trading company layer, no UK importer, no Irish wholesaler.</p>
        </div>
        <div class="reason">
          <h3>QC before the container is sealed</h3>
          <p>Pre-shipment inspection happens at the factory. Failed goods stay in China at the factory's cost. You only pay freight on goods that pass.</p>
        </div>
        <div class="reason">
          <h3>CE compliance at source</h3>
          <p>EU compliance is verified and documented before shipment. Full CE certificates, EU Declaration of Conformity, and test reports provided with every order.</p>
        </div>
        <div class="reason">
          <h3>18 years on the ground</h3>
          <p>Permanent offices in Shenzhen and Zhengzhou. Direct factory relationships built over nearly two decades. We know which factories to use — and which to avoid.</p>
        </div>
      </div>
      <div style="margin-top: 2.5rem;">
        <a href="/why-direct/" class="btn btn--secondary">Read more: why factory-direct →</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--emerald">
    <div class="container--narrow" style="text-align:center">
      <span class="section-eyebrow section-eyebrow--light">Ready to start?</span>
      <h2>Tell us what you need. We'll find the factory.</h2>
      <p>Send a brief — product, quantity, timeline. We come back with factory-level pricing, a supplier shortlist, and a clear plan. No obligation.</p>
      <a href="/contact/" class="btn btn--white-outline" style="margin-top:1rem">Get a quote →</a>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── HERO ── */
  .page-hero {
    background-color: var(--color-bg-alt);
    border-bottom: 1px solid rgba(15,33,49,0.08);
  }

  .page-hero h1 {
    font-size: clamp(2.25rem, 5vw, 4rem);
    margin-top: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .lead {
    font-size: 1.25rem;
    color: #5a5a5a;
    line-height: 1.7;
    margin: 0 0 2rem;
    max-width: 58ch;
  }

  .hero-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* ── STATS BAR ── */
  .stats-bar {
    background: #fff;
    border-bottom: 1px solid rgba(15,33,49,0.08);
    padding: 2.5rem 0;
  }

  .stats-grid {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
    min-width: 160px;
  }

  .stat-num {
    font-family: var(--font-body);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--color-emerald);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .stat-label {
    font-size: 0.875rem;
    color: #5a5a5a;
  }

  .stat-divider {
    width: 1px;
    height: 48px;
    background: rgba(15,33,49,0.12);
    flex-shrink: 0;
  }

  /* ── GRID HEADER ── */
  .grid-header {
    margin-bottom: 2.5rem;
    max-width: 56ch;
  }

  /* ── CATEGORY GRID ── */
  .category-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .category-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: var(--color-white);
    border: 1px solid rgba(15,33,49,0.09);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }

  .category-card:hover {
    border-color: var(--color-emerald);
    box-shadow: 0 4px 20px rgba(26,83,62,0.1);
    transform: translateY(-2px);
  }

  .card-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .card-icon {
    font-size: 1.5rem;
    line-height: 1;
  }

  .card-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-teal);
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }

  .category-card h3 {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-navy);
    margin: 0;
    line-height: 1.35;
  }

  .card-intro {
    font-size: 0.875rem;
    color: var(--color-slate);
    line-height: 1.6;
    margin: 0;
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.875rem 0;
    border-top: 1px solid rgba(15,33,49,0.07);
    border-bottom: 1px solid rgba(15,33,49,0.07);
    margin-top: auto;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .meta-label {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-grey);
  }

  .meta-value {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-emerald);
    font-family: var(--font-display);
  }

  .meta-divider {
    width: 1px;
    height: 32px;
    background: rgba(15,33,49,0.1);
    flex-shrink: 0;
  }

  .card-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-emerald);
    margin-top: 0.25rem;
  }

  /* ── MOQ TABLE ── */
  .table-intro {
    font-size: 0.9375rem;
    color: var(--color-slate);
    margin: 0.5rem 0 1.75rem;
    max-width: 68ch;
  }

  .moq-table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid rgba(15,33,49,0.1);
    border-radius: var(--radius-lg);
  }

  .moq-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    min-width: 560px;
  }

  .moq-table thead tr {
    background: #1A533E;
    color: rgba(255,255,255,0.85);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .moq-table th {
    padding: 0.875rem 1.25rem;
    text-align: left;
    white-space: nowrap;
  }

  .moq-table td {
    padding: 0.875rem 1.25rem;
    border-bottom: 1px solid rgba(15,33,49,0.07);
    color: var(--color-navy);
    vertical-align: middle;
  }

  .moq-table tbody tr:last-child td {
    border-bottom: none;
  }

  .moq-table tbody tr:nth-child(even) {
    background: rgba(26,83,62,0.03);
  }

  .moq-table td a {
    color: var(--color-emerald);
    font-weight: 600;
    text-decoration: none;
  }

  .moq-table td a:hover {
    text-decoration: underline;
  }

  /* ── BUYER TYPE ── */
  .buyer-intro { color: var(--color-slate); margin: 0.5rem 0 1.75rem; max-width: 58ch; }
  .buyer-type-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  .buyer-type-card {
    display: flex; align-items: flex-start; gap: 1.25rem;
    padding: 1.75rem; background: var(--color-white);
    border: 1px solid rgba(15,33,49,.09); border-radius: 12px;
    text-decoration: none; color: inherit;
    transition: border-color .15s ease, box-shadow .15s ease, transform .15s ease;
  }
  .buyer-type-card:hover { border-color: var(--color-emerald); box-shadow: 0 4px 16px rgba(26,83,62,.08); transform: translateY(-2px); }
  .buyer-type-icon { font-size: 1.75rem; line-height: 1; flex-shrink: 0; margin-top: .125rem; }
  .buyer-type-card h3 { font-size: 1.0625rem; font-weight: 700; color: var(--color-navy); margin: 0 0 .5rem; }
  .buyer-type-card p { font-size: .9375rem; color: var(--color-slate); margin: 0; line-height: 1.55; }
  @media (max-width: 900px) { .buyer-type-grid { grid-template-columns: 1fr; } }

  /* ── REASONS ── */
  .reasons-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem 3rem;
    margin-top: 2rem;
  }

  .reason h3 {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-navy);
    margin-bottom: 0.5rem;
  }

  .reason p {
    font-size: 0.9375rem;
    color: #4a4a4a;
    line-height: 1.65;
    margin: 0;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 1024px) {
    .category-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 900px) {
    .reasons-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }

  @media (max-width: 600px) {
    .page-hero {
      padding-top: 3rem;
      padding-bottom: 3rem;
    }

    .category-grid {
      grid-template-columns: 1fr;
    }

    .hero-ctas {
      flex-direction: column;
    }

    .stats-grid {
      gap: 1rem;
    }

    .stat-divider {
      display: none;
    }

    .stat-item {
      min-width: 130px;
    }
  }
</style>
