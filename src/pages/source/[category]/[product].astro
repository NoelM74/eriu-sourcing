---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import PageHero from '../../../components/PageHero.astro';
import StatsRow from '../../../components/StatsRow.astro';
import FAQAccordion from '../../../components/FAQAccordion.astro';
import CtaSection from '../../../components/CtaSection.astro';
import { products } from '../../../data/products.js';
import { resolveImage, responsiveWidths } from '../../../lib/optimizedImages';

export async function getStaticPaths() {
  return products.map(product => ({
    params: { category: product.categorySlug, product: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const siteUrl = 'https://eriusourcing.com';
const productUrl = `${siteUrl}/source/${product.categorySlug}/${product.slug}/`;
const categoryUrl = `${siteUrl}/source/${product.categoryFullSlug}/`;

// Build-optimised hero image when a copy exists under src/assets/images;
// otherwise the raw /public <img> is used (graceful, per-image migration).
const heroImg = resolveImage(product.image);
// Short product name for the closing CTA: the H1 up to its first comma, with the
// first letter lowered unless it starts an acronym (PIR, LED, CCTV...).
const firstPart = product.h1.split(',')[0];
const ctaName = /^[A-Z][a-z]/.test(firstPart) ? firstPart[0].toLowerCase() + firstPart.slice(1) : firstPart;
const heroWidths = heroImg ? responsiveWidths(heroImg, [400,600,900, 1200]) : [];

// Sibling products in the same category, contextual internal links so deep
// product pages aren't reachable only from their parent category page.
// Use a rotating window (the N items *after* this one, wrapping) so coverage
// is even, every product ends up linked by the same number of siblings,
// rather than only the first few in array order.
const categoryProducts = products.filter(p => p.categorySlug === product.categorySlug);
const selfIndex = categoryProducts.findIndex(p => p.slug === product.slug);
const siblings = [];
for (let k = 1; k <= 8 && k < categoryProducts.length; k++) {
  const p = categoryProducts[(selfIndex + k) % categoryProducts.length];
  if (p.slug === product.slug) continue;
  siblings.push({
    href: `/source/${p.categorySlug}/${p.slug}/`,
    label: (p.h1.split(',')[0] || p.h1).trim(),
  });
}

const lastReviewedIso = new Date().toISOString().split('T')[0];
// Market-neutral (worldwide) product pages vs Ireland-framed ones.
const isGlobalProduct = product.global === true;
const marketLinks = [
  ['United Kingdom', '/uk/electronics-from-china/'], ['Europe', '/europe/electronics-from-china/'], ['United States', '/usa/electronics-from-china/'],
  ['Canada', '/canada/electronics-from-china/'], ['Australia', '/australia/electronics-from-china/'], ['UAE & Gulf', '/uae/electronics-from-china/'],
  ['South Africa', '/south-africa/electronics-from-china/'], ['Ireland', '/source/electronics-from-china-ireland/'],
];

// BreadcrumbList JSON-LD is emitted by the <Breadcrumbs> component itself.
const pageSchemas = [
  {
    "@type": "Service",
    "name": isGlobalProduct ? `${product.h1}, China direct sourcing` : `${product.h1}, China Direct Sourcing for Ireland`,
    "description": product.description,
    "provider": { "@type": "ProfessionalService", "@id": `${siteUrl}/#organization` },
    "areaServed": isGlobalProduct
      ? ["Ireland", "United Kingdom", "European Union", "United States", "Canada", "Australia", "United Arab Emirates", "South Africa"].map((n) => ({ "@type": "Place", "name": n }))
      : [{ "@type": "Country", "name": "Ireland" }],
    "serviceType": "China Sourcing Agent",
    "category": product.categoryLabel,
    "image": {
      "@type": "ImageObject",
      "url": `${siteUrl}${product.image}`,
      "width": product.imageWidth ?? 1400,
      "height": product.imageHeight ?? 934,
      "caption": product.imageAlt
    },
    "dateModified": lastReviewedIso
  },
  {
    "@type": "FAQPage",
    "mainEntity": product.faq.map(item => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": { "@type": "Answer", "text": item.a }
    }))
  }
];

// Stat-bar figure: a short region name. Long cluster descriptions fall back
// to the trailing provinces so the stat never renders as a paragraph.
let regionFigure = product.regionShort ?? product.region.split('(')[0].trim().replace(/ Provinces?$/, '');
while (!product.regionShort && regionFigure.length > 24 && regionFigure.includes(',')) {
  regionFigure = regionFigure.slice(regionFigure.indexOf(',') + 1).trim();
}
---

<BaseLayout
  globalPage={isGlobalProduct}
  title={product.title}
  description={product.description}
  canonical={`/source/${product.categorySlug}/${product.slug}/`}
  ogImage={product.image}
  ogImageAlt={product.imageAlt}
  jsonLd={pageSchemas}
>

  <PageHero
    variant="tight"
    breadcrumbs={[
      { label: 'What We Source', href: '/source/' },
      { label: product.categoryLabel, href: `/source/${product.categoryFullSlug}/` },
      { label: product.h1 }
    ]}
    eyebrow={product.categoryLabel}
    h1={product.h1}
    lead={product.intro}
    ctas={[
      { href: `/contact/?product=${encodeURIComponent(product.slug)}`, label: 'Get a sourcing quote →', variant: 'primary' },
      { href: `/source/${product.categoryFullSlug}/`, label: `See ${product.categoryLabel.toLowerCase()} category`, variant: 'secondary' }
    ]}
    lastReviewed={lastReviewedIso}
  >
    {heroImg ? (
      <Image
        slot="media"
        src={heroImg}
        alt={product.imageAlt}
        widths={heroWidths}
        sizes="(max-width: 960px) 100vw, 560px"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    ) : (
      <img
        slot="media"
        src={product.image}
        alt={product.imageAlt}
        width={product.imageWidth ?? 1400}
        height={product.imageHeight ?? 934}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    )}
  </PageHero>

  <StatsRow items={[
    { figure: regionFigure, label: 'Manufacturing region' },
    { figure: product.leadTimeShort ?? product.leadTime.split(/[+;(]/)[0].trim(), label: product.leadTimeLabel ?? 'Production lead time' },
    { figure: 'EN + CE', label: 'Compliance verified at factory' }
  ]} />

  <!-- REGION + WHO BUYS -->
  <section class="section section--alt">
    <div class="container">
      <div class="pd-duo">
        <div class="pd-card fade-up">
          <span class="section-eyebrow">Where this is made in China</span>
          <h2>{product.region}</h2>
          <p>{product.regionContext}</p>
          <a href="/china-network/" class="inline-link">See our full China network →</a>
        </div>
        <div class="pd-card pd-card--plain fade-up">
          <span class="section-eyebrow">{isGlobalProduct ? 'Who buys this' : 'Who buys this in Ireland'}</span>
          <h2>{isGlobalProduct ? 'Built for trade buyers, not consumers' : 'Built for Irish trade buyers, not consumers'}</h2>
          <ul class="pd-checks">
            {product.keyBuyers.map(buyer => <li>{buyer}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- SPECIFICATIONS -->
  <section class="section section--alt">
    <div class="container split-section">
      <div class="split-head">
        <span class="section-eyebrow">Specifications</span>
        <h2>Technical specification</h2>
        <p>The typical range we source. Send your own spec and we match factories to it, then confirm every figure on the sample before you order.</p>
      </div>
      <table class="spec-table">
        <tbody>
          {product.specifications.map(row => (
            <tr>
              <th scope="row">{row.label}</th>
              <td>{row.value}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- COMPLIANCE -->
  <section class="section section--emerald">
    <div class="container split-section">
      <div class="split-head">
        <span class="section-eyebrow section-eyebrow--light">{isGlobalProduct ? 'Compliance for your market' : 'EU & Irish Compliance'}</span>
        <h2>What we verify at the factory, before the container is sealed</h2>
        <p>Goods that fail compliance or pre-shipment QC stay in China at the factory's cost, you do not pay freight on non-compliant product.</p>
        <a href="/contact/" class="btn btn--white-outline">Ask about compliance documentation →</a>
      </div>
      <ul class="compliance-list">
        {product.compliance.map(item => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- PRICING + LOGISTICS -->
  <section class="section">
    <div class="container split-section">
      <div class="split-head">
        <span class="section-eyebrow">Landed-cost context</span>
        <h2>{isGlobalProduct ? 'What this lands at, delivered to you' : 'What this lands at in Ireland'}</h2>
        <p>{product.pricingContext}</p>
      </div>
      <div class="pd-card pd-card--plain">
        <h3>Lead time and logistics</h3>
        <p><strong>Lead time:</strong> {product.leadTime}.</p>
        <p>{product.logistics}</p>
      </div>
    </div>
  </section>

  {isGlobalProduct && (
    <section class="section section--alt">
      <div class="container split-section">
        <div class="split-head">
          <span class="section-eyebrow">Your market</span>
          <h2>Import rules for where you sell</h2>
          <p>Tax, duty and certification differ by country. Each market page sets out what applies, with sources, and how we check it before you pay.</p>
        </div>
        <ul class="sibling-links">
          {marketLinks.map(([t, h]) => <li><a href={h}>{t} <span aria-hidden="true">→</span></a></li>)}
        </ul>
      </div>
    </section>
  )}

  <!-- EDITORIAL BODY -->
  {product.contentBody && (
    <section class="section section--alt">
      <div class="container--narrow editorial-body">
        <span class="section-eyebrow">In depth</span>
        <h2>{isGlobalProduct ? 'What importers need to know' : 'What Irish buyers need to know'}</h2>
        <div class="editorial-prose" set:html={product.contentBody} />
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="section section--alt">
    <div class="container split-section">
      <div class="split-head">
        <span class="section-eyebrow">Common questions</span>
        <h2>{product.categoryLabel}, sourcing questions answered</h2>
        <p>Something not covered here? <a href={`/contact/?product=${encodeURIComponent(product.slug)}`} class="inline-link">Ask the team →</a></p>
      </div>
      <FAQAccordion items={product.faq} />
    </div>
  </section>

  <!-- MORE IN CATEGORY -->
  <section class="section">
    <div class="container split-section">
      <div class="split-head">
        <span class="section-eyebrow">More in {product.categoryLabel}</span>
        <h2>Related products you can source direct</h2>
        <a href={`/source/${product.categoryFullSlug}/`} class="btn btn--secondary">
          ← Back to all {product.categoryLabel}
        </a>
      </div>
      {siblings.length > 0 && (
        <ul class="sibling-links">
          {siblings.map(s => (
            <li><a href={s.href}>{s.label} <span aria-hidden="true">→</span></a></li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <CtaSection
    eyebrow="Ready to start?"
    h2={`Get factory-direct pricing on ${ctaName}`}
    body="Send a brief, specification, quantity, timeline. We come back with factory-level pricing, a supplier shortlist, and a clear plan. No obligation."
    ctas={[
      { href: `/contact/?product=${encodeURIComponent(product.slug)}`, label: 'Get a quote →', variant: 'white-outline' }
    ]}
  />

</BaseLayout>

<style>
  /* Page-local styles, hero/stats/FAQ/CTA moved into shared components.
     The remaining styles here own the spec table and compliance list,
     which haven't been extracted yet (product-page-specific patterns). */

  /* Sibling / related links */
  .sibling-links {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }
  .sibling-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.875rem;
    background: var(--color-bg-alt, #F7F6F2);
    border: 1px solid rgba(15, 33, 49, 0.1);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-emerald, #1A533E);
    text-decoration: none;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .sibling-links a:hover {
    border-color: var(--color-emerald, #1A533E);
    background: #fff;
  }

  /* Spec table */
  .spec-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 0;
    background: #fff;
    border: 1px solid rgba(15, 33, 49, 0.1);
    border-radius: 12px;
    overflow: hidden;
  }

  .spec-table th,
  .spec-table td {
    text-align: left;
    padding: 0.875rem 1.125rem;
    font-size: 0.9375rem;
    border-bottom: 1px solid rgba(15, 33, 49, 0.06);
    vertical-align: top;
  }

  .spec-table tr:last-child th,
  .spec-table tr:last-child td {
    border-bottom: none;
  }

  .spec-table th {
    width: 38%;
    background: var(--color-bg-alt, #F7F6F2);
    font-weight: 600;
    color: #0F2131;
  }

  .spec-table td {
    color: #3a3a3a;
  }

  /* Compliance list */
  .compliance-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.625rem;
  }

  .compliance-list li {
    position: relative;
    padding-left: 1.5rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: rgba(255,255,255, 0.92);
  }

  .compliance-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0;
    color: rgba(255,255,255, 0.7);
    font-weight: 700;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .spec-table th {
      width: 45%;
    }
  }

  @media (max-width: 600px) {
    /* Stack spec table label/value vertically on phones, much more
       readable than a squeezed 2-col layout. Same DOM, just CSS. */
    .spec-table,
    .spec-table tbody,
    .spec-table tr,
    .spec-table th,
    .spec-table td {
      display: block;
      width: 100%;
    }
    .spec-table tr {
      border-bottom: 1px solid rgba(15, 33, 49, 0.08);
      padding: 0.75rem 0;
    }
    .spec-table tr:last-child {
      border-bottom: none;
    }
    .spec-table th {
      background: transparent;
      padding: 0 1.125rem 0.125rem;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--color-teal);
    }
    .spec-table td {
      padding: 0 1.125rem;
      border-bottom: none;
    }
  }
</style>
