          <tbody>
            <tr><td>Temperature cycling</td><td>–60°C to +85°C</td><td>dB/km</td><td>≤0.05</td></tr>
            <tr><td>High temp. & high humidity</td><td>85°C, RH 85%, 30 days</td><td>dB/km</td><td>≤0.05</td></tr>
            <tr><td>Water immersion</td><td>23°C, 30 days</td><td>dB/km</td><td>≤0.05</td></tr>
            <tr><td>Dry heat aging</td><td>85°C, 30 days</td><td>dB/km</td><td>≤0.05</td></tr>
          </tbody>
        </table>
      </div>

      <div class="download-cta-inline">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
