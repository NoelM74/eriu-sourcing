      <h2>Full technical specification</h2>

      <h3 class="table-heading">Attenuation</h3>
      <div class="table-wrap">
        <table class="spec-table">
          <thead><tr><th>Parameter</th><th>Wavelength</th><th>Unit</th><th>Value</th></tr></thead>
          <tbody>
            <tr><td>Attenuation</td><td>1310 nm</td><td>dB/km</td><td>≤0.35</td></tr>
            <tr><td>Attenuation</td><td>1383 nm</td><td>dB/km</td><td>≤0.35</td></tr>
            <tr><td>Attenuation</td><td>1550 nm</td><td>dB/km</td><td class="highlight">≤0.21</td></tr>
            <tr><td>Attenuation</td><td>1625 nm</td><td>dB/km</td><td>≤0.24</td></tr>
            <tr><td>Attenuation vs. wavelength (1285–1330 nm vs. 1310 nm)</td><td>—</td><td>dB/km</td><td>≤0.04</td></tr>
            <tr><td>Attenuation vs. wavelength (1525–1575 nm vs. 1550 nm)</td><td>—</td><td>dB/km</td><td>≤0.03</td></tr>
            <tr><td>Attenuation discontinuity</td><td>1310 / 1550 nm</td><td>dB</td><td>≤0.05</td></tr>
          </tbody>
        </table>
      </div>

      <h3 class="table-heading">Transmission characteristics</h3>
