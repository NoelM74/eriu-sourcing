            <tr><td>15 mm</td><td>10</td><td>1625 nm</td><td>dB</td><td>≤0.1</td></tr>
            <tr><td>10 mm</td><td>1</td><td>1550 nm</td><td>dB</td><td>≤0.1</td></tr>
            <tr><td>10 mm</td><td>1</td><td>1625 nm</td><td>dB</td><td>≤0.2</td></tr>
