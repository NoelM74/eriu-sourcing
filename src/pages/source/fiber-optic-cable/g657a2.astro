            <tr><td class="highlight">7.5 mm</td><td>1</td><td>1625 nm</td><td>dB</td><td class="highlight">≤1.0</td></tr>
          </tbody>
        </table>
      </div>

      <h3 class="table-heading">Geometrical characteristics</h3>
