    <div class="container">
      <div class="image-feature">
        <img
          src="/images/data-center-blade-servers-fiber.webp"
          alt="Row of blue-lit blade servers in a hyperscale data centre — G.657.A2 bend-insensitive fiber is specified for high-density AI and cloud computing environments"
          width="1200" height="500" loading="lazy"
