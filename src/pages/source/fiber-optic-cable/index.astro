---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = 'G.657.A2 & OPGW Fiber Optic Cable — Factory Direct | Ériu Sourcing';
const description = 'Factory-direct fiber optic cable from verified Chinese manufacturers. G.657.A2 bend-insensitive fiber for data centres and OPGW-24 G.652 ULL for power utilities. Supply to Europe.';
const canonical = '/source/fiber-optic-cable/';
const siteUrl = 'https://eriusourcing.com';

const pageSchemas = [
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
      { "@type": "ListItem", "position": 2, "name": "What We Source", "item": `${siteUrl}/source/` },
      { "@type": "ListItem", "position": 3, "name": "Fiber Optic Cable", "item": `${siteUrl}/source/fiber-optic-cable/` }
    ]
  },
  {
    "@type": "ItemList",
    "name": "Fiber Optic Cable Products — Ériu Sourcing",
    "description": "Factory-direct fiber optic cable supply from verified Chinese manufacturers to Europe.",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "G.657.A2 Bend-Insensitive Single-Mode Fiber", "url": `${siteUrl}/source/fiber-optic-cable/g657a2/` },
      { "@type": "ListItem", "position": 2, "name": "OPGW-24 G.652 ULL Optical Ground Wire", "url": `${siteUrl}/source/fiber-optic-cable/opgw/` }
    ]
  },
  {
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What fiber optic cable products does Ériu Sourcing supply?",
        "acceptedAnswer": { "@type": "Answer", "text": "Ériu Sourcing supplies two fiber optic cable products factory-direct from verified Chinese manufacturers: G.657.A2 bend-insensitive single-mode optical fiber (ITU-T G.652.D / G.657.A2 compliant, 7.5 mm minimum bend radius, ≤0.21 dB/km at 1550 nm) for data centres, FTTH, and in-building cabling; and OPGW-24 G.652 ULL optical ground wire (24 ultra-low-loss G.652 fibers, 71 kN rated tensile strength, IEC 60794-4-10 and IEEE 1138-2009 compliant) for high-voltage overhead power lines." }
      },
      {
        "@type": "Question",
        "name": "What is the difference between G.657.A2 fiber and OPGW cable?",
        "acceptedAnswer": { "@type": "Answer", "text": "G.657.A2 and OPGW serve completely different markets. G.657.A2 is bare bend-insensitive single-mode fiber for indoor and short-haul applications — data centres, FTTH last-drop, in-building risers — where its 7.5 mm minimum bend radius solves tight-routing problems that cause signal loss in standard G.652.D fiber. OPGW (Optical Ground Wire) is a composite overhead cable that integrates 24 G.652 ultra-low-loss fibers inside a stainless-steel tube armoured with aluminium-clad steel and aluminium-alloy wires. It replaces conventional earth wire on 110–500 kV transmission lines, simultaneously providing lightning protection, grounding, and a fiber backbone for SCADA, protection relays, and commercial leasing." }
      },
      {
        "@type": "Question",
        "name": "Where does Ériu Sourcing ship fiber optic cable to?",
        "acceptedAnswer": { "@type": "Answer", "text": "Ériu Sourcing supplies fiber optic cable factory-direct from China to customers across Europe — including Ireland, the United Kingdom, Germany, France, the Netherlands, and other EU and EEA markets. Sea freight is routed to major European container ports such as Rotterdam, Hamburg, Dublin, and Felixstowe, with full shipping documentation (commercial invoice, packing list, bill of lading, certificate of origin, test records) to support customs clearance. All supply is on an inquiry and project basis." }
      },
      {
        "@type": "Question",
        "name": "What is the minimum order quantity for fiber optic cable?",
        "acceptedAnswer": { "@type": "Answer", "text": "G.657.A2 fiber is supplied on reels; minimum order quantity depends on reel size and configuration. Contact us with your required fiber count, length, coating diameter, and application. OPGW-24 G.652 ULL is supplied on non-returnable wooden drums in standard lengths of 2,000 to 5,000 metres per drum — drum lengths are typically matched to span calculations to minimise mid-span joints. We work with both single-drum sampling orders and project-scale multi-drum supply." }
      },
      {
        "@type": "Question",
        "name": "What standards must fiber optic cable meet for European installation?",
        "acceptedAnswer": { "@type": "Answer", "text": "Single-mode fiber for data centre, FTTH, and in-building use must comply with ITU-T G.652.D (standard single-mode performance) and, for bend-insensitive applications, ITU-T G.657.A2 — typically also certified to IEC 60793-2-50 category B6.a2. OPGW for overhead transmission lines must comply with IEC 60794-4-10 (mechanical and environmental performance of OPGW), IEEE 1138-2009 (construction standard for OPGW used on electric utility lines), and the fibers themselves to ITU-T G.652 ULL for ultra-low-loss performance. All Ériu Sourcing fiber is supplied with factory test certificates, OTDR traces per IEC 60793-1-40, and full compliance documentation." }
      },
      {
        "@type": "Question",
        "name": "Why source fiber optic cable factory-direct from China rather than through a European distributor?",
        "acceptedAnswer": { "@type": "Answer", "text": "European fiber optic distributors typically buy from the same Chinese manufacturers Ériu Sourcing works with, then resell with a 40–80% margin applied. Factory-direct supply removes that margin layer entirely, giving European buyers access to the same factory-gate pricing distributors pay. For G.657.A2 specifically, AI data centre build-outs have tightened supply across 2026 and pushed distributor pricing significantly above factory-gate levels — direct supply provides access to production capacity outside the spot market. For OPGW, factory-direct supply also means direct engineering-team access for configuration queries (fiber count, conductor cross-section, fault-current rating) and Factory Acceptance Test (FAT) coordination." }
      },
      {
        "@type": "Question",
        "name": "What is the typical lead time for fiber optic cable orders from China to Europe?",
        "acceptedAnswer": { "@type": "Answer", "text": "Lead time depends on product, configuration, and quantity. G.657.A2 fiber on standard reel configurations typically ships within 4–6 weeks of order confirmation, with sea freight to European ports adding another 30–40 days. OPGW orders are project-driven — manufacturing time runs 8–12 weeks depending on drum quantities, fiber count, and whether witness Factory Acceptance Testing (FAT) is required, plus sea freight. Custom configurations, non-standard fiber counts, or large project volumes extend lead time accordingly." }
      }
    ]
  },
  {
    "@type": "Organization",
    "@id": `${siteUrl}/#organization`,
    "name": "Ériu Sourcing",
    "url": siteUrl,
    "description": "China-direct sourcing agent for Irish and European businesses. Factory-direct access across electronics, construction, furniture, and fiber optic infrastructure products.",
    "areaServed": { "@type": "Place", "name": "Europe" }
  }
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={pageSchemas}>

  <!-- HERO -->
  <section class="fiber-hero section">
    <div class="container--narrow">
      <span class="section-eyebrow">Fiber Optic Cable</span>
      <h1>Factory-direct fiber optic cable from China to Europe</h1>
      <p class="lead">Two products, two markets. G.657.A2 bend-insensitive fiber for data centres, FTTH, and in-building cabling. OPGW-24 G.652 ULL optical ground wire for high-voltage power lines and utility networks. Both sourced direct from ISO 9001-certified Chinese manufacturers — verified, documented, and shipped to your specification.</p>
      <div class="hero-ctas">
        <a href="/contact" class="btn btn--primary">Request a quote →</a>
        <a href="#products" class="btn btn--secondary">View products</a>
      </div>
    </div>
  </section>

  <!-- MARKET CONTEXT BAR -->
  <section class="stats-bar">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-item">
          <span class="stat-num">8.45%</span>
          <span class="stat-label">Fiber optic market CAGR to 2031</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-num">G.657.A2</span>
          <span class="stat-label">Supply tightening — AI data centre demand</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-num">7.5 mm</span>
          <span class="stat-label">Minimum bend radius — G.657.A2</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-num">71 kN</span>
          <span class="stat-label">Rated tensile strength — OPGW-24</span>
        </div>
      </div>
    </div>
  </section>

  <!-- PRODUCT CARDS -->
  <section id="products" class="section section--alt">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Products</span>
        <h2>Two products. Two distinct markets.</h2>
        <p class="section-intro">G.657.A2 solves the bend-radius problem inside data halls, MDUs, and FTTH networks. OPGW-24 G.652 ULL integrates fiber into overhead transmission infrastructure for utilities and telecom carriers. Both are supplied direct from the factory with full technical documentation.</p>
      </div>

      <div class="product-grid">

        <!-- G.657.A2 -->
        <div class="product-card">
          <div class="product-img">
            <img
              src="/images/g657a2-fiber-patch-panel-dense-routing.webp"
              alt="Dense fiber optic patch panel with G.657.A2 bend-insensitive cables routed through a high-density data centre cross-connect"
              width="800" height="500" loading="eager" fetchpriority="high"
            />
            <span class="product-badge product-badge--teal">Data Centre & FTTH</span>
          </div>
          <div class="product-content">
            <span class="product-standard">ITU-T G.652.D / G.657.A2 · IEC 60793-2-50 B6.a2</span>
            <h2><a href="/source/fiber-optic-cable/g657a2/" class="card-link">G.657.A2 Bend-Insensitive Single-Mode Fiber</a></h2>
            <p>7.5 mm minimum bend radius. Full-band operation 1260–1625 nm. ≤0.21 dB/km attenuation at 1550 nm. Fully compatible with existing G.652.D infrastructure. The standard choice for AI data centre patching, high-density cross-connects, FTTH drops, and in-building distribution where tight routing is unavoidable.</p>
            <div class="spec-pills">
              <span class="spec-pill">7.5 mm bend radius</span>
              <span class="spec-pill">≤0.21 dB/km @ 1550 nm</span>
              <span class="spec-pill">G.652.D compatible</span>
              <span class="spec-pill">PMD ≤0.2 ps/√km</span>
            </div>
            <div class="product-links">
              <span class="primary-link" aria-hidden="true">Full specs & datasheet →</span>
              <a href="/downloads/Eriu-Sourcing-G657A2-Fiber-Spec-Sheet.pdf" class="download-link" target="_blank" rel="noopener">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
                Download spec sheet (PDF)
              </a>
            </div>
          </div>
        </div>

        <!-- OPGW -->
        <div class="product-card">
          <div class="product-img">
            <img
              src="/images/opgw-cable-high-voltage-transmission-line.webp"
              alt="OPGW optical ground wire strung between high-voltage transmission towers, combining lightning protection and 24-fiber G.652 ULL data backbone"
              width="800" height="500" loading="eager"
            />
            <span class="product-badge product-badge--navy">Power Utilities & Telecoms</span>
          </div>
          <div class="product-content">
            <span class="product-standard">IEC 60794-4-10 · IEEE 1138-2009 · ITU-T G.652 ULL</span>
            <h2><a href="/source/fiber-optic-cable/opgw/" class="card-link">OPGW-24 G.652 ULL Optical Ground Wire</a></h2>
            <p>24 ultra-low-loss G.652 fibers housed in a stainless-steel tube, armoured with aluminium-clad and aluminium-alloy wires. 71 kN rated tensile strength. Qualified for aeolian vibration, galloping, short-circuit current, and lightning. Replaces conventional earth wire on 110–500 kV lines — one cable delivering grounding, lightning protection, and a 24-fiber optical backbone.</p>
            <div class="spec-pills">
              <span class="spec-pill">24 × G.652 ULL fibers</span>
              <span class="spec-pill">71 kN RTS</span>
              <span class="spec-pill">≤0.18 dB/km @ 1550 nm</span>
              <span class="spec-pill">92.52 kA²S fault capacity</span>
            </div>
            <div class="product-links">
              <span class="primary-link" aria-hidden="true">Full specs & datasheet →</span>
              <a href="/downloads/Eriu-Sourcing-OPGW24-G652-ULL-Spec-Sheet.pdf" class="download-link" target="_blank" rel="noopener">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
                Download spec sheet (PDF)
              </a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- WHY FACTORY DIRECT FOR FIBER -->
  <section class="section">
    <div class="container">
      <div class="split-section">
        <div class="split-text">
          <span class="section-eyebrow">Why factory-direct</span>
          <h2>The fiber optic supply chain has the same middleman problem as every other category</h2>
          <p>European fiber optic distributors buy from Chinese manufacturers — often the same factories we work with — and resell with a 40–80% margin applied. For G.657.A2 fiber specifically, supply tightness in 2026 driven by AI data centre build-outs has pushed distributor pricing significantly above factory-gate levels.</p>
          <p>Factory-direct supply removes that margin layer entirely. You buy at the same price a European distributor buys at, with direct access to the factory's technical team for specification queries, custom configurations, and lead-time management.</p>
          <p>For OPGW — a project-driven, specification-heavy product — factory-direct supply also means direct access to the engineering team for configuration queries (fiber count, conductor cross-section, short-circuit rating), Factory Acceptance Test (FAT) coordination, and custom drum lengths to match your span calculations.</p>
          <a href="/why-direct/" class="btn btn--secondary" style="margin-top:1.5rem">How factory-direct works →</a>
        </div>
        <div class="split-img">
          <img
            src="/images/fiber-optic-data-center-server-rack.webp"
            alt="Data centre server rack with yellow and green fiber optic cables — factory-direct G.657.A2 fiber supply to European data centres"
            width="600" height="700" loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- MARKET CONTEXT -->
  <section class="section section--alt">
    <div class="container--narrow">
      <span class="section-eyebrow">Market context</span>
      <h2>Why fiber optic demand is accelerating — and what it means for procurement</h2>
      <div class="context-grid">
        <div class="context-card">
          <h3>AI data centres driving G.657.A2 demand</h3>
          <p>GPU clusters and hyperscale AI data centres require extreme-density fiber patching inside racks and between ToR switches, spines, and aggregation layers. G.657.A2's 7.5 mm bend radius handles the routing constraints that cause signal loss with standard G.652 patch leads. Industry sources report G.657.A2 supply tightness and price increases across 2026 as cloud providers lock in long-term contracts. Securing direct factory supply now protects against distributor scarcity premiums.</p>
        </div>
        <div class="context-card">
          <h3>Grid modernisation driving OPGW installation</h3>
          <p>Transmission system operators across Europe are replacing ageing overhead earth wires with OPGW to provide simultaneous lightning protection and a fiber backbone for SCADA, protection relays, and synchrophasor networks. Utilities also monetise spare fiber capacity by leasing to telecom carriers for regional backhaul — making the 24-fiber count of the OPGW-24 G.652 ULL particularly attractive: sufficient for internal grid communications plus commercially leasable spare fibers.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section">
    <div class="container--narrow">
      <span class="section-eyebrow">How it works</span>
      <h2>From specification to delivery</h2>
      <div class="process-steps">
        <div class="process-step">
          <span class="step-num">01</span>
          <div class="step-body">
            <h3>Send your specification</h3>
            <p>Share your fiber type, quantity, connector/reel configuration, required standards, and timeline. For OPGW, include your span data, fault current requirements, and applicable voltage class.</p>
          </div>
        </div>
        <div class="process-step">
          <span class="step-num">02</span>
          <div class="step-body">
            <h3>Factory quotation and documentation review</h3>
            <p>We obtain a factory-gate quotation and review the technical file — test certificates, compliance documentation (IEC, ITU-T, IEEE), and manufacturing records. For OPGW, we confirm FAT scope and coordinate witness testing if required.</p>
          </div>
        </div>
        <div class="process-step">
          <span class="step-num">03</span>
          <div class="step-body">
            <h3>Production, QC, and pre-shipment inspection</h3>
            <p>Pre-shipment inspection at the factory covers optical performance (OTDR per IEC 60793-1-40), dimensional checks, and documentation completeness. OPGW orders include breaking strength verification and review of routine test records against the FAT scope.</p>
          </div>
        </div>
        <div class="process-step">
          <span class="step-num">04</span>
          <div class="step-body">
            <h3>Freight and delivery to Europe</h3>
            <p>Sea freight from China to European ports (Rotterdam, Hamburg, Dublin, Felixstowe) with full shipping documentation — commercial invoice, packing list, bill of lading, certificate of origin, and test records — to support customs clearance.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--alt">
    <div class="container--narrow">
      <span class="section-eyebrow">Frequently asked</span>
      <h2>Fiber optic cable sourcing — common questions</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary>What fiber optic cable products does Ériu Sourcing supply?</summary>
          <p>Ériu Sourcing supplies two fiber optic cable products factory-direct from verified Chinese manufacturers: G.657.A2 bend-insensitive single-mode optical fiber (ITU-T G.652.D / G.657.A2 compliant, 7.5 mm minimum bend radius, ≤0.21 dB/km at 1550 nm) for data centres, FTTH, and in-building cabling; and OPGW-24 G.652 ULL optical ground wire (24 ultra-low-loss G.652 fibers, 71 kN rated tensile strength, IEC 60794-4-10 and IEEE 1138-2009 compliant) for high-voltage overhead power lines.</p>
        </details>
        <details class="faq-item">
          <summary>What is the difference between G.657.A2 fiber and OPGW cable?</summary>
          <p>G.657.A2 and OPGW serve completely different markets. G.657.A2 is bare bend-insensitive single-mode fiber for indoor and short-haul applications — data centres, FTTH last-drop, in-building risers — where its 7.5 mm minimum bend radius solves tight-routing problems that cause signal loss in standard G.652.D fiber. OPGW (Optical Ground Wire) is a composite overhead cable that integrates 24 G.652 ultra-low-loss fibers inside a stainless-steel tube armoured with aluminium-clad steel and aluminium-alloy wires. It replaces conventional earth wire on 110–500 kV transmission lines, simultaneously providing lightning protection, grounding, and a fiber backbone for SCADA, protection relays, and commercial leasing.</p>
        </details>
        <details class="faq-item">
          <summary>Where does Ériu Sourcing ship fiber optic cable to?</summary>
          <p>Ériu Sourcing supplies fiber optic cable factory-direct from China to customers across Europe — including Ireland, the United Kingdom, Germany, France, the Netherlands, and other EU and EEA markets. Sea freight is routed to major European container ports such as Rotterdam, Hamburg, Dublin, and Felixstowe, with full shipping documentation (commercial invoice, packing list, bill of lading, certificate of origin, test records) to support customs clearance. All supply is on an inquiry and project basis.</p>
        </details>
        <details class="faq-item">
          <summary>What is the minimum order quantity for fiber optic cable?</summary>
          <p>G.657.A2 fiber is supplied on reels; minimum order quantity depends on reel size and configuration. Contact us with your required fiber count, length, coating diameter, and application. OPGW-24 G.652 ULL is supplied on non-returnable wooden drums in standard lengths of 2,000 to 5,000 metres per drum — drum lengths are typically matched to span calculations to minimise mid-span joints. We work with both single-drum sampling orders and project-scale multi-drum supply.</p>
        </details>
        <details class="faq-item">
          <summary>What standards must fiber optic cable meet for European installation?</summary>
          <p>Single-mode fiber for data centre, FTTH, and in-building use must comply with ITU-T G.652.D (standard single-mode performance) and, for bend-insensitive applications, ITU-T G.657.A2 — typically also certified to IEC 60793-2-50 category B6.a2. OPGW for overhead transmission lines must comply with IEC 60794-4-10 (mechanical and environmental performance of OPGW), IEEE 1138-2009 (construction standard for OPGW used on electric utility lines), and the fibers themselves to ITU-T G.652 ULL for ultra-low-loss performance. All Ériu Sourcing fiber is supplied with factory test certificates, OTDR traces per IEC 60793-1-40, and full compliance documentation.</p>
        </details>
        <details class="faq-item">
          <summary>Why source fiber optic cable factory-direct from China rather than through a European distributor?</summary>
          <p>European fiber optic distributors typically buy from the same Chinese manufacturers Ériu Sourcing works with, then resell with a 40–80% margin applied. Factory-direct supply removes that margin layer entirely, giving European buyers access to the same factory-gate pricing distributors pay. For G.657.A2 specifically, AI data centre build-outs have tightened supply across 2026 and pushed distributor pricing significantly above factory-gate levels — direct supply provides access to production capacity outside the spot market. For OPGW, factory-direct supply also means direct engineering-team access for configuration queries (fiber count, conductor cross-section, fault-current rating) and Factory Acceptance Test (FAT) coordination.</p>
        </details>
        <details class="faq-item">
          <summary>What is the typical lead time for fiber optic cable orders from China to Europe?</summary>
          <p>Lead time depends on product, configuration, and quantity. G.657.A2 fiber on standard reel configurations typically ships within 4–6 weeks of order confirmation, with sea freight to European ports adding another 30–40 days. OPGW orders are project-driven — manufacturing time runs 8–12 weeks depending on drum quantities, fiber count, and whether witness Factory Acceptance Testing (FAT) is required, plus sea freight. Custom configurations, non-standard fiber counts, or large project volumes extend lead time accordingly. We provide indicative lead times at quotation stage.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--emerald">
    <div class="container--narrow" style="text-align:center">
      <span class="section-eyebrow section-eyebrow--light">Get pricing</span>
      <h2>Send your fiber optic specification. We come back with factory-gate pricing.</h2>
      <p>G.657.A2 fiber reels or OPGW drums — share your quantity, configuration, and delivery port. No obligation, no intermediary margin.</p>
      <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;margin-top:1.5rem">
        <a href="/contact" class="btn btn--white-outline">Request a quote →</a>
        <a href="/downloads/Eriu-Sourcing-G657A2-Fiber-Spec-Sheet.pdf" class="btn btn--white-ghost" target="_blank" rel="noopener">G.657.A2 spec sheet (PDF)</a>
        <a href="/downloads/Eriu-Sourcing-OPGW24-G652-ULL-Spec-Sheet.pdf" class="btn btn--white-ghost" target="_blank" rel="noopener">OPGW-24 spec sheet (PDF)</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* HERO */
  .fiber-hero {
    border-bottom: 1px solid rgba(15,33,49,0.08);
  }
  .fiber-hero h1 {
    margin-top: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .lead {
    font-size: 1.2rem;
    color: #3a3a3a;
    max-width: 64ch;
    line-height: 1.7;
    margin: 0 0 2rem;
  }
  .hero-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* STATS BAR */
  .stats-bar {
    background: #fff;
    border-bottom: 1px solid rgba(15,33,49,0.08);
    padding: 2.5rem 0;
  }
  .stats-grid {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
    min-width: 140px;
  }
  .stat-num {
    font-size: clamp(1.25rem, 2.5vw, 1.875rem);
    font-weight: 700;
    color: var(--color-emerald);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .stat-label {
    font-size: 0.8125rem;
    color: #5a5a5a;
    line-height: 1.4;
  }
  .stat-divider {
    width: 1px;
    height: 48px;
    background: rgba(15,33,49,0.12);
    flex-shrink: 0;
  }

  /* SECTION HEADER */
  .section-header {
    max-width: 62ch;
    margin-bottom: 3rem;
  }
  .section-intro {
    font-size: 1.0625rem;
    color: #4a4a4a;
    line-height: 1.7;
    margin: 0.75rem 0 0;
  }

  /* PRODUCT GRID */
  .product-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }
  .product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid rgba(15,33,49,0.09);
    border-radius: var(--radius-lg);
    overflow: hidden;
    color: inherit;
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }
  .product-card:hover {
    border-color: var(--color-emerald);
    box-shadow: 0 6px 28px rgba(26,83,62,0.1);
    transform: translateY(-3px);
  }
  .card-link {
    color: inherit;
    text-decoration: none;
