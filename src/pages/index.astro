---
import BaseLayout from '../layouts/BaseLayout.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import { getByTags } from '../data/testimonials.js';
const homepageQuotes = getByTags(['homepage']);

const title = "China Sourcing Agent Ireland | Factory-Direct | Ériu";
const description = "Buy direct from Chinese factories. No Alibaba middlemen. Pre-shipment QC inspection. CE compliance verified. Save 35–60% vs Irish wholesale.";

// Single source of truth: drives both the visible accordion and FAQPage schema.
const faqs = [
  { q: "What is a China sourcing agent?", a: "A China sourcing agent acts as your on-the-ground representative in China. They identify factories, vet suppliers, negotiate prices, conduct pre-shipment quality control inspections, and coordinate freight to your destination. Ériu Sourcing operates from Zhengzhou and Shenzhen with 18 years of established factory relationships across all major manufacturing categories." },
  { q: "How much can I save buying direct from Chinese factories?", a: "Irish businesses typically save 35–60% compared to buying through Irish wholesalers or Alibaba trading companies. These savings come from eliminating two or three layers of margin: the Chinese trading company markup (15–40%), the European importer markup, and the Irish distributor margin. The exact saving depends on product category, volume, and your current wholesale pricing." },
  { q: "What is the difference between Ériu Sourcing and buying on Alibaba?", a: "Most suppliers on Alibaba are trading companies, not factories — they add 20–40% margin while presenting themselves as manufacturers. There is no physical verification, no pre-shipment inspection, and no CE compliance check possible through Alibaba alone. Ériu Sourcing provides direct factory access with physical on-site visits, factory-gate price negotiation, and independent pre-shipment QC before a container is sealed." },
  { q: "Do you handle CE marking and EU compliance for Chinese imports?", a: "Yes. CE compliance is verified at source — at the factory in China — before any goods leave the country. We check certification documentation, test reports, and product specifications against EU and Irish standards. For construction materials, electronics, and apparel, full compliance documentation is provided with every order." },
  { q: "What minimum order is required to use Ériu Sourcing?", a: "Ériu Sourcing works with businesses across all sizes. Minimum order quantities are set by individual factories and vary by product category — typically ranging from €3,000 to €10,000 per order depending on the product. Factory-specific MOQs are advised as part of the initial brief stage, before any commitment is made." },
];

const siteUrl = 'https://eriusourcing.com';
const pageSchemas = [
  {
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    "url": siteUrl,
    "name": "Ériu Sourcing",
    "description": "Factory-direct China sourcing agent for Irish and UK businesses.",
    "inLanguage": "en-IE"
  },
  {
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  }
];
---

<BaseLayout title={title} description={description} canonical="/" jsonLd={pageSchemas} preloadImage="/images/hero-china-factory-floor.webp">

  <!-- ================================================
       HERO — full-bleed image, text overlay
       ================================================ -->
  <section class="hero">
    <div class="hero-bg">
      <img
        src="/images/hero-china-factory-floor.webp"
        alt="Chinese electronics manufacturing factory — Ériu Sourcing sources directly from facilities like this"
        width="1440"
        height="810"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero-overlay"></div>
    </div>
    <div class="hero-content container">
      <p class="hero-eyebrow">China Direct Sourcing — Ireland</p>
      <h1>Skip the middlemen.<br />Pay the factory price.</h1>
      <p class="hero-sub">Buy direct from the factory floor in China — and cut 35–60% off Irish wholesale prices. QC before it ships, no Alibaba middlemen, no trading-company markups. An Irish-led team sourcing direct for Irish businesses.</p>
      <div class="hero-actions">
        <a href="/contact/" class="btn btn--white">Get Factory Pricing →</a>
        <a href="/how-it-works/" class="btn btn--white-outline">See How It Works</a>
      </div>
    </div>
  </section>

  <!-- ================================================
       TRUST BAR — four stats
       ================================================ -->
  <section class="trust-bar fade-up">
    <div class="container">
      <ul class="stats-row" role="list">
        <li class="stat-item">
          <span class="stat-figure count-up" data-target="18">18</span>
          <span class="stat-label">Years based in China</span>
        </li>
        <li class="stat-divider" aria-hidden="true"></li>
        <li class="stat-item">
          <span class="stat-figure">€30M+</span>
          <span class="stat-label">Logistics company revenue</span>
        </li>
        <li class="stat-divider" aria-hidden="true"></li>
        <li class="stat-item">
          <span class="stat-figure">35–60%</span>
          <span class="stat-label">Typical savings vs Irish wholesale</span>
        </li>
        <li class="stat-divider" aria-hidden="true"></li>
        <li class="stat-item">
          <span class="stat-figure count-up" data-target="2">2</span>
          <span class="stat-label">China bases: Zhengzhou &amp; Shenzhen</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- ================================================
       BRAND LOGOS — social proof strip
       ================================================ -->
  <section class="logos-section">
    <div class="container">
      <p class="logos-label">A selection of brands we have worked with</p>
      <div class="logos-strip">
        <img src="/images/logo-triangl.webp"     alt="TRIANGL Swimwear"       width="150" height="44" loading="lazy" />
        <img src="/images/logo-sparkpaws.webp"   alt="Spark Paws"             width="180" height="44" loading="lazy" />
        <img src="/images/logo-paddywagon.webp"  alt="Paddywagon Tours"       width="165" height="44" loading="lazy" />
        <img src="/images/logo-titan-sports.webp" alt="Titan Sports Limerick" width="140" height="44" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ================================================
       WHY DIRECT — editorial numbered list
       ================================================ -->
  <section class="section section--alt">
    <div class="container">
      <div class="why-header">
        <span class="section-eyebrow">The cost argument</span>
        <h2>Why every Irish business<br />should buy direct from China</h2>
        <p class="why-intro">Every Irish business buying Chinese goods through a wholesaler or trading company is paying for layers of margin they don't need.</p>
      </div>

      <div class="why-list">
        <div class="why-item">
          <span class="why-num">01</span>
          <div class="why-body">
            <h3>Factory gate pricing — not three markups stacked on top</h3>
            <p>You pay what the factory charges. Not what the Alibaba trading company adds on top. Not what the Irish wholesaler adds on top of that. Direct relationships built over 18 years mean the price is real.</p>
          </div>
        </div>
        <div class="why-item">
          <span class="why-num">02</span>
          <div class="why-body">
            <h3>Your goods are inspected at the factory before they ship</h3>
            <p>Every order is physically inspected before a container is sealed. If it fails, it stays. You don't pay freight on goods that aren't right — and you don't get a nasty surprise on the Dublin docks.</p>
          </div>
        </div>
        <div class="why-item">
          <span class="why-num">03</span>
          <div class="why-body">
            <h3>CE marking and EU compliance verified at source</h3>
            <p>We verify certifications at the factory, not at customs. Construction materials, electronics, apparel — all checked against EU and Irish standards before anything leaves China.</p>
          </div>
        </div>
        <div class="why-item">
          <span class="why-num">04</span>
          <div class="why-body">
            <h3>Most "factories" on Alibaba are trading companies in disguise</h3>
            <p>Trading companies on Alibaba typically add 20–40% margin while presenting themselves as manufacturers. We source in person, directly from the factory floor, with relationships that go back years.</p>
          </div>
        </div>
      </div>

      <div class="why-cta">
        <a href="/why-direct/" class="btn btn--secondary">The full cost breakdown →</a>
      </div>
    </div>
  </section>

  <!-- ================================================
       BUYER SEGMENTS — who's it for
       ================================================ -->
  <section class="section buyer-section">
    <div class="container">
      <div class="buyer-header">
        <span class="section-eyebrow">Who's it for · What we source</span>
        <h2>Built around the way<br />Irish businesses actually buy</h2>
        <p class="buyer-intro">Five buyer profiles we work with most. Find the one closest to your business — or get in touch if your model sits across more than one.</p>
        <a href="/source/" class="buyer-header-cta">See every category we source →</a>
      </div>

      <div class="buyer-grid">
        <a href="/source/construction-materials-from-china-ireland/" class="buyer-card">
          <span class="buyer-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20h20"/><path d="M4 20V8l8-5 8 5v12"/><path d="M9 20v-6h6v6"/><path d="M9 10h6"/></svg>
          </span>
          <h3>Construction &amp; Building Materials</h3>
          <p>CE-marked plywood, insulation, fixtures and finishes — verified to EN standards before the container is sealed. No NSAI surprises at Dublin Port.</p>
          <span class="buyer-link">For contractors &amp; merchants →</span>
        </a>

        <a href="/source/modular-buildings-from-china-ireland/" class="buyer-card">
          <span class="buyer-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1v-9.5z"/></svg>
          </span>
          <h3>Modular &amp; Residential Homes</h3>
          <p>Sandwich panel systems, container-based builds, prefab cabins, and full modular units — engineered to EU spec, shipped flat-pack or fully fitted.</p>
          <span class="buyer-link">For developers &amp; builders →</span>
        </a>

        <a href="/source/retail-wholesale-from-china-ireland/" class="buyer-card">
          <span class="buyer-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/><path d="M16.5 9.4 7.5 4.2"/></svg>
          </span>
          <h3>Retail &amp; Wholesale Importers</h3>
          <p>Stock products, repeat orders, container-scale volume. Factory-direct pricing across electronics, pet supplies, homeware and more — MOQs typically from €4k.</p>
          <span class="buyer-link">For retailers &amp; distributors →</span>
        </a>

        <a href="/source/machinery-from-china-ireland/" class="buyer-card">
          <span class="buyer-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
          </span>
          <h3>Heavy Machinery — Inland-China Direct</h3>
          <p>Concrete pumps from Changsha (Sany), crushers from Zhengzhou, tractors from Luoyang YTO, excavators from Xuzhou XCMG, forklifts from Hefei Heli. 25–45% under UK dealer.</p>
          <span class="buyer-link">For plant hire, quarries &amp; fleet operators →</span>
        </a>

        <a href="/source/furniture-from-china-ireland/" class="buyer-card">
          <span class="buyer-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M19 9V6a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v3"/><path d="M3 11v5a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5a2 2 0 0 0-4 0v2H7v-2a2 2 0 0 0-4 0z"/><path d="M5 18v2"/><path d="M19 18v2"/></svg>
          </span>
          <h3>Furniture — Home, Outdoor &amp; Contract</h3>
          <p>Direct from the Foshan furniture cluster. Residential, outdoor, and hospitality fit-out — bedroom, FF&amp;E, restaurant, and hotel projects under one supplier base.</p>
          <span class="buyer-link">For retailers, hotels &amp; fit-out →</span>
        </a>

        <a href="/source/private-label-from-china-ireland/" class="buyer-card">
          <span class="buyer-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r="1.25" fill="currentColor" stroke="none"/></svg>
          </span>
          <h3>Private Label &amp; Custom Manufacturing</h3>
          <p>Your spec, your branding, your packaging. OEM and ODM sourcing with factory vetting, sample management, and IP-aware supplier selection.</p>
          <span class="buyer-link">For brands &amp; product owners →</span>
        </a>

        <a href="/contact/" class="buyer-card buyer-card--neutral">
          <span class="buyer-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </span>
          <h3>Not sure where you fit?</h3>
          <p>If your business model crosses categories — or you're not seeing yours listed — send a quick brief. Ten minutes is enough to figure out whether direct sourcing is right for you.</p>
          <span class="buyer-link">Talk it through →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ================================================
       HOW IT WORKS — horizontal steps (Step 3 covers
       pre-shipment QC, so we no longer carry a
       separate "Quality control" section above)
       ================================================ -->
  <section class="section section--alt process-section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">The process</span>
        <h2>Four steps from brief<br />to goods in Ireland</h2>
      </div>
      <ol class="process-steps" role="list">
        <li class="process-step">
          <div class="step-number">1</div>
          <div class="step-content">
            <h3>You brief us</h3>
            <p>Product, quantity, spec, timeline. Ten minutes via email or WhatsApp is enough to get started. No long forms.</p>
          </div>
        </li>
        <li class="process-step">
          <div class="step-number">2</div>
          <div class="step-content">
            <h3>We find the right factory</h3>
            <p>Our China team visits the factory, negotiates direct, and sends you a sourcing report with vetted suppliers, FOB pricing, and lead times.</p>
          </div>
        </li>
        <li class="process-step">
          <div class="step-number">3</div>
          <div class="step-content">
            <h3>QC before it ships</h3>
            <p>Physical inspection at the factory. CE compliance verified. Failures get fixed in China — not on the Dublin docks.</p>
          </div>
        </li>
        <li class="process-step">
          <div class="step-number">4</div>
          <div class="step-content">
            <h3>Shipped to Ireland</h3>
            <p>Freight, documentation, customs coordination — all handled. You get landed goods at factory-gate value.</p>
          </div>
        </li>
      </ol>
      <div class="process-cta">
        <a href="/how-it-works/" class="btn btn--primary">Full process breakdown →</a>
      </div>
    </div>
  </section>

  <!-- ================================================
       CHINA NETWORK — split with image
       (buyer section above already lists the 6
       categories with stronger framing, so we no
       longer carry a separate flat-list "What we
       source" section between them)
       ================================================ -->
  <section class="section">
    <div class="container">
      <div class="split-grid split-grid--reverse">
        <div class="split-image">
          <img
            src="/images/zhengzhou-hsr-station.webp"
            alt="Zhengzhou East Railway Station — HSR hub for Ériu Sourcing's factory network"
            width="640"
            height="427"
            loading="lazy"
          />
        </div>
        <div class="split-content">
          <span class="section-eyebrow">The network</span>
          <h2>Two bases.<br />Reach across all of China.</h2>
          <p>Zhengzhou puts our team in the centre of Eastern China's manufacturing heartland. Every major industrial city — Beijing, Shanghai, Xi'an, Wuhan — is within 2–3 hours by high-speed rail.</p>
          <p>Shenzhen gives direct access to Guangdong's consumer goods cluster: electronics in Huaqiangbei, furniture in Foshan, pet accessories in Guangzhou, hardware in Dongguan.</p>
          <p>No other Ireland-facing sourcing service has this dual-province setup.</p>
          <a href="/china-network/" class="btn btn--secondary" style="margin-top: 0.5rem;">See the full network →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================
       TESTIMONIALS — rendered only when live quotes exist
       ================================================ -->
  <TestimonialsSection
    items={homepageQuotes}
    layout="grid"
    eyebrow="What clients say"
    heading="Real results, real Irish businesses."
    bg="white"
  />

  <!-- ================================================
       FAQ — visible Q&A for PAA + GEO signals
       ================================================ -->
  <section class="section section--alt faq-section">
    <div class="container">
      <div class="faq-header">
        <span class="section-eyebrow">Common questions</span>
        <h2>Frequently asked questions</h2>
      </div>
      <FAQAccordion items={faqs} firstOpen={true} />
    </div>
  </section>

  <!-- ================================================
       FINAL CTA — emerald brand section
       ================================================ -->
  <section class="section--emerald cta-section">
    <div class="container--narrow">
      <span class="section-eyebrow section-eyebrow--light">No obligation</span>
      <h2>Ready to pay factory prices?</h2>
      <p>Tell us what you're looking for. We'll come back with real factory pricing, a supplier shortlist, and a timeline — no hard sell, no long process. Direct reply from Noel within 24 hours.</p>
      <div class="cta-actions">
        <a href="/contact/" class="btn btn--white">Get a Quote →</a>
        <a href="https://wa.me/353871187806" class="btn btn--white-outline" target="_blank" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          WhatsApp Noel
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ===================== HERO ===================== */
  .hero {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(8, 22, 14, 0.94) 0%,
      rgba(8, 22, 14, 0.78) 45%,
      rgba(8, 22, 14, 0.55) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding-bottom: 5rem;
    padding-top: 2rem;
    max-width: 900px;
  }

  .hero-eyebrow {
    font-size: 0.8125rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.88);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1.25rem;
    display: block;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.45);
  }

  .hero-content h1 {
    color: #ffffff;
    font-size: clamp(2rem, 6vw, 5rem);
    line-height: 1.05;
    margin-bottom: 1.5rem;
    letter-spacing: -0.03em;
    text-shadow: 0 1px 22px rgba(0, 0, 0, 0.5);
  }

  .hero-sub {
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    color: #f4f4f1;
    line-height: 1.7;
    margin-bottom: 2.5rem;
    max-width: 620px;
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.5);
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* ===================== TRUST BAR ===================== */
  .trust-bar {
    background-color: #ffffff;
    border-bottom: 1px solid rgba(15, 33, 49, 0.08);
    padding: 2.5rem 0;
  }

  .stats-row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    flex: 1;
    text-align: center;
  }

  .stat-figure {
    font-family: var(--font-body);
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 700;
    color: #1A533E;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .stat-label {
    font-size: 0.875rem;
    color: #6b6b6b;
    line-height: 1.4;
  }

  .stat-divider {
    width: 1px;
    height: 48px;
    background-color: rgba(15, 33, 49, 0.1);
    flex-shrink: 0;
  }

