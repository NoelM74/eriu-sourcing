---
// German landing pages for Germany and Austria, data in src/data/dePages.js.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { dePages } from '../../data/dePages.js';
import { translations } from '../../data/i18n.js';

export function getStaticPaths() {
  return dePages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
const siteUrl = 'https://eriusourcing.com';
const canonical = `/de/${page.slug}/`;
const enHref = translations.find((t) => t.de === canonical)?.en;

const pageSchemas = [
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Startseite", "item": `${siteUrl}/de/` },
      { "@type": "ListItem", "position": 2, "name": page.eyebrow, "item": `${siteUrl}${canonical}` }
    ]
  },
  {
    "@type": "Service",
    "name": page.h1,
    "description": page.description,
    "inLanguage": "de",
    "provider": { "@type": "ProfessionalService", "@id": `${siteUrl}/#organization` },
    "areaServed": [
      { "@type": "Country", "name": "Germany" },
      { "@type": "Country", "name": "Austria" }
    ],
    "dateModified": new Date().toISOString().split('T')[0]
  },
  {
    "@type": "FAQPage",
    "inLanguage": "de",
    "mainEntity": page.faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  }
];

const steps = [
  { h: 'Anfrage', p: 'Sie senden Ihre Liste oder Spezifikation, gern als Tabelle. Schreiben Sie auf Deutsch oder Englisch.' },
  { h: 'Angebot', p: 'Preise je Artikel, FOB China oder geliefert nach Deutschland bzw. Österreich, mit den Unterlagen der Fabrik.' },
  { h: 'Einkauf und Prüfung', p: 'Wir kaufen vor Ort, prüfen Ware und Unterlagen und sortieren aus, was nicht besteht.' },
  { h: 'Versand', p: 'Übergabe an Ihren Spediteur im chinesischen Hafen oder Lieferung bis zu Ihnen. Batterien als Gefahrgut.' },
  { h: 'Nachbestellen', p: 'Feste Listen für Ihre Schnelldreher, die wir regelmäßig auffüllen.' },
];
---

<BaseLayout title={page.title} description={page.description} canonical={canonical} ogImage={page.image} ogImageAlt={page.imageAlt} jsonLd={pageSchemas}>

  <section class="page-hero">
    <div class="hero-bg">
      <img src={page.image} alt={page.imageAlt} width="1216" height="832" loading="eager" fetchpriority="high" />
      <div class="hero-overlay"></div>
    </div>
    <div class="hero-content container">
      <span class="hero-eyebrow">{page.eyebrow}</span>
      <h1>{page.h1}</h1>
      <p class="hero-sub">{page.sub}</p>
      <div class="hero-actions">
        <a href="/de/kontakt/" class="btn btn--white">{page.cta} →</a>
        <a href="#pruefung" class="btn btn--white-outline">Was wir prüfen</a>
      </div>
      {enHref && <p class="hero-lang"><a href={enHref} hreflang="en" lang="en">English version →</a></p>}
    </div>
  </section>

  <section class="trust-bar">
    <div class="container">
      <div class="trust-grid">
        {page.trust.map((t, i) => (
          <Fragment>
            {i > 0 && <div class="trust-divider"></div>}
            <div class="trust-item">
              <span class="trust-num">{t.num}</span>
              <span class="trust-label">{t.label}</span>
            </div>
          </Fragment>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="split-grid">
        <div class="split-content">
          <span class="section-eyebrow">{page.problem.eyebrow}</span>
          <h2>{page.problem.h2}</h2>
          {page.problem.paras.map((p) => <p>{p}</p>)}
          <ul class="tick-list">
            {page.problem.bullets.map((b) => <li>{b}</li>)}
          </ul>
          <p>{page.problem.after}</p>
        </div>
        <div class="split-image">
          <img src={page.problem.image} alt={page.problem.imageAlt} width="1216" height="832" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt" id="pruefung" style="padding-top:0">
    <div class="container">
      <div class="products-layout">
        <div class="products-header">
          <span class="section-eyebrow">{page.checks.eyebrow}</span>
          <h2>{page.checks.h2}</h2>
          <p>{page.checks.intro}</p>
        </div>
        <ul class="products-list">
          {page.checks.items.map(([strong, text]) => (
            <li><span class="product-check">✓</span><span><strong>{strong}:</strong> {text}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="section-eyebrow">Lieferung</span>
      <h2>FOB China oder geliefert nach Deutschland und Österreich</h2>
      <div class="cat-grid cat-grid--2">
        <div class="cat-card cat-card--static">
          <h3>FOB China (Standard)</h3>
          <p>Wir kaufen, prüfen und übergeben die Ware im chinesischen Abgangshafen an Ihren Spediteur. Fracht, Verzollung und Einfuhrumsatzsteuer laufen über Ihren Spediteur bzw. Zollagenten. Sie behalten die volle Kontrolle über Logistik und Kosten.</p>
        </div>
        <div class="cat-card cat-card--static">
          <h3>Geliefert (auf Wunsch)</h3>
          <p>Auf Wunsch organisieren wir den Transport bis zu Ihrer Adresse in Deutschland oder Österreich. Sie erhalten dann ein Angebot inklusive Fracht. Batterien und Geräte mit Lithiumakkus reisen als Gefahrgut auf dafür zugelassenen Routen.</p>
        </div>
      </div>
      {page.lines && (
        <Fragment>
          <h3 class="lines-h">Passend dazu</h3>
          <div class="cat-grid">
            {page.lines.map((l) => (
              <a href={l.href} class="cat-card cat-card--link">
                <h3>{l.h} →</h3>
                <p>{l.p}</p>
              </a>
            ))}
          </div>
        </Fragment>
      )}
    </div>
  </section>

  <section class="section section--emerald">
    <div class="container--narrow">
      <span class="section-eyebrow section-eyebrow--light">{page.rules.eyebrow}</span>
      <h2>{page.rules.h2}</h2>
      {page.rules.paras.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="section-eyebrow">Ablauf</span>
      <h2>Von Ihrer Anfrage bis zur Lieferung</h2>
      <div class="process-steps">
        {steps.map((s, i) => (
          <div class="process-step">
            <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.h}</h3>
            <p>{s.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container--narrow">
      <span class="section-eyebrow">Passt das zu Ihnen?</span>
      <h2>Das passt, wenn …</h2>
      <ul class="tick-list tick-list--lg">
        {page.fit.map((f) => <li>{f}</li>)}
      </ul>
      <p class="fit-note">{page.fitNote}</p>
    </div>
  </section>

  <section class="section">
    <div class="container--narrow">
      <span class="section-eyebrow">Häufige Fragen</span>
      <h2>Fragen und Antworten</h2>
      <p class="faq-updated">Zuletzt geprüft: Oktober 2026</p>
      <div class="faq-list">
        {page.faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--emerald">
    <div class="container--narrow" style="text-align:center">
      <span class="section-eyebrow section-eyebrow--light">Unverbindlich anfragen</span>
      <h2>{page.ctaH2}</h2>
      <p>{page.ctaP}</p>
      <a href="/de/kontakt/" class="btn btn--white-outline" style="margin-top:1rem">{page.cta} →</a>
      <p class="cta-note">Schreiben Sie gern auf Deutsch; unser Team antwortet auf Englisch.</p>
    </div>
  </section>

</BaseLayout>

<style>
  /* HERO */
  .page-hero {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .hero-bg { position: absolute; inset: 0; }
  .hero-bg img { width: 100%; height: 100%; object-fit: cover; object-position: center 40%; }
  .hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(10, 28, 18, .9) 0%, rgba(10, 28, 18, .55) 50%, rgba(10, 28, 18, .2) 100%);
  }
  .hero-content { position: relative; z-index: 2; padding-block: 4rem 5rem; max-width: 900px; }
  .hero-eyebrow {
    font-size: .8125rem; font-weight: 700; color: rgba(255,255,255, .65);
    text-transform: uppercase; letter-spacing: .1em; margin-bottom: 1.25rem; display: block;
  }
  .hero-content h1 {
    color: #fff; font-size: clamp(2.25rem, 5vw, 4rem); line-height: 1.05;
    margin-bottom: 1.5rem; letter-spacing: -.03em;
  }
  .hero-sub {
    font-size: clamp(1rem, 1.5vw, 1.1875rem); color: rgba(255,255,255, .82);
    line-height: 1.7; margin-bottom: 2rem; max-width: 640px;
  }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }

  /* TRUST BAR */
  .trust-bar { background: #fff; border-bottom: 1px solid rgba(15, 33, 49, .08); padding: 2.5rem 0; }
  .trust-grid { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
  .trust-item { display: flex; flex-direction: column; gap: .25rem; flex: 1; min-width: 160px; }
  .trust-num {
    font-family: var(--font-body); font-size: clamp(1.25rem, 2.5vw, 1.875rem);
    font-weight: 700; color: var(--color-emerald); line-height: 1; letter-spacing: -.03em;
  }
  .trust-label { font-size: .875rem; color: #5a5a5a; }
  .trust-divider { width: 1px; height: 48px; background: rgba(15, 33, 49, .12); flex-shrink: 0; }

  /* SPLITS */
  .split-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
  .split-grid--reverse { direction: rtl; }
  .split-grid--reverse > * { direction: ltr; }
  .split-content h2 { margin-bottom: 1.25rem; }
  .split-content p { color: #3a3a3a; margin-bottom: 1rem; }
  .split-image img { width: 100%; height: 420px; object-fit: cover; border-radius: 12px; }
  .inline-link { color: var(--color-emerald); font-weight: 600; font-size: .9375rem; text-decoration: none; }
  .inline-link:hover { text-decoration: underline; }

  /* TICK LISTS */
  .tick-list { list-style: none; margin: 0 0 1.25rem; padding: 0; display: flex; flex-direction: column; gap: .625rem; }
  .tick-list li { position: relative; padding-left: 1.5rem; color: #3a3a3a; line-height: 1.55; }
  .tick-list li::before { content: '✓'; position: absolute; left: 0; color: var(--color-emerald); font-weight: 700; }
  .tick-list--lg li { font-size: 1.0625rem; color: var(--color-navy); }
  .fit-note { color: var(--color-slate); font-size: .9375rem; margin-top: 1rem; }

  /* HARDWARE CARDS */
  .cat-intro { color: var(--color-slate); max-width: 70ch; margin: 1rem 0 2rem; }
  .cat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .cat-grid--2 { grid-template-columns: 1fr 1fr; }
  .cat-card {
    display: block; padding: 1.5rem; background: var(--color-white);
    border: 1px solid rgba(15, 33, 49, .09); border-radius: 12px;
    text-decoration: none; color: inherit;
  }
  .hero-lang { margin: 1.25rem 0 0; font-size: .875rem; }
  .hero-lang a { color: rgba(255,255,255,.8); }
  .lines-h { margin: 2.5rem 0 1rem; font-size: 1.125rem; color: var(--color-navy); }
  .cta-note { font-size: .875rem; opacity: .8; margin-top: 1rem; }
  .cat-card--link { transition: border-color .15s ease, transform .15s ease; }
  .cat-card--link:hover { border-color: var(--color-emerald); transform: translateY(-2px); }
  .cat-card--link h3 { font-size: 1.0625rem; color: var(--color-emerald); margin: 0 0 .625rem; }
  .cat-card--link p { font-size: .9375rem; color: #3a3a3a; margin: 0; line-height: 1.6; }
  .cat-card--static h3 { font-size: 1.0625rem; color: var(--color-navy); margin: 0 0 .625rem; }
  .cat-card--static p { font-size: .9375rem; color: #3a3a3a; margin: 0; line-height: 1.6; }
  .cat-note { color: var(--color-slate); font-size: .9375rem; margin-top: 1.5rem; max-width: 70ch; }

  /* PRODUCTS LAYOUT */
  .products-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; }
  .products-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .875rem; }
  .products-list li { display: flex; align-items: flex-start; gap: .75rem; font-size: 1rem; color: var(--color-navy); line-height: 1.5; }
  .product-check { color: var(--color-emerald); font-weight: 700; flex-shrink: 0; margin-top: .1em; }
  .products-header p { color: var(--color-slate); margin-top: 1rem; }

  /* PROCESS STEPS */
  .process-steps { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0; margin-top: 2.5rem; }
  .process-step { padding: 2rem 1.25rem 2rem 0; border-top: 2px solid var(--color-emerald); }
  .step-num {
    display: block; font-family: var(--font-body); font-size: 2.5rem; font-weight: 700;
    color: var(--color-teal); opacity: .35; line-height: 1; margin-bottom: .75rem; letter-spacing: -.04em;
  }
  .process-step h3 { font-size: 1rem; font-weight: 700; margin-bottom: .5rem; color: var(--color-navy); }
  .process-step p { font-size: .9375rem; color: #4a4a4a; max-width: 100%; margin: 0; }

  /* FAQ */
  .faq-updated { font-size: .8125rem; color: #888; margin: .25rem 0 1.5rem; }
  .faq-list { display: flex; flex-direction: column; gap: 0; margin-top: 1rem; }
  .faq-item { border-bottom: 1px solid rgba(15, 33, 49, .1); padding: 0; }
  .faq-item summary {
    font-weight: 600; font-size: 1rem; color: var(--color-navy); cursor: pointer;
    padding: 1.25rem 0; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 1rem;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after {
    content: '+'; font-size: 1.25rem; font-weight: 300; color: var(--color-emerald);
    flex-shrink: 0; transition: transform .2s ease;
  }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item p { padding: 0 0 1.25rem; color: #4a4a4a; font-size: .9375rem; margin: 0; line-height: 1.65; }

  @media (max-width: 900px) {
    .split-grid, .split-grid--reverse { grid-template-columns: 1fr; gap: 2rem; direction: ltr; }
    .split-image img { height: 280px; }
    .products-layout { grid-template-columns: 1fr; gap: 2rem; }
    .cat-grid, .cat-grid--2 { grid-template-columns: 1fr; }
    .process-steps { grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .process-step { padding: 1.5rem 0 0; }
    .trust-divider { display: none; }
  }
  @media (max-width: 600px) {
    .process-steps { grid-template-columns: 1fr; }
    .hero-actions { flex-direction: column; }
    .trust-grid { gap: 1rem; }
  }
</style>
