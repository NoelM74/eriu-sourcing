---
// German hub for Germany and Austria: electronics sourcing from Shenzhen.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { dePages } from '../../data/dePages.js';
import { deArticles } from '../../data/deArticles.js';

const title = "Elektronik aus Shenzhen für Händler in DE & AT | Ériu";
const description = "Elektronik ab Fabrik in Shenzhen für Händler, Reparaturbetriebe und Installateure in Deutschland und Österreich: geprüft vor dem Versand, FOB oder geliefert.";
const siteUrl = 'https://eriusourcing.com';

const faqs = [
  { q: 'Wer ist Ériu Sourcing?', a: 'Ein irisch geführtes Sourcing-Unternehmen mit eigenem Standort in Shenzhen und 18 Jahren Erfahrung in China. Wir finden die passenden Fabriken, prüfen Ware und Unterlagen vor dem Versand und übergeben die Ware FOB China an Ihren Spediteur oder liefern auf Wunsch bis zu Ihnen.' },
  { q: 'Liefern Sie nach Deutschland und Österreich?', a: 'Ja. Standard ist FOB China: Ihr Spediteur übernimmt die Ware im chinesischen Hafen. Auf Wunsch organisieren wir die Lieferung bis zu Ihrer Adresse in Deutschland oder Österreich.' },
  { q: 'Sprechen Sie Deutsch?', a: 'Sie können uns gern auf Deutsch schreiben. Unser Team antwortet auf Englisch, auch Angebote und Prüfberichte sind auf Englisch.' },
  { q: 'Welche Registrierungen brauche ich als Importeur in Deutschland?', a: 'Je nach Produkt unter anderem die Registrierung bei der stiftung ear nach ElektroG und nach dem Batterierecht sowie die Registrierung im Verpackungsregister LUCID nach dem Verpackungsgesetz. In Österreich gelten eigene Melde- und Lizenzierungspflichten. Wir weisen im Angebot darauf hin; die Registrierung selbst liegt bei Ihnen als Inverkehrbringer.' },
];

const pageSchemas = [
  {
    "@type": "Service",
    "name": "Elektronik-Sourcing aus Shenzhen für Deutschland und Österreich",
    "description": description,
    "inLanguage": "de",
    "provider": { "@type": "ProfessionalService", "@id": `${siteUrl}/#organization` },
    "areaServed": [ { "@type": "Country", "name": "Germany" }, { "@type": "Country", "name": "Austria" } ]
  },
  {
    "@type": "FAQPage",
    "inLanguage": "de",
    "mainEntity": faqs.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
  }
];
---

<BaseLayout title={title} description={description} canonical="/de/" ogImage="/images/shenzhen-phone-market-trading-floor.webp" ogImageAlt="Verkaufstheken auf einer Etage eines Handymarkts in Shenzhen" jsonLd={pageSchemas}>

  <section class="page-hero">
    <div class="hero-bg">
      <img src="/images/shenzhen-phone-market-trading-floor.webp" alt="Verkaufstheken auf einer Etage eines Handymarkts in Shenzhen" width="1216" height="832" loading="eager" fetchpriority="high" />
      <div class="hero-overlay"></div>
    </div>
    <div class="hero-content container">
      <span class="hero-eyebrow">Elektronik-Sourcing für Deutschland und Österreich</span>
      <h1>Elektronik direkt aus Shenzhen, geprüft bevor sie versendet wird.</h1>
      <p class="hero-sub">Für Handyläden, Reparaturbetriebe, Händler, Marken und Installateure. Wir finden die Fabriken, prüfen Ware und Unterlagen vor Ort und übergeben FOB China an Ihren Spediteur, oder liefern auf Wunsch bis zu Ihnen.</p>
      <div class="hero-actions">
        <a href="/de/kontakt/" class="btn btn--white">Anfrage senden →</a>
        <a href="#bereiche" class="btn btn--white-outline">Unsere Bereiche</a>
      </div>
      <p class="hero-lang"><a href="/source/electronics-from-china-ireland/" hreflang="en" lang="en">English version →</a></p>
    </div>
  </section>

  <section class="trust-bar">
    <div class="container">
      <div class="trust-grid">
        <div class="trust-item"><span class="trust-num">18 Jahre</span><span class="trust-label">Erfahrung in China</span></div>
        <div class="trust-divider"></div>
        <div class="trust-item"><span class="trust-num">Shenzhen</span><span class="trust-label">Eigener Standort vor Ort</span></div>
        <div class="trust-divider"></div>
        <div class="trust-item"><span class="trust-num">Vor dem Versand</span><span class="trust-label">Ware und Unterlagen geprüft</span></div>
        <div class="trust-divider"></div>
        <div class="trust-item"><span class="trust-num">FOB oder frei Haus</span><span class="trust-label">Sie entscheiden</span></div>
      </div>
    </div>
  </section>

  <section class="section" id="bereiche">
    <div class="container">
      <span class="section-eyebrow">Unsere Bereiche</span>
      <h2>Was wir für den deutschen und österreichischen Markt beschaffen</h2>
      <div class="cat-grid">
        {dePages.map((p) => (
          <a href={`/de/${p.slug}/`} class="cat-card cat-card--link">
            <h3>{p.title.split(' | ')[0].replace(/ aus (China|Shenzhen)$/, '')} →</h3>
            <p>{p.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="products-layout">
        <div class="products-header">
          <span class="section-eyebrow">Für den deutschen Markt</span>
          <h2>Verkehrsfähig ist mehr als CE</h2>
          <p>Wer Elektronik in Deutschland oder Österreich in Verkehr bringt, hat Pflichten, die über das CE-Zeichen hinausgehen. Wir prüfen die Unterlagen der Fabrik und weisen im Angebot auf Ihre Registrierungen hin.</p>
        </div>
        <ul class="products-list">
          <li><span class="product-check">✓</span><span><strong>ElektroG:</strong> Registrierung bei der stiftung ear vor dem Inverkehrbringen</span></li>
          <li><span class="product-check">✓</span><span><strong>Batterierecht:</strong> EU-Batterieverordnung und Batterierecht-Durchführungsgesetz (seit Oktober 2025)</span></li>
          <li><span class="product-check">✓</span><span><strong>Verpackungsgesetz:</strong> Registrierung im Verpackungsregister LUCID</span></li>
          <li><span class="product-check">✓</span><span><strong>Funk:</strong> RED inklusive Cybersicherheit seit 1. August 2025</span></li>
          <li><span class="product-check">✓</span><span><strong>Produktsicherheit:</strong> Herstellerangaben und verantwortlicher Wirtschaftsakteur in der EU nach der EU-Produktsicherheitsverordnung</span></li>
          <li><span class="product-check">✓</span><span><strong>Österreich:</strong> eigene Melde- und Lizenzierungspflichten für Elektrogeräte, Batterien und Verpackungen</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section" id="ratgeber">
    <div class="container">
      <span class="section-eyebrow">Ratgeber</span>
      <h2>Wissen für Ihren Einkauf</h2>
      <div class="cat-grid cat-grid--2">
        {deArticles.map((a) => (
          <a href={`/de/ratgeber/${a.slug}/`} class="cat-card cat-card--link">
            <h3>{a.h1} →</h3>
            <p>{a.excerpt}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container--narrow">
      <span class="section-eyebrow">Häufige Fragen</span>
      <h2>Fragen und Antworten</h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--emerald">
    <div class="container--narrow" style="text-align:center">
      <span class="section-eyebrow section-eyebrow--light">Unverbindlich anfragen</span>
      <h2>Was möchten Sie beschaffen?</h2>
      <p>Senden Sie uns Ihre Liste oder Spezifikation. Sie erhalten geprüfte Fabrikoptionen mit Preisen, FOB China oder geliefert.</p>
      <a href="/de/kontakt/" class="btn btn--white-outline" style="margin-top:1rem">Anfrage senden →</a>
      <p class="cta-note">Schreiben Sie gern auf Deutsch; unser Team antwortet auf Englisch.</p>
    </div>
  </section>

</BaseLayout>

<style>
  /* HERO */
  .page-hero {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .hero-bg { position: absolute; inset: 0; }
  .hero-bg img { width: 100%; height: 100%; object-fit: cover; object-position: center 40%; }
  .hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(10, 28, 18, .9) 0%, rgba(10, 28, 18, .55) 50%, rgba(10, 28, 18, .2) 100%);
  }
  .hero-content { position: relative; z-index: 2; padding-block: 4rem 5rem; max-width: 900px; }
  .hero-eyebrow {
    font-size: .8125rem; font-weight: 700; color: rgba(255,255,255, .65);
    text-transform: uppercase; letter-spacing: .1em; margin-bottom: 1.25rem; display: block;
  }
  .hero-content h1 {
    color: #fff; font-size: clamp(2.25rem, 5vw, 4rem); line-height: 1.05;
    margin-bottom: 1.5rem; letter-spacing: -.03em;
  }
  .hero-sub {
    font-size: clamp(1rem, 1.5vw, 1.1875rem); color: rgba(255,255,255, .82);
    line-height: 1.7; margin-bottom: 2rem; max-width: 640px;
  }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }

  /* TRUST BAR */
  .trust-bar { background: #fff; border-bottom: 1px solid rgba(15, 33, 49, .08); padding: 2.5rem 0; }
  .trust-grid { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
  .trust-item { display: flex; flex-direction: column; gap: .25rem; flex: 1; min-width: 160px; }
  .trust-num {
    font-family: var(--font-body); font-size: clamp(1.25rem, 2.5vw, 1.875rem);
    font-weight: 700; color: var(--color-emerald); line-height: 1; letter-spacing: -.03em;
  }
  .trust-label { font-size: .875rem; color: #5a5a5a; }
  .trust-divider { width: 1px; height: 48px; background: rgba(15, 33, 49, .12); flex-shrink: 0; }

  /* SPLITS */
  .split-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
  .split-grid--reverse { direction: rtl; }
  .split-grid--reverse > * { direction: ltr; }
  .split-content h2 { margin-bottom: 1.25rem; }
  .split-content p { color: #3a3a3a; margin-bottom: 1rem; }
  .split-image img { width: 100%; height: 420px; object-fit: cover; border-radius: 12px; }
  .inline-link { color: var(--color-emerald); font-weight: 600; font-size: .9375rem; text-decoration: none; }
  .inline-link:hover { text-decoration: underline; }

  /* TICK LISTS */
  .tick-list { list-style: none; margin: 0 0 1.25rem; padding: 0; display: flex; flex-direction: column; gap: .625rem; }
  .tick-list li { position: relative; padding-left: 1.5rem; color: #3a3a3a; line-height: 1.55; }
  .tick-list li::before { content: '✓'; position: absolute; left: 0; color: var(--color-emerald); font-weight: 700; }
  .tick-list--lg li { font-size: 1.0625rem; color: var(--color-navy); }
  .fit-note { color: var(--color-slate); font-size: .9375rem; margin-top: 1rem; }

  /* HARDWARE CARDS */
  .cat-intro { color: var(--color-slate); max-width: 70ch; margin: 1rem 0 2rem; }
  .cat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .cat-grid--2 { grid-template-columns: 1fr 1fr; }
  .cat-card {
    display: block; padding: 1.5rem; background: var(--color-white);
    border: 1px solid rgba(15, 33, 49, .09); border-radius: 12px;
    text-decoration: none; color: inherit;
  }
  .hero-lang { margin: 1.25rem 0 0; font-size: .875rem; }
  .hero-lang a { color: rgba(255,255,255,.8); }
  .lines-h { margin: 2.5rem 0 1rem; font-size: 1.125rem; color: var(--color-navy); }
  .cta-note { font-size: .875rem; opacity: .8; margin-top: 1rem; }
  .cat-card--link { transition: border-color .15s ease, transform .15s ease; }
  .cat-card--link:hover { border-color: var(--color-emerald); transform: translateY(-2px); }
  .cat-card--link h3 { font-size: 1.0625rem; color: var(--color-emerald); margin: 0 0 .625rem; }
  .cat-card--link p { font-size: .9375rem; color: #3a3a3a; margin: 0; line-height: 1.6; }
  .cat-card--static h3 { font-size: 1.0625rem; color: var(--color-navy); margin: 0 0 .625rem; }
  .cat-card--static p { font-size: .9375rem; color: #3a3a3a; margin: 0; line-height: 1.6; }
  .cat-note { color: var(--color-slate); font-size: .9375rem; margin-top: 1.5rem; max-width: 70ch; }

  /* PRODUCTS LAYOUT */
  .products-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; }
  .products-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .875rem; }
  .products-list li { display: flex; align-items: flex-start; gap: .75rem; font-size: 1rem; color: var(--color-navy); line-height: 1.5; }
  .product-check { color: var(--color-emerald); font-weight: 700; flex-shrink: 0; margin-top: .1em; }
  .products-header p { color: var(--color-slate); margin-top: 1rem; }

  /* PROCESS STEPS */
  .process-steps { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0; margin-top: 2.5rem; }
  .process-step { padding: 2rem 1.25rem 2rem 0; border-top: 2px solid var(--color-emerald); }
  .step-num {
    display: block; font-family: var(--font-body); font-size: 2.5rem; font-weight: 700;
    color: var(--color-teal); opacity: .35; line-height: 1; margin-bottom: .75rem; letter-spacing: -.04em;
  }
  .process-step h3 { font-size: 1rem; font-weight: 700; margin-bottom: .5rem; color: var(--color-navy); }
  .process-step p { font-size: .9375rem; color: #4a4a4a; max-width: 100%; margin: 0; }

  /* FAQ */
  .faq-updated { font-size: .8125rem; color: #888; margin: .25rem 0 1.5rem; }
  .faq-list { display: flex; flex-direction: column; gap: 0; margin-top: 1rem; }
  .faq-item { border-bottom: 1px solid rgba(15, 33, 49, .1); padding: 0; }
  .faq-item summary {
    font-weight: 600; font-size: 1rem; color: var(--color-navy); cursor: pointer;
    padding: 1.25rem 0; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 1rem;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after {
    content: '+'; font-size: 1.25rem; font-weight: 300; color: var(--color-emerald);
    flex-shrink: 0; transition: transform .2s ease;
  }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item p { padding: 0 0 1.25rem; color: #4a4a4a; font-size: .9375rem; margin: 0; line-height: 1.65; }

  @media (max-width: 900px) {
    .split-grid, .split-grid--reverse { grid-template-columns: 1fr; gap: 2rem; direction: ltr; }
    .split-image img { height: 280px; }
    .products-layout { grid-template-columns: 1fr; gap: 2rem; }
    .cat-grid, .cat-grid--2 { grid-template-columns: 1fr; }
    .process-steps { grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .process-step { padding: 1.5rem 0 0; }
    .trust-divider { display: none; }
  }
  @media (max-width: 600px) {
    .process-steps { grid-template-columns: 1fr; }
    .hero-actions { flex-direction: column; }
    .trust-grid { gap: 1rem; }
  }
</style>
