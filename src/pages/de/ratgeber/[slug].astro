---
// German guides (Ratgeber), data in src/data/deArticles.js.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { deArticles } from '../../../data/deArticles.js';
import { translations } from '../../../data/i18n.js';

export function getStaticPaths() {
  return deArticles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
const siteUrl = 'https://eriusourcing.com';
const canonical = `/de/ratgeber/${article.slug}/`;
const enHref = translations.find((t) => t.de === canonical)?.en;
const dateDe = new Date(article.publishDate).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' });

const pageSchemas = [
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Startseite", "item": `${siteUrl}/de/` },
      { "@type": "ListItem", "position": 2, "name": "Ratgeber", "item": `${siteUrl}/de/#ratgeber` },
      { "@type": "ListItem", "position": 3, "name": article.h1, "item": `${siteUrl}${canonical}` }
    ]
  },
  {
    "@type": "Article",
    "headline": article.h1,
    "description": article.description,
    "inLanguage": "de",
    "datePublished": article.publishDate,
    "dateModified": article.publishDate,
    "image": `${siteUrl}${article.image}`,
    "author": { "@type": "Organization", "@id": `${siteUrl}/#organization` },
    "publisher": { "@type": "Organization", "@id": `${siteUrl}/#organization` },
    "mainEntityOfPage": `${siteUrl}${canonical}`
  },
  {
    "@type": "FAQPage",
    "inLanguage": "de",
    "mainEntity": article.faq.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  }
];
---

<BaseLayout title={article.title} description={article.description} canonical={canonical} ogImage={article.image} ogImageAlt={article.imageAlt} ogType="article" jsonLd={pageSchemas}>
  <article class="de-article">
    <div class="container--narrow">
      <nav class="crumbs" aria-label="Brotkrumen"><a href="/de/">Startseite</a> / <a href="/de/#ratgeber">Ratgeber</a></nav>
      <span class="section-eyebrow">{article.eyebrow}</span>
      <h1>{article.h1}</h1>
      <p class="meta">Veröffentlicht am {dateDe} · Ériu Sourcing{enHref && <Fragment> · <a href={enHref} hreflang="en" lang="en">English version</a></Fragment>}</p>
      <img class="hero-img" src={article.image} alt={article.imageAlt} width="1216" height="832" loading="eager" fetchpriority="high" />
      <div class="article-content" set:html={article.body} />

      <section class="faq">
        <h2>Häufige Fragen</h2>
        {article.faq.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>

      <div class="cta-box">
        <h2>Einkauf direkt ab Shenzhen, geprüft vor dem Versand</h2>
        <p>Senden Sie uns Ihre Liste. Sie erhalten Preise FOB China oder geliefert nach Deutschland und Österreich. Schreiben Sie gern auf Deutsch; unser Team antwortet auf Englisch.</p>
        <a href="/contact/" class="btn btn--primary">Anfrage senden →</a>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .de-article { padding: 3rem 0 4.5rem; }
  .crumbs { font-size: .8125rem; color: #6b6b6b; margin-bottom: 1.25rem; }
  .crumbs a { color: inherit; }
  .de-article h1 { font-size: clamp(1.75rem, 3.6vw, 2.5rem); line-height: 1.15; margin: .5rem 0 1rem; }
  .meta { font-size: .875rem; color: #6b6b6b; margin-bottom: 1.75rem; }
  .meta a { color: var(--color-emerald); }
  .hero-img { width: 100%; height: auto; border-radius: 12px; margin-bottom: 2rem; display: block; }

  .article-content { font-size: 1.0625rem; line-height: 1.75; color: #2a2a2a; max-width: 72ch; }
  .article-content :global(h2) { margin: 2.5rem 0 1rem; font-size: clamp(1.375rem, 2.5vw, 1.75rem); }
  .article-content :global(p) { margin: 0 0 1.25rem; }
  .article-content :global(ul) { margin: 0 0 1.25rem; padding-left: 1.5rem; }
  .article-content :global(li) { margin-bottom: .375rem; }
  .article-content :global(a) { color: var(--color-emerald); text-decoration: underline; text-underline-offset: 2px; }
  .article-content :global(.article-summary) {
    background: var(--color-teal-light); border-left: 4px solid var(--color-emerald);
    border-radius: 0 10px 10px 0; padding: 1.125rem 1.375rem; margin: 0 0 2rem;
    font-size: 1rem; line-height: 1.7; color: var(--color-navy);
  }
  .article-content :global(figure) { margin: 2rem 0 2.5rem; }
  .article-content :global(figure img) { width: 100%; height: auto; display: block; border-radius: 12px; }
  .article-content :global(figcaption) { font-size: .8125rem; color: #8a8a8a; text-align: center; padding-top: .625rem; font-style: italic; }

  .faq { margin-top: 3rem; }
  .faq-item { border-bottom: 1px solid rgba(15, 33, 49, .1); }
  .faq-item summary { font-weight: 600; cursor: pointer; padding: 1.125rem 0; list-style: none; color: var(--color-navy); }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item p { padding: 0 0 1.125rem; margin: 0; color: #4a4a4a; font-size: .9375rem; line-height: 1.65; }

  .cta-box { margin-top: 3rem; padding: 2rem; background: var(--color-bg-alt); border-radius: 12px; }
  .cta-box h2 { font-size: 1.375rem; margin: 0 0 .75rem; }
  .cta-box p { color: #3a3a3a; margin: 0 0 1.25rem; }
</style>
