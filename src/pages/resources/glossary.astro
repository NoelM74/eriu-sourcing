---
// China sourcing glossary: DefinedTermSet for search and AI answer engines.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { glossaryGroups, glossaryCount, termId } from '../../data/glossary.js';

const title = "China Sourcing Glossary: Terms Importers Need | Ériu";
const description = `${glossaryCount} China sourcing and import terms in plain English: FOB, AQL, MOQ, OEM vs ODM, CE marking, HS codes, telex release, IMEI and more.`;
const canonical = "/resources/glossary/";
const siteUrl = 'https://eriusourcing.com';
const pageSchemas = [
  { "@type": "BreadcrumbList", "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Resources", "item": `${siteUrl}/resources/` },
    { "@type": "ListItem", "position": 3, "name": "Glossary", "item": `${siteUrl}${canonical}` } ] },
  {
    "@type": "DefinedTermSet",
    "@id": `${siteUrl}${canonical}#glossary`,
    "name": "China sourcing glossary",
    "description": description,
    "hasDefinedTerm": glossaryGroups.flatMap((g) => g.terms.map((x) => ({
      "@type": "DefinedTerm",
      "name": x.t,
      "description": x.d,
      "url": `${siteUrl}${canonical}#${termId(x.t)}`,
      "inDefinedTermSet": `${siteUrl}${canonical}#glossary`
    })))
  }
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={pageSchemas}>
  <section class="g-hero">
    <div class="container--narrow">
      <nav class="g-crumbs" aria-label="Breadcrumb"><a href="/resources/">Resources</a> / Glossary</nav>
      <span class="section-eyebrow">Glossary</span>
      <h1>The China sourcing glossary</h1>
      <p class="g-lead">{glossaryCount} terms every importer meets when buying from China, explained in plain English by people who use them every day on factory floors in Shenzhen and Zhengzhou.</p>
      <nav class="g-jump" aria-label="Glossary sections">
        {glossaryGroups.map((g) => <a href={`#${g.id}`}>{g.name}</a>)}
      </nav>
    </div>
  </section>

  <section class="g-body">
    <div class="container--narrow">
      {glossaryGroups.map((g) => (
        <section class="g-group" id={g.id}>
          <h2>{g.name}</h2>
          <dl>
            {g.terms.map((x) => (
              <div class="g-term" id={termId(x.t)}>
                <dt>{x.t}</dt>
                <dd>{x.d}{x.l && <Fragment> <a href={x.l}>Read more →</a></Fragment>}</dd>
              </div>
            ))}
          </dl>
        </section>
      ))}
      <div class="g-cta">
        <h2>Rather not learn all of this the hard way?</h2>
        <p>Tell us what you want to buy. We'll tell you what applies to your product, what it should cost landed, and whether factory-direct makes sense for you.</p>
        <a href="/contact/" class="btn btn--primary">Get a sourcing quote →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .g-hero { padding: 3rem 0 2rem; background: var(--color-bg-alt); }
  .g-crumbs { font-size: .8125rem; color: #6b6b6b; margin-bottom: 1rem; }
  .g-crumbs a { color: inherit; }
  .g-hero h1 { font-size: clamp(2rem, 4.5vw, 3rem); margin: .5rem 0 1rem; }
  .g-lead { font-size: 1.125rem; color: #444; line-height: 1.7; max-width: 62ch; }
  .g-jump { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.5rem; }
  .g-jump a { font-size: .875rem; font-weight: 600; padding: .45rem .9rem; border-radius: 999px; background: #fff; border: 1px solid rgba(15,33,49,.12); color: var(--color-navy); text-decoration: none; }
  .g-jump a:hover { border-color: var(--color-emerald); color: var(--color-emerald); }
  .g-body { padding: 2rem 0 4.5rem; }
  .g-group { padding-top: 1.5rem; scroll-margin-top: 90px; }
  .g-group h2 { font-size: clamp(1.375rem, 2.6vw, 1.75rem); margin: 1.5rem 0 .75rem; padding-bottom: .5rem; border-bottom: 2px solid var(--color-emerald); }
  .g-term { padding: 1rem 0; border-bottom: 1px solid rgba(15,33,49,.08); scroll-margin-top: 90px; }
  .g-term:target { background: var(--color-teal-light); margin: 0 -1rem; padding: 1rem; border-radius: 8px; }
  .g-term dt { font-weight: 700; color: var(--color-navy); font-size: 1.0625rem; margin-bottom: .3rem; }
  .g-term dd { margin: 0; color: #3a3a3a; line-height: 1.65; }
  .g-term dd a { color: var(--color-emerald); font-weight: 600; white-space: nowrap; }
  .g-cta { margin-top: 3rem; padding: 2rem; background: var(--color-bg-alt); border-radius: 12px; }
  .g-cta h2 { font-size: 1.375rem; margin: 0 0 .75rem; }
  .g-cta p { color: #3a3a3a; margin: 0 0 1.25rem; }
</style>
