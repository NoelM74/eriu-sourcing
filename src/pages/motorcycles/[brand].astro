---
// One page per motorcycle brand. Data: src/data/motorcycles.js.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { motoBrands, motoTerms, motoTradeOnly, motoImg, motoContact } from '../../data/motorcycles.js';
import '../../styles/moto.css';

export function getStaticPaths() {
  return motoBrands.map((b) => ({ params: { brand: b.slug }, props: { b } }));
}

const { b } = Astro.props;
const siteUrl = 'https://eriusourcing.com';
const canonical = `/motorcycles/${b.slug}/`;
const kindTitle = b.slug === 'kymco' ? 'Scooters' : 'Motorcycles';
const title = `${b.name} ${kindTitle} Wholesale at Factory Prices | Ériu`;
const allNames = [...b.models.map((m) => m.name), ...b.also.map((m) => m.name)];
const listNames = (arr) => arr.length > 1 ? `${arr.slice(0, -1).join(', ')} and ${arr[arr.length - 1]}` : arr[0];
const description = `${b.name} ${b.kind} at factory prices for dealers: ${b.models.slice(0, 3).map((m) => m.name).join(', ')} and more. Wholesale only, inspected before shipping.`;
const others = motoBrands.filter((x) => x.slug !== b.slug);
const contactSlug = `motorcycles-${b.slug}`;

const faqs = [
  { q: `Can I buy ${b.name} ${b.kind} wholesale?`, a: `Yes. We supply ${b.name} ${b.kind} to dealers, importers and fleet operators at factory prices, FOB China or delivered to your country. We sell to the trade only, not single bikes to private riders.` },
  { q: `Which ${b.name} models can you supply?`, a: `${listNames(allNames)}. Tell us the models and quantities you want and we confirm availability in your quote.` },
  { q: `Can I mix ${b.name} with other brands in one order?`, a: `Yes. You can combine ${b.name} with Benda, Kove, Cyclone, Kymco and Lifan models in the same order. Freight and lead time are confirmed in your quote.` },
  { q: `Can I see the ${b.name} bikes before I order?`, a: 'Yes. You can visit and see the bikes in Zhengzhou by appointment, and we arrange the visit. Every order is inspected before it ships.' },
];

const pageSchemas = [
  { "@type": "BreadcrumbList", "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/` },
    { "@type": "ListItem", "position": 2, "name": "Motorcycles & Scooters", "item": `${siteUrl}/motorcycles/` },
    { "@type": "ListItem", "position": 3, "name": b.name, "item": `${siteUrl}${canonical}` } ] },
  {
    "@type": "Service",
    "name": `${b.name} ${b.kind} wholesale at factory prices`,
    "serviceType": "Motorcycle and scooter wholesale supply",
    "description": description,
    "provider": { "@type": "ProfessionalService", "@id": `${siteUrl}/#organization` },
    "areaServed": { "@type": "Place", "name": "Worldwide" },
    "brand": { "@type": "Brand", "name": b.name },
    "audience": { "@type": "BusinessAudience", "audienceType": "Motorcycle and scooter dealers, importers and fleet operators" }
  },
  {
    "@type": "ItemList",
    "name": `${b.name} models supplied by Ériu Sourcing`,
    "itemListElement": b.models.map((m, i) => ({ "@type": "ListItem", "position": i + 1, "name": `${b.name} ${m.name}`, "image": `${siteUrl}${motoImg(m.img)}.webp`, "description": `${m.type}: ${m.specs.join(', ')}` }))
  },
  { "@type": "FAQPage", "mainEntity": faqs.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })) }
];
---

<BaseLayout title={title} description={description} canonical={canonical} ogImage={`${b.cover.src}.webp`} ogImageAlt={b.cover.alt} jsonLd={pageSchemas} globalPage>
  <section class="mt-hero">
    <div class="container mt-hero-grid">
      <div>
        <nav class="mt-crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/motorcycles/">Motorcycles &amp; Scooters</a> / {b.name}</nav>
        <span class="mt-eyebrow">{b.focus} · Trade only</span>
        <h1>{b.name} {b.kind} wholesale, at factory prices.</h1>
        <p class="mt-lead">{b.story}</p>
        <div class="mt-actions">
          <a href={motoContact(contactSlug)} class="btn btn--white">Get {b.name} prices →</a>
          <a href="#range" class="btn btn--white-outline">See the range</a>
        </div>
      </div>
      <figure class="mt-hero-media">
        <img src={`${b.cover.src}.webp`} srcset={`${b.cover.src}-sm.webp 800w, ${b.cover.src}.webp ${b.cover.w}w`} sizes="(max-width: 820px) 100vw, 600px" alt={b.cover.alt} width={b.cover.w} height={b.cover.h} loading="eager" fetchpriority="high" />
        <figcaption>Photo: {b.name}.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section" id="range">
    <div class="container">
      <div class="mt-section-head fade-up">
        <span class="section-eyebrow">The {b.name} range</span>
        <h2>{b.tagline}</h2>
        <p>{b.dealerNote} Figures are {b.name}'s published specs.</p>
      </div>
      <div class="mt-models mt-models--five">
        {b.models.map((m) => (
          <article class="mt-model">
            <div class="mt-model-img"><img src={`${motoImg(m.img)}-sm.webp`} srcset={`${motoImg(m.img)}-sm.webp 640w, ${motoImg(m.img)}.webp ${m.w}w`} sizes="(max-width: 600px) 100vw, (max-width: 1024px) 50vw, 400px" alt={`${b.name} ${m.name} ${m.type.toLowerCase()}, side view`} width={m.w} height={m.h} loading="lazy" /></div>
            <div class="mt-model-body">
              <span class="mt-model-type">{m.type}</span>
              <h3>{b.name} {m.name}</h3>
              <ul class="mt-chips">{m.specs.map((s) => <li>{s}</li>)}</ul>
            </div>
          </article>
        ))}
      </div>
      {b.also.length > 0 && (
        <div class="mt-also">
          <h3>Also in the {b.name} range</h3>
          <ul>{b.also.map((m) => <li><strong>{b.name} {m.name}</strong><span>{m.specs.length ? m.specs.join(' · ') : 'Ask for details'}</span></li>)}</ul>
        </div>
      )}
      <p class="mt-credit">Product photos: {b.name}.</p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="mt-section-head">
        <span class="section-eyebrow">Trade terms</span>
        <h2>How you buy {b.name} through us.</h2>
      </div>
      <dl class="mt-terms">
        {motoTerms.map(([h, p]) => <div><dt>{h}</dt><dd>{p}</dd></div>)}
      </dl>
      <div class="mt-trade" style="margin-top:1.25rem">
        <div class="mt-trade-yes">
          <h3>Who this is for</h3>
          <ul>{motoTradeOnly.yes.map((t) => <li>{t}</li>)}</ul>
        </div>
        <div class="mt-trade-no">
          <h3>Who this is not for</h3>
          <ul>{motoTradeOnly.no.map((t) => <li>{t}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="mt-used">
        <div>
          <span class="mt-badge">Coming soon</span>
          <h2>Used {b.name} bikes, at unbeatable prices.</h2>
          <p>Used motorcycles and scooters from {b.name} and our other four brands, fully checked and refurbished before they are offered. Register your interest and we will contact you first.</p>
          <a href={motoContact('used-motorcycles')} class="btn btn--white">Register interest →</a>
        </div>
        <ul>
          <li>Fully checked</li>
          <li>Refurbished before sale</li>
          <li>For dealers and the trade</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container--narrow">
      <span class="section-eyebrow">Questions</span>
      <h2>{b.name} wholesale, answered.</h2>
      <div class="mt-faq">{faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="section-eyebrow">The other brands</span>
      <div class="mt-brands">
        {others.map((o) => (
          <a href={`/motorcycles/${o.slug}/`} class="mt-brand mt-brand--sm">
            <div class="mt-brand-img"><img src={`${o.cover.src}-sm.webp`} alt={o.cover.alt} width="800" height="450" loading="lazy" /></div>
            <div class="mt-brand-body">
              <span class="mt-brand-focus">{o.focus}</span>
              <h3>{o.name}</h3>
              <span class="mt-brand-link">See the {o.name} range →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section--emerald mt-cta">
    <div class="container--narrow">
      <h2>Ask for {b.name} factory prices.</h2>
      <p>Send the models and quantities you want. We reply with factory prices, freight and lead time, usually within 24 hours.</p>
      <div class="mt-actions">
        <a href={motoContact(contactSlug)} class="btn btn--white">Get {b.name} prices →</a>
        <a href="/motorcycles/" class="btn btn--white-outline">All brands</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Four "other brand" cards sit in an even 4-column row. */
  .mt-brands:has(.mt-brand--sm) { grid-template-columns: repeat(4, 1fr); }
  .mt-brand--sm, .mt-brand--sm:nth-child(4), .mt-brand--sm:nth-child(5) { grid-column: span 1; }
  @media (max-width: 1024px) { .mt-brands:has(.mt-brand--sm) { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .mt-brands:has(.mt-brand--sm) { grid-template-columns: 1fr; } }
</style>
