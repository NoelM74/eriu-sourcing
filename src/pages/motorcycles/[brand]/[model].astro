---
// One page per motorcycle/scooter model. Data: src/data/motorcycles.js (+ src/data/moto/*.json).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MotoCard from '../../../components/MotoCard.astro';
import { motoBrands, motoTerms, motoTradeOnly, motoContact, modelContactSlug, fullName } from '../../../data/motorcycles.js';
import '../../../styles/moto.css';

export function getStaticPaths() {
  return motoBrands.flatMap((b) => b.models.map((m) => ({ params: { brand: b.slug, model: m.slug }, props: { b, m } })));
}

const { b, m } = Astro.props;
const siteUrl = 'https://eriusourcing.com';
const canonical = m.url;
const name = fullName(m);
const k = m.key ?? {};
const title = `${name} Wholesale: Specs & Photos | Ériu`.length <= 62
  ? `${name} Wholesale: Specs & Photos | Ériu`
  : `${name} Wholesale | Ériu`;
const keyBits = [k.engine, k.power, k.weight].filter(Boolean);
const description = `${name} ${m.category.toLowerCase()} at factory prices for dealers${keyBits.length ? `: ${keyBits.join(', ')}` : ''}. Full specs and photos. Wholesale only.`.slice(0, 160);
const main = m.images[0];
const contact = motoContact(modelContactSlug(m));

const stats = [
  ['Engine', k.cc ? `${k.cc} cc` : null],
  ['Power', k.power],
  ['Torque', k.torque],
  ['Weight', k.weight],
  ['Seat', k.seat],
  ['Tank', k.tank],
].filter(([, v]) => v);

// Same brand, same category first, then the rest of the brand.
const more = [...b.models.filter((x) => x.slug !== m.slug && x.category === m.category), ...b.models.filter((x) => x.slug !== m.slug && x.category !== m.category)].slice(0, 4);

const specLine = [k.engine, k.power, k.torque && `${k.torque} torque`, k.weight, k.seat && `a ${k.seat} seat`].filter(Boolean).join(', ');
const faqs = [
  { q: `Can I buy the ${name} wholesale?`, a: `Yes. We supply the ${name} to dealers, importers and fleet operators at factory prices, FOB China or delivered to your country, with freight and lead time confirmed in your quote. We sell to the trade only, not single bikes to private riders.` },
  ...(specLine ? [{ q: `What are the ${name}'s main specifications?`, a: `The ${name} is a ${m.category.toLowerCase()} with ${specLine}. The full specification table on this page lists every figure ${b.name} publishes.` }] : []),
  { q: `Can I mix the ${name} with other models in one order?`, a: `Yes. You can combine the ${m.name} with other ${b.name} models and with Benda, Kove, Cyclone, Kymco and Lifan bikes in the same order.` },
  { q: `Can I see the ${name} before I order?`, a: 'Yes. You can visit and see the bikes in Zhengzhou by appointment, and we arrange the visit. Every order is inspected before it ships.' },
];

const pageSchemas = [
  { "@type": "BreadcrumbList", "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/` },
    { "@type": "ListItem", "position": 2, "name": "Motorcycles & Scooters", "item": `${siteUrl}/motorcycles/` },
    { "@type": "ListItem", "position": 3, "name": b.name, "item": `${siteUrl}${b.url}` },
    { "@type": "ListItem", "position": 4, "name": m.name, "item": `${siteUrl}${canonical}` } ] },
  {
    "@type": "ItemPage",
    "name": `${name} wholesale`,
    "url": `${siteUrl}${canonical}`,
    "description": description,
    "about": { "@type": "Thing", "name": name, "description": m.tagline },
    ...(main ? { "primaryImageOfPage": { "@type": "ImageObject", "url": `${siteUrl}${main.src}.webp`, "width": main.w, "height": main.h, "caption": main.alt } } : {}),
    "image": m.images.map((i) => `${siteUrl}${i.src}.webp`),
    "provider": { "@type": "ProfessionalService", "@id": `${siteUrl}/#organization` }
  },
  { "@type": "FAQPage", "mainEntity": faqs.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })) }
];
---

<BaseLayout title={title} description={description} canonical={canonical} ogImage={main ? `${main.src}.webp` : undefined} ogImageAlt={main?.alt} jsonLd={pageSchemas} globalPage>
  <section class="mm-hero">
    <div class="container">
      <nav class="mt-crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/motorcycles/">Motorcycles</a> / <a href={b.url}>{b.name}</a> / {m.name}</nav>
      <div class="mm-hero-grid">
        <div>
          <h1><span>{b.name} · {m.category}</span>{name}</h1>
          <p class="mt-lead">{m.tagline}</p>
          <div class="mt-actions">
            <a href={contact} class="btn btn--white">Get the factory price →</a>
            <a href="#specs" class="btn btn--white-outline">Full specs</a>
          </div>
        </div>
        <div class="mm-media">
          {main && (
            <div class="mm-slider">
              <div class="mm-track" id="mm-track" tabindex="0" role="region" aria-roledescription="carousel" aria-label={`${name} photos, swipe for more`}>
                {m.images.map((i, n) => (
                  <figure class:list={['mm-slide', { 'mm-slide--scene': !i.studio }]} aria-roledescription="slide" aria-label={`${n + 1} of ${m.images.length}`}>
                    <img class:list={{ 'mt-ride': n === 0 }} src={`${i.src}.webp`} srcset={`${i.src}-sm.webp 700w, ${i.src}.webp ${i.w}w`} sizes="(max-width: 820px) 100vw, 680px" alt={i.alt} width={i.w} height={i.h} loading={n === 0 ? 'eager' : 'lazy'} fetchpriority={n === 0 ? 'high' : undefined} decoding="async" />
                  </figure>
                ))}
              </div>
              {m.images.length > 1 && (
                <>
                  <button type="button" class="mm-arrow mm-arrow--prev" aria-label="Previous photo">‹</button>
                  <button type="button" class="mm-arrow mm-arrow--next" aria-label="Next photo">›</button>
                  <span class="mm-count" aria-hidden="true"><span id="mm-idx">1</span> / {m.images.length}</span>
                </>
              )}
            </div>
          )}
          {m.images.length > 1 && (
            <div class="mm-gallery" id="mm-thumbs" role="group" aria-label={`Choose a ${name} photo`}>
              {m.images.map((i, n) => (
                <button type="button" class="mm-thumb" aria-current={n === 0 ? 'true' : 'false'} aria-label={`Show photo ${n + 1}: ${i.alt}`} data-i={n}>
                  <img src={`${i.src}-sm.webp`} alt="" width="92" height="61" loading="lazy" decoding="async" />
                </button>
              ))}
            </div>
          )}
        </div>
      </div>
      {stats.length > 0 && (
        <ul class="mm-stats">{stats.map(([l, v]) => <li><strong>{v}</strong><span>{l}</span></li>)}</ul>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container mm-overview">
      <div class="fade-up">
        <span class="section-eyebrow">Overview</span>
        <h2>The {name} at a glance.</h2>
        {m.summary.map((p) => <p>{p}</p>)}
        <div class="mt-actions" style="margin-top:1.5rem">
          <a href={contact} class="btn btn--primary">Ask for {m.name} prices →</a>
        </div>
      </div>
      {m.highlights?.length > 0 && (
        <div class="fade-up">
          <span class="section-eyebrow">Why dealers stock it</span>
          <ul class="mm-high">{m.highlights.map((h) => <li>{h}</li>)}</ul>
        </div>
      )}
    </div>
  </section>

  <section class="section section--alt" id="specs">
    <div class="container">
      <div class="mt-section-head">
        <span class="section-eyebrow">Specifications</span>
        <h2>{name} specifications.</h2>
        <p>Figures as published by {b.name}.</p>
      </div>
      <div class="mm-specs">
        {m.specs.map((g) => (
          <div class="mm-spec">
            <h3>{g.group}</h3>
            <table>
              <tbody>{g.rows.map(([l, v]) => <tr><th scope="row">{l}</th><td>{v}</td></tr>)}</tbody>
            </table>
          </div>
        ))}
      </div>
      {m.colours?.length > 0 && (
        <div style="margin-top:2rem">
          <h3 style="font-size:1.05rem;margin:0">Colours</h3>
          <ul class="mm-colours">{m.colours.map((c) => <li>{c}</li>)}</ul>
        </div>
      )}
      <p class="mm-source">Specifications and photos: {b.name}. Checked {new Date(b.checked).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="mt-section-head">
        <span class="section-eyebrow">Trade terms</span>
        <h2>How you buy the {m.name} through us.</h2>
      </div>
      <dl class="mt-terms">{motoTerms.map(([h, p]) => <div><dt>{h}</dt><dd>{p}</dd></div>)}</dl>
      <div class="mt-trade" style="margin-top:1.25rem">
        <div class="mt-trade-yes"><h3>Who this is for</h3><ul>{motoTradeOnly.yes.map((t) => <li>{t}</li>)}</ul></div>
        <div class="mt-trade-no"><h3>Who this is not for</h3><ul>{motoTradeOnly.no.map((t) => <li>{t}</li>)}</ul></div>
      </div>
    </div>
  </section>

  {more.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <span class="section-eyebrow">More from {b.name}</span>
        <h2>Other {b.name} models.</h2>
        <div class="mt-grid mt-grid--4">{more.map((x) => <MotoCard m={x} showBrand={false} />)}</div>
        <p style="margin-top:1.5rem"><a href={b.url} class="inline-link">See the full {b.name} range →</a></p>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container--narrow">
      <span class="section-eyebrow">Questions</span>
      <h2>The {name}, answered.</h2>
      <div class="mt-faq">{faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
    </div>
  </section>

  <section class="section--emerald mt-cta">
    <div class="container--narrow">
      <h2>Ask for the {name} factory price.</h2>
      <p>Tell us how many you want and where they are going. We reply with the factory price, freight and lead time, usually within 24 hours.</p>
      <div class="mt-actions">
        <a href={contact} class="btn btn--white">Get the factory price →</a>
        <a href="/motorcycles/" class="btn btn--white-outline">All brands</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  // Photo slider: native swipe (scroll-snap), thumbnails and arrows stay in sync.
  (function () {
    var track = document.getElementById('mm-track');
    var thumbs = document.getElementById('mm-thumbs');
    if (!track || !thumbs) return;
    var slides = track.children, btns = thumbs.querySelectorAll('.mm-thumb');
    var idxEl = document.getElementById('mm-idx'), current = 0, ticking = false;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function go(i) {
      i = Math.max(0, Math.min(slides.length - 1, i));
      track.scrollTo({ left: i * track.clientWidth, behavior: reduce ? 'auto' : 'smooth' });
    }
    function mark(i) {
      if (i === current) return;
      current = i;
      btns.forEach(function (b, n) { b.setAttribute('aria-current', n === i ? 'true' : 'false'); });
      if (idxEl) idxEl.textContent = i + 1;
      var t = btns[i];
      thumbs.scrollTo({ left: t.offsetLeft - (thumbs.clientWidth - t.offsetWidth) / 2, behavior: reduce ? 'auto' : 'smooth' });
    }
    track.addEventListener('scroll', function () {
      if (ticking) return; ticking = true;
      requestAnimationFrame(function () { ticking = false; mark(Math.round(track.scrollLeft / track.clientWidth)); });
    }, { passive: true });
    btns.forEach(function (b) { b.addEventListener('click', function () { go(+b.dataset.i); }); });
    var prev = document.querySelector('.mm-arrow--prev'), next = document.querySelector('.mm-arrow--next');
    if (prev) prev.addEventListener('click', function () { go(current - 1); });
    if (next) next.addEventListener('click', function () { go(current + 1); });
    track.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowRight') { e.preventDefault(); go(current + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(current - 1); }
    });
  })();
</script>
