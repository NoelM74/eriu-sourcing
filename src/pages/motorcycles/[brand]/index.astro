---
// One page per motorcycle brand, with every model. Data: src/data/motorcycles.js.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MotoCard from '../../../components/MotoCard.astro';
import { motoBrands, motoTerms, motoTradeOnly, motoContact } from '../../../data/motorcycles.js';
import '../../../styles/moto.css';

export function getStaticPaths() {
  return motoBrands.map((b) => ({ params: { brand: b.slug }, props: { b } }));
}

const { b } = Astro.props;
const siteUrl = 'https://eriusourcing.com';
const canonical = b.url;
const kindTitle = b.slug === 'kymco' ? 'Scooters' : 'Motorcycles';
const title = `${b.name} ${kindTitle} Wholesale at Factory Prices | Ériu`;
const description = `${b.name} ${b.kind} at factory prices for dealers: ${b.models.slice(0, 3).map((m) => m.name).join(', ')} and ${b.models.length - 3} more models with full specs. Wholesale only.`.slice(0, 160);
const others = motoBrands.filter((x) => x.slug !== b.slug);
const contactSlug = `motorcycles-${b.slug}`;
const hero = b.heroModel.images[0];
const listNames = (arr) => arr.length > 1 ? `${arr.slice(0, -1).join(', ')} and ${arr[arr.length - 1]}` : arr[0];

const faqs = [
  { q: `Can I buy ${b.name} ${b.kind} wholesale?`, a: `Yes. We supply ${b.name} ${b.kind} to dealers, importers and fleet operators at factory prices, FOB China or delivered to your country. We sell to the trade only, not single bikes to private riders.` },
  { q: `Which ${b.name} models can you supply?`, a: `${listNames(b.models.map((m) => m.name))}. Each has its own page with full specifications and photos. Tell us the models and quantities you want and we confirm them in your quote.` },
  { q: `Can I mix ${b.name} with other brands in one order?`, a: `Yes. You can combine ${b.name} with Benda, Kove, Cyclone, Kymco and Lifan models in the same order. Freight and lead time are confirmed in your quote.` },
  { q: `Can I see the ${b.name} bikes before I order?`, a: 'Yes. You can visit and see the bikes in Zhengzhou by appointment, and we arrange the visit. Every order is inspected before it ships.' },
];

const pageSchemas = [
  { "@type": "BreadcrumbList", "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/` },
    { "@type": "ListItem", "position": 2, "name": "Motorcycles & Scooters", "item": `${siteUrl}/motorcycles/` },
    { "@type": "ListItem", "position": 3, "name": b.name, "item": `${siteUrl}${canonical}` } ] },
  {
    "@type": "Service",
    "name": `${b.name} ${b.kind} wholesale at factory prices`,
    "serviceType": "Motorcycle and scooter wholesale supply",
    "description": description,
    "provider": { "@type": "ProfessionalService", "@id": `${siteUrl}/#organization` },
    "areaServed": { "@type": "Place", "name": "Worldwide" },
    "brand": { "@type": "Brand", "name": b.name },
    "audience": { "@type": "BusinessAudience", "audienceType": "Motorcycle and scooter dealers, importers and fleet operators" }
  },
  {
    "@type": "ItemList",
    "name": `${b.name} models supplied by Ériu Sourcing`,
    "numberOfItems": b.models.length,
    "itemListElement": b.models.map((m, i) => ({ "@type": "ListItem", "position": i + 1, "name": `${b.name} ${m.name}`, "url": `${siteUrl}${m.url}` }))
  },
  { "@type": "FAQPage", "mainEntity": faqs.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })) }
];
---

<BaseLayout title={title} description={description} canonical={canonical} ogImage={hero ? `${hero.src}.webp` : undefined} ogImageAlt={hero?.alt} jsonLd={pageSchemas} globalPage>
  <section class="mt-hero">
    <div class="container mt-hero-grid">
      <div>
        <nav class="mt-crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/motorcycles/">Motorcycles &amp; Scooters</a> / {b.name}</nav>
        <span class="mt-eyebrow">{b.focus} · Trade only</span>
        <h1>{b.name} {b.kind} wholesale, at factory prices.</h1>
        <p class="mt-lead">{b.story}</p>
        <div class="mt-actions">
          <a href={motoContact(contactSlug)} class="btn btn--white">Get {b.name} prices →</a>
          <a href="#range" class="btn btn--white-outline">See all {b.models.length} models</a>
        </div>
        <ul class="mt-stats">
          <li><strong>{b.models.length}</strong><span>models</span></li>
          {b.ccRange && <li><strong>{b.ccRange[0] === b.ccRange[1] ? `${b.ccRange[0]} cc` : `${b.ccRange[0]}–${b.ccRange[1]} cc`}</strong><span>engine range</span></li>}
          <li><strong>{b.categories.length}</strong><span>{b.categories.length === 1 ? 'category' : 'categories'}</span></li>
        </ul>
      </div>
      {hero && (
        <a href={b.heroModel.url} class:list={['mt-stage', { 'mt-stage--scene': !hero.studio }]} aria-label={`${b.name} ${b.heroModel.name}: specs and photos`}>
          <img class="mt-ride" src={`${hero.src}.webp`} srcset={`${hero.src}-sm.webp 700w, ${hero.src}.webp ${hero.w}w`} sizes="(max-width: 820px) 100vw, 600px" alt={hero.alt} width={hero.w} height={hero.h} loading="eager" fetchpriority="high" />
        </a>
      )}
    </div>
  </section>

  <section class="section" id="range">
    <div class="container">
      <div class="mt-section-head">
        <span class="section-eyebrow">The {b.name} range</span>
        <h2>{b.tagline}</h2>
        <p>{b.dealerNote} Choose a model for its full specifications and photos.</p>
      </div>
      {b.categories.length > 1 && (
        <div class="mt-filter" role="group" aria-label="Filter by category">
          <button type="button" aria-pressed="true" data-filter="all">All<span>{b.models.length}</span></button>
          {b.categories.map((c) => <button type="button" aria-pressed="false" data-filter={c}>{c}<span>{b.models.filter((m) => m.category === c).length}</span></button>)}
        </div>
      )}
      <div class="mt-grid">{b.models.map((m) => <MotoCard m={m} showBrand={false} filter />)}</div>
      <p class="mt-credit">Specifications and product photos: {b.name}.</p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="mt-section-head">
        <span class="section-eyebrow">Trade terms</span>
        <h2>How you buy {b.name} through us.</h2>
      </div>
      <dl class="mt-terms">{motoTerms.map(([h, p]) => <div><dt>{h}</dt><dd>{p}</dd></div>)}</dl>
      <div class="mt-trade" style="margin-top:1.25rem">
        <div class="mt-trade-yes"><h3>Who this is for</h3><ul>{motoTradeOnly.yes.map((t) => <li>{t}</li>)}</ul></div>
        <div class="mt-trade-no"><h3>Who this is not for</h3><ul>{motoTradeOnly.no.map((t) => <li>{t}</li>)}</ul></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="mt-used">
        <div>
          <span class="mt-badge">Coming soon</span>
          <h2>Used {b.name} bikes, at unbeatable prices.</h2>
          <p>Used motorcycles and scooters from {b.name} and our other four brands, fully checked and refurbished before they are offered. Register your interest and we will contact you first.</p>
          <a href={motoContact('used-motorcycles')} class="btn btn--white">Register interest →</a>
        </div>
        <ul><li>Fully checked</li><li>Refurbished before sale</li><li>For dealers and the trade</li></ul>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container--narrow">
      <span class="section-eyebrow">Questions</span>
      <h2>{b.name} wholesale, answered.</h2>
      <div class="mt-faq">{faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="section-eyebrow">The other brands</span>
      <div class="mt-grid mt-grid--4">
        {others.map((o) => {
          const i = o.heroModel.images[0];
          return (
            <a href={o.url} class="mt-card">
              <div class:list={['mt-card-img', { 'mt-card-img--scene': i && !i.studio }]}>{i && <img src={`${i.src}-sm.webp`} alt={i.alt} width="700" height={Math.round(700 * i.h / i.w)} loading="lazy" decoding="async" />}</div>
              <div class="mt-card-body"><span class="mt-model-type">{o.focus}</span><h3>{o.name}</h3><span class="mt-card-more">{o.models.length} models →</span></div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section--emerald mt-cta">
    <div class="container--narrow">
      <h2>Ask for {b.name} factory prices.</h2>
      <p>Send the models and quantities you want. We reply with factory prices, freight and lead time, usually within 24 hours.</p>
      <div class="mt-actions">
        <a href={motoContact(contactSlug)} class="btn btn--white">Get {b.name} prices →</a>
        <a href="/motorcycles/" class="btn btn--white-outline">All brands</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  // Category filter for the model grid.
  (function () {
    var btns = document.querySelectorAll('.mt-filter button');
    btns.forEach(function (b) {
      b.addEventListener('click', function () {
        var f = b.dataset.filter;
        btns.forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
        document.querySelectorAll('[data-cat]').forEach(function (c) { c.hidden = f !== 'all' && c.dataset.cat !== f; });
      });
    });
  })();
</script>
