---
// Motorcycles & scooters hub. Data: src/data/motorcycles.js (owner decisions in its header).
import BaseLayout from '../../layouts/BaseLayout.astro';
import { motoBrands, motoFeatured, motoTerms, motoTradeOnly, motoModelCount, motoImg, motoContact } from '../../data/motorcycles.js';
import '../../styles/moto.css';

const siteUrl = 'https://eriusourcing.com';
const canonical = '/motorcycles/';
const title = 'Motorcycles & Scooters Wholesale at Factory Prices | Ériu';
const description = 'Benda, Kove, Cyclone, Kymco and Lifan motorcycles and scooters at factory prices for dealers and importers. Wholesale only, inspected before shipping.';
const hero = motoBrands.find((b) => b.slug === 'kove').cover;

const featured = motoFeatured.map((f) => {
  const brand = motoBrands.find((b) => b.slug === f.brand);
  const model = brand.models.find((m) => m.name === f.model);
  return { ...f, brand, model };
});

const faqs = [
  { q: 'Who do you sell motorcycles and scooters to?', a: 'We sell to the trade: motorcycle and scooter dealers, importers and distributors, and rental, delivery and fleet operators. We sell wholesale only, so we do not sell single bikes to private riders.' },
  { q: 'Which motorcycle brands can you supply?', a: `Benda, Kove, Cyclone, Kymco and Lifan, with ${motoModelCount} models between them: cruisers, adventure and rally bikes, nakeds, customs, commuters and scooters, from the 49 cc Kymco Agility 50 to the 996 cc Cyclone RA1000.` },
  { q: 'Do you sell at factory prices?', a: 'Yes. We quote factory prices for the models and quantities you ask for, either FOB China or delivered to your country. Freight and lead time are confirmed in the quote.' },
  { q: 'Can I see the bikes before I order?', a: 'Yes. You can visit and see the bikes in Zhengzhou by appointment, and we arrange the visit. Whether you visit or not, every order is inspected before it ships.' },
  { q: 'How do I get a price?', a: 'Send us the brands and models you want, rough quantities and the country you are shipping to. We usually reply within 24 hours with factory prices, freight options and the lead time.' },
  { q: 'Do you sell used motorcycles?', a: 'Not yet. Used motorcycles and scooters from all five brands, fully checked and refurbished, are coming soon. Register your interest and we will contact you first.' },
];

const pageSchemas = [
  { "@type": "BreadcrumbList", "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/` },
    { "@type": "ListItem", "position": 2, "name": "Motorcycles & Scooters", "item": `${siteUrl}${canonical}` } ] },
  {
    "@type": "Service",
    "name": "Wholesale motorcycles and scooters at factory prices",
    "serviceType": "Motorcycle and scooter wholesale supply",
    "description": description,
    "provider": { "@type": "ProfessionalService", "@id": `${siteUrl}/#organization` },
    "areaServed": { "@type": "Place", "name": "Worldwide" },
    "audience": { "@type": "BusinessAudience", "audienceType": "Motorcycle and scooter dealers, importers and fleet operators" },
    "brand": motoBrands.map((b) => ({ "@type": "Brand", "name": b.name }))
  },
  {
    "@type": "ItemList",
    "name": "Motorcycle and scooter brands supplied by Ériu Sourcing",
    "itemListElement": motoBrands.map((b, i) => ({ "@type": "ListItem", "position": i + 1, "name": `${b.name} ${b.kind}`, "url": `${siteUrl}/motorcycles/${b.slug}/`, "image": `${siteUrl}${b.cover.src}.webp` }))
  },
  { "@type": "FAQPage", "mainEntity": faqs.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })) }
];
---

<BaseLayout title={title} description={description} canonical={canonical} ogImage={`${hero.src}.webp`} ogImageAlt={hero.alt} jsonLd={pageSchemas} globalPage>
  <section class="mt-hero">
    <div class="container mt-hero-grid">
      <div>
        <nav class="mt-crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / Motorcycles &amp; Scooters</nav>
        <span class="mt-eyebrow">Motorcycles &amp; scooters · Trade only</span>
        <h1>Motorcycles and scooters at factory prices, for dealers.</h1>
        <p class="mt-lead">Benda, Kove, Cyclone, Kymco and Lifan, quoted at the factory price and shipped from China to your country. Ériu is your sales agent on the ground: one contact, one quote, and every order inspected before it ships.</p>
        <div class="mt-actions">
          <a href={motoContact('motorcycles')} class="btn btn--white">Get factory prices →</a>
          <a href="#brands" class="btn btn--white-outline">See the brands</a>
        </div>
        <ul class="mt-stats">
          <li><strong>5</strong><span>brands</span></li>
          <li><strong>{motoModelCount}</strong><span>models</span></li>
          <li><strong>49–996 cc</strong><span>scooters to big twins</span></li>
          <li><strong>Wholesale</strong><span>for the trade only</span></li>
        </ul>
      </div>
      <figure class="mt-hero-media">
        <img src={`${hero.src}.webp`} srcset={`${hero.src}-sm.webp 800w, ${hero.src}.webp ${hero.w}w`} sizes="(max-width: 820px) 100vw, 600px" alt={hero.alt} width={hero.w} height={hero.h} loading="eager" fetchpriority="high" />
        <figcaption>Kove 800X. Photo: Kove.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="mt-trade">
        <div class="mt-trade-yes">
          <h3>Who this is for</h3>
          <ul>{motoTradeOnly.yes.map((t) => <li>{t}</li>)}</ul>
        </div>
        <div class="mt-trade-no">
          <h3>Who this is not for</h3>
          <ul>{motoTradeOnly.no.map((t) => <li>{t}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt" id="brands">
    <div class="container">
      <div class="mt-section-head fade-up">
        <span class="section-eyebrow">The brands</span>
        <h2>Five makers, five places in the market.</h2>
        <p>From Lifan's 200 cc commuters to Kove's rally-bred adventure bikes and Kymco's maxi scooters, you can build a full showroom from one supplier and one shipment.</p>
      </div>
      <div class="mt-brands">
        {motoBrands.map((b) => (
          <a href={`/motorcycles/${b.slug}/`} class="mt-brand">
            <div class="mt-brand-img"><img src={`${b.cover.src}-sm.webp`} alt={b.cover.alt} width="800" height="450" loading="lazy" /></div>
            <div class="mt-brand-body">
              <span class="mt-brand-focus">{b.focus}</span>
              <h3>{b.name}</h3>
              <p>{b.summary}</p>
              <span class="mt-brand-link">See the {b.name} range →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="mt-section-head fade-up">
        <span class="section-eyebrow">Headline models</span>
        <h2>One bike from each brand.</h2>
        <p>The model that best shows what each maker does. Every brand page lists the full range with the makers' published figures.</p>
      </div>
      <div class="mt-models mt-models--five">
        {featured.map((f) => (
          <article class="mt-model">
            <div class="mt-model-img"><img src={`${motoImg(f.model.img)}-sm.webp`} alt={`${f.brand.name} ${f.model.name} ${f.model.type.toLowerCase()}, side view`} width="640" height={Math.round(640 * f.model.h / f.model.w)} loading="lazy" /></div>
            <div class="mt-model-body">
              <span class="mt-model-type">{f.brand.name} · {f.model.type}</span>
              <h3>{f.model.name}</h3>
              <p>{f.desc}</p>
              <ul class="mt-chips">{f.model.specs.map((s) => <li>{s}</li>)}</ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="mt-section-head">
        <span class="section-eyebrow">Spec ledger</span>
        <h2>The numbers, side by side.</h2>
        <p>The figures that separate the five headline bikes. Where a maker does not publish a figure, we print a dash rather than a guess.</p>
      </div>
      <div class="mt-ledger-wrap" role="region" aria-label="Specification table, scroll sideways on small screens" tabindex="0">
        <table class="mt-ledger">
          <thead><tr><th scope="col">Bike</th><th scope="col">Engine</th><th scope="col">Power</th><th scope="col">Weight</th><th scope="col">Seat height</th></tr></thead>
          <tbody>
            {featured.map((f) => (
              <tr>
                <th scope="row"><a href={`/motorcycles/${f.brand.slug}/`}>{f.model.name}<small>{f.brand.name}</small></a></th>
                <td>{f.ledger.engine}</td><td>{f.ledger.power}</td><td>{f.ledger.weight ?? '–'}</td><td>{f.ledger.seat ?? '–'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-note">Makers' published figures; weights are wet unless marked dry. A dash means the maker does not publish that figure.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="mt-section-head fade-up">
        <span class="section-eyebrow">How buying works</span>
        <h2>From your model list to your showroom.</h2>
      </div>
      <ol class="mt-steps">
        <li><strong>Send your list</strong><span>The brands, models and rough quantities you want, and the country you are shipping to.</span></li>
        <li><strong>Get factory prices</strong><span>We quote the factory price, FOB China or delivered, with freight and lead time for your order.</span></li>
        <li><strong>See the bikes</strong><span>Visit and see the bikes in Zhengzhou by appointment. We arrange the visit for you.</span></li>
        <li><strong>Inspected and shipped</strong><span>Your order is inspected before it leaves China, then shipped by the route in your quote.</span></li>
      </ol>
      <dl class="mt-terms">
        {motoTerms.map(([h, p]) => <div><dt>{h}</dt><dd>{p}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="section section--alt" id="used">
    <div class="container">
      <div class="mt-used">
        <div>
          <span class="mt-badge">Coming soon</span>
          <h2>Used motorcycles and scooters, at unbeatable prices.</h2>
          <p>We are adding used bikes from all five brands: Benda, Kove, Cyclone, Kymco and Lifan. Every bike fully checked and refurbished before it is offered to you. Register your interest and we will contact you first.</p>
          <a href={motoContact('used-motorcycles')} class="btn btn--white">Register interest →</a>
        </div>
        <ul>
          <li>All five brands</li>
          <li>Fully checked</li>
          <li>Refurbished before sale</li>
          <li>For dealers and the trade</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container--narrow">
      <span class="section-eyebrow">Questions</span>
      <h2>Buying motorcycles wholesale, answered.</h2>
      <div class="mt-faq">{faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
      <p class="mt-credit">Product photos are the manufacturers' own.</p>
    </div>
  </section>

  <section class="section--emerald mt-cta">
    <div class="container--narrow">
      <h2>Tell us which bikes you want.</h2>
      <p>Send the models and quantities. We reply with factory prices, freight and lead time, usually within 24 hours.</p>
      <div class="mt-actions">
        <a href={motoContact('motorcycles')} class="btn btn--white">Get factory prices →</a>
      </div>
    </div>
  </section>
</BaseLayout>
