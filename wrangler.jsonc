// Cloudflare Workers config for this static Astro site.
// Added 2026-11-10 only to serve the custom 404 page (src/pages/404.astro);
// without it, missing URLs returned an empty 404. Name must match the
// Worker in the Cloudflare dashboard (eriu-sourcing).
{
  "name": "eriu-sourcing",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
